# wpa_supplicant's build-time feature list. fetch.sh copies this file
# to .config in the build container, and the build enables only what
# the file names. liken checks the list in rather than taking
# upstream's defconfig, so a reviewer sees the whole feature set in
# one place. Everything absent here is absent from the binary: no
# D-Bus, no EAP methods, no P2P, no WPS, no AP mode. WPA2-PSK takes no
# entry, because it is the core the supplicant always builds; only the
# pieces below are optional.

# The driver. nl80211 is the kernel's only wireless control
# interface, and libnl-3 is the library a program speaks it through.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

# The control interface: the UNIX socket init attaches to for the
# join events (plans/62-wifi.md).
CONFIG_CTRL_IFACE=y

# The configuration backend. Init generates a file under /run, and
# nothing on this machine may write back to it.
CONFIG_BACKEND=file
CONFIG_NO_CONFIG_WRITE=y

# WPA3 personal. SAE needs elliptic-curve math, and OpenSSL is the
# one crypto backend in this build that has it.
CONFIG_TLS=openssl
CONFIG_SAE=y
