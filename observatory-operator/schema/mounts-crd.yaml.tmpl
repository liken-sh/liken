# A `Mount` is the device that points a `Telescope`: an INDI driver with
# `TELESCOPE_INTERFACE`.
#
# A device resource is inventory: `observatory-operator` starts its pod
# only while a `Reservation` needs it. The fields that every device
# shares come from `device.yaml.tmpl`, and the procedure schema from
# `procedures.yaml.tmpl`, so all 14 device CRDs hold the same copy. The
# typed fields of INDI's standard properties come from
# `mounts-fields.yaml`.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: mounts.observatory.liken.sh
spec:
  group: observatory.liken.sh
  names:
    kind: Mount
    listKind: MountList
    plural: mounts
    singular: mount
    shortNames: [mnt]
    categories: [astro]
  scope: Namespaced
  versions:
    - name: v1alpha1
      served: true
      storage: true
      subresources:
        status: {}
      selectableFields:
        - jsonPath: .spec.telescope
      additionalPrinterColumns:
        - name: Telescope
          type: string
          jsonPath: .spec.telescope
        - name: Phase
          type: string
          jsonPath: .status.phase
        - name: RA
          type: string
          jsonPath: .status.display.rightAscension
        - name: Dec
          type: string
          jsonPath: .status.display.declination
        - name: State
          type: string
          jsonPath: .status.readings.state
        - name: Age
          type: date
          jsonPath: .metadata.creationTimestamp
        - name: Driver
          type: string
          jsonPath: .spec.driver.name
          priority: 1
        - name: Device
          type: string
          jsonPath: .status.indiDevice
          priority: 1
        - name: Node
          type: string
          jsonPath: .status.node
          priority: 1
        - name: Message
          type: string
          jsonPath: '.status.conditions[?(@.type=="Ready")].message'
          priority: 1
      schema:
        openAPIV3Schema:
          type: object
          x-kubernetes-validations:
            - rule: size(self.metadata.name) <= 32
              message: >-
                a Mount name is at most 32 characters, because
                observatory-operator names its pod and Service
                <name>-mount, and a Service name holds at most 63
                characters
          description: >-
            A `Mount` is the device that points a `Telescope`: an INDI
            driver with `TELESCOPE_INTERFACE`. INDI and ASCOM call these
            drivers telescopes, and here the `Telescope` is the whole
            instrument. The operator writes the observatory's location
            and time to the mount when it configures it.
          required: [spec]
          properties:
            spec:
              type: object
              required: [driver]
              description: >-
                One mount, with INDI's `TELESCOPE_INTERFACE`. The
                operator writes the `Observatory`'s location to it when
                a reservation configures it.
              properties:
                telescope:
                  type: string
                  minLength: 1
                  maxLength: 253
                  pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  description: >-
                    The name of the `Telescope` that the device belongs
                    to.
                    Optional. With no `telescope`, the device is on the
                    shelf, and the operator creates nothing for it.
{{ include "device spec" . | indent 16 }}
{{ settings | indent 16 }}
{{ include "procedure spec" . | indent 16 }}
            status:
              type: object
              description: >-
                What the operator observes. The operator writes it, and
                a person reads it.
              properties:
{{ include "device status" . | indent 16 }}
{{ standard | indent 16 }}
                display:
                  type: object
                  description: >-
                    The readings as a person reads them, with their units,
                    for the printer columns. The numbers are in `readings`.
                  properties:
                    rightAscension:
                      type: string
                      description: "The right ascension in hours, minutes, and seconds, such as `19h17m21s`."
                    declination:
                      type: string
                      description: "The declination in degrees, arcminutes, and arcseconds, such as `+12°34′56″`."
                readings:
                  type: object
                  description: >-
                    What the mount reports, from `EQUATORIAL_EOD_COORD`,
                    `TELESCOPE_PARK`, and `TELESCOPE_TRACK_STATE`. A
                    field is absent until the driver sends it.
                  properties:
                    rightAscension:
                      type: number
                      minimum: 0
                      maximum: 24
                      description: >-
                        Where the mount points, in hours from 0 to 24,
                        in the equinox of the date (JNow).
                    declination:
                      type: number
                      minimum: -90
                      maximum: 90
                      description: >-
                        Where the mount points, in degrees from -90 to
                        90, in the equinox of the date (JNow).
                    state:
                      type: string
                      enum: [Parked, Parking, Unparking, Stopped, Slewing, Tracking]
                      description: >-
                        What the mount does: `Parking` or `Unparking`
                        while `TELESCOPE_PARK` is `Busy`, `Parked` while
                        its `PARK` member is on and its state is not
                        `Alert`, `Slewing` while `EQUATORIAL_EOD_COORD`
                        is `Busy`, `Tracking` while the `TRACK_ON`
                        member of `TELESCOPE_TRACK_STATE` is on, and
                        `Stopped` otherwise. The first that applies
                        wins. Absent until the driver defines all three
                        properties.
{{- define "action" }}
type: object
description: >-
  One action, which names exactly one of `state` and
  `job`.
x-kubernetes-validations:
  - rule: "[has(self.state), has(self.job)].filter(x, x).size() == 1"
    message: "an action of a Mount names exactly one of state and job"
properties:
  state:
    type: string
    enum: [Parked, Unparked]
    description: >-
      The park to reach: `Parked` or `Unparked`,
      written to `TELESCOPE_PARK`. A park that the
      driver reports already is not sent again. The
      default timeout is 10 minutes.
{{ include "action fields" . | indent 2 }}
{{- end }}
