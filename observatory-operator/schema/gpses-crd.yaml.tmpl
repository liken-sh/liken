# A `GPS` gives a telescope its place and time: an INDI driver with
# `GPS_INTERFACE`.
#
# A device resource is inventory: `observatory-operator` starts its pod
# only while a `Reservation` needs it. The fields that every device
# shares come from `device.yaml.tmpl`, and the procedure schema from
# `procedures.yaml.tmpl`, so all 14 device CRDs hold the same copy. The
# typed fields of INDI's standard properties come from
# `gpses-fields.yaml`.
#
# The singular, `gps`, is already short, so the kind has no short name.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: gpses.observatory.liken.sh
spec:
  group: observatory.liken.sh
  names:
    kind: GPS
    listKind: GPSList
    plural: gpses
    singular: gps
    categories: [astro]
  scope: Namespaced
  versions:
    - name: v1alpha1
      served: true
      storage: true
      subresources:
        status: {}
      selectableFields:
        - jsonPath: .spec.telescope
      additionalPrinterColumns:
        - name: Telescope
          type: string
          jsonPath: .spec.telescope
        - name: Phase
          type: string
          jsonPath: .status.phase
        - name: Fix
          type: boolean
          jsonPath: .status.readings.fix
        - name: Time
          type: string
          jsonPath: .status.readings.time
        - name: Age
          type: date
          jsonPath: .metadata.creationTimestamp
        - name: Driver
          type: string
          jsonPath: .spec.driver.name
          priority: 1
        - name: Device
          type: string
          jsonPath: .status.indiDevice
          priority: 1
        - name: Node
          type: string
          jsonPath: .status.node
          priority: 1
        - name: Message
          type: string
          jsonPath: '.status.conditions[?(@.type=="Ready")].message'
          priority: 1
      schema:
        openAPIV3Schema:
          type: object
          x-kubernetes-validations:
            - rule: size(self.metadata.name) <= 32
              message: >-
                a GPS name is at most 32 characters, because
                observatory-operator names its pod and Service
                <name>-gps, and a Service name holds at most 63
                characters
          description: >-
            A `GPS` gives a telescope its place and time: an INDI driver
            with `GPS_INTERFACE`. The mount snoops it on the telescope's
            server.
          required: [spec]
          properties:
            spec:
              type: object
              required: [driver]
              description: "One GPS receiver, with INDI's `GPS_INTERFACE`."
              properties:
                telescope:
                  type: string
                  minLength: 1
                  maxLength: 253
                  pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  description: >-
                    The name of the `Telescope` that the device belongs
                    to.
                    Optional. With no `telescope`, the device is on the
                    shelf, and the operator creates nothing for it.
{{ include "device spec" . | indent 16 }}
{{ settings | indent 16 }}
{{ include "procedure spec" . | indent 16 }}
            status:
              type: object
              description: >-
                What the operator observes. The operator writes it, and
                a person reads it.
              properties:
{{ include "device status" . | indent 16 }}
{{ standard | indent 16 }}
                readings:
                  type: object
                  description: >-
                    What the GPS reports, from `GEOGRAPHIC_COORD` and
                    `TIME_UTC`. A field is absent until the driver sends
                    it.
                  properties:
                    fix:
                      type: boolean
                      description: >-
                        Whether the GPS has a fix. It is `true` when
                        `GEOGRAPHIC_COORD` is in the `Ok` state.
                    time:
                      type: string
                      format: date-time
                      description: "The time that the GPS reports, in UTC."
                    latitude:
                      type: number
                      minimum: -90
                      maximum: 90
                      description: >-
                        The latitude that the GPS reports, in degrees
                        north.
                    longitude:
                      type: number
                      minimum: -180
                      maximum: 180
                      description: >-
                        The longitude that the GPS reports, in degrees
                        east, from -180 to 180.
                    elevation:
                      type: number
                      description: >-
                        The elevation that the GPS reports, in meters
                        above mean sea level.
{{- define "action" }}
type: object
description: >-
  One action, which names `job`.
x-kubernetes-validations:
  - rule: "has(self.job)"
    message: "an action of a GPS names job"
properties:
{{ include "action fields" . | indent 2 }}
{{- end }}
