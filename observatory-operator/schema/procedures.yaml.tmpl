{{- define "procedure spec" }}
activation:
  type: array
  maxItems: 16
  description: >-
    The actions that run, in order, as this resource's
    `Telescope` or `Observatory` turns `Active`, while
    every device is still connected. For a `Telescope`
    or an `Observatory`, that is the resource itself.
    The `Reservation`'s `Activation` step waits for
    them. Each action is a target state, so a run that
    an operator restart interrupted runs again each
    action that is not `Done`. Optional.
  items:
{{ include "action" . | indent 4 }}
deactivation:
  type: array
  maxItems: 16
  description: >-
    The actions that run, in order, as this resource's
    `Telescope` or `Observatory` stops being `Active`,
    while every device is still connected. For a
    `Telescope` or an `Observatory`, that is the
    resource itself. The `Reservation`'s `Deactivation`
    step waits for them. Each action is a target state,
    so a run that an operator restart interrupted runs
    again each action that is not `Done`. Optional.
  items:
{{ include "action" . | indent 4 }}
triggers:
  type: array
  maxItems: 16
  description: >-
    Triggers on conditions. Each one runs its actions
    once for each transition of its condition to the
    status it names, while the resource is active: from
    when its activation is done until its deactivation
    begins. A condition that holds when the activation
    ends runs then. A run that began runs to its end,
    unless the resource's deactivation begins, and a
    resource runs one procedure at a time. Optional.
  items:
    type: object
    required: [when, run]
    description: >-
      One trigger: a condition, and the actions it runs.
    properties:
      when:
        type: object
        required: [type]
        description: >-
          The condition, and the status that fires the
          trigger.
        properties:
          kind:
            type: string
            enum: [Observatory, Telescope, OpticalTube, OpticalTrain, Mount, Camera, FilterWheel, Focuser, Rotator, DustCap, FlatPanel, PolarAligner, GPS, Dome, WeatherStation, Switch, Receiver, Guider]
            description: >-
              The kind of the resource whose condition
              it reads. With no `kind`, the condition is
              the resource's own. A `kind` of
              `Observatory` or `Telescope` with no
              `name` means the resource's own
              observatory or telescope.
          name:
            type: string
            minLength: 1
            maxLength: 253
            pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            description: >-
              The name of the resource, in this
              namespace. A device kind needs a name.
          type:
            type: string
            minLength: 1
            maxLength: 316
            description: >-
              The condition's type, such as `Safe` or
              `Parked`.
          status:
            type: string
            enum: ["True", "False", Unknown]
            description: >-
              The status that the condition must have:
              `True`, `False`, or `Unknown`. The default
              is `True`.
          for:
            type: string
            maxLength: 32
            description: >-
              How long the status must hold before the
              actions run, as a duration such as `20m`.
              A change of the status before then cancels
              the run. Optional.
            x-kubernetes-validations:
              - rule: "self.matches('^([0-9]+(\\\\.[0-9]+)?(ms|s|m|h))+$') && duration(self) >= duration('0s')"
                message: "for must be a duration, such as 20m or 1h30m"
      run:
        type: array
        minItems: 1
        maxItems: 16
        description: >-
          The actions that run, in order.
        items:
{{ include "action" . | indent 10 }}
{{- end }}
{{- define "procedure status" }}
procedures:
  type: array
  description: >-
    The last run of each trigger of the resource's
    procedures: `activation`, `deactivation`, and
    `triggers[0]` and so on for each item of
    `spec.triggers`. An operator that restarts resumes a
    run from this record.
  x-kubernetes-list-type: map
  x-kubernetes-list-map-keys: [trigger]
  items:
    type: object
    required: [trigger, state]
    description: >-
      The last run of one trigger.
    properties:
      trigger:
        type: string
        description: >-
          The trigger: `activation`, `deactivation`, or
          `triggers[0]` for the first item of
          `spec.triggers`.
      since:
        type: string
        format: date-time
        description: >-
          The transition time of the condition that started
          the run: the `lastTransitionTime` of `Active` for
          activation and deactivation.
      state:
        type: string
        enum: [Pending, Running, Done, Failed, Skipped]
        description: >-
          The run's progress: `Pending`, `Running`,
          `Done`, `Failed`, or `Skipped` when it had
          nothing to do.
      startTime:
        type: string
        format: date-time
        description: >-
          When the run began to run.
      stopTime:
        type: string
        format: date-time
        description: >-
          When the run ended.
      summary:
        type: string
        description: >-
          What the run waits for or did.
      actions:
        type: array
        description: >-
          Each action of the run, in order.
        items:
          type: object
          required: [action, state]
          description: >-
            One action.
          properties:
            action:
              type: string
              description: >-
                The action as its YAML reads, such as
                `state: Parked` or `cool: -10 °C within
                0.5 °C`.
            state:
              type: string
              enum: [Pending, Running, Done, Failed, Skipped]
              description: >-
                The action's progress: `Pending`,
                `Running`, `Done`, `Failed`, or
                `Skipped` when it had nothing to do.
            startTime:
              type: string
              format: date-time
              description: >-
                When the action began to run.
            stopTime:
              type: string
              format: date-time
              description: >-
                When the action ended.
            summary:
              type: string
              description: >-
                What the action waits for or did.
{{- end }}
{{- define "action fields" }}
job:
  type: object
  required: [image]
  description: >-
    A container that the operator runs once as a
    Kubernetes `Job` in the resource's namespace,
    for what no other action does, such as
    switching a dew heater's relay or posting to a
    webhook. The resource owns the `Job`. The
    action is `Done` when the `Job` succeeds, and
    `Failed` with the `Job`'s reason and message
    when it fails. The `Job` has no retry, and its
    `activeDeadlineSeconds` is the action's
    timeout. Kubernetes deletes it an hour after
    it ends. The environment adds
    `LIKEN_OBSERVATORY`, `LIKEN_TELESCOPE` for a
    resource of a telescope, `LIKEN_RESOURCE` such
    as `Dome/lab`, `LIKEN_TRIGGER` such as
    `activation` or `triggers[0]`, and `INDI_HOST`
    and `INDI_PORT` of the resource's INDI server.
    The container runs as user 1000 with no
    capabilities, on a read-only root filesystem
    with a writable `/tmp`. The default timeout is
    10 minutes.
  properties:
    image:
      type: string
      minLength: 1
      maxLength: 512
      description: >-
        The container image, used as written, such
        as `busybox:1.37`.
    command:
      type: array
      maxItems: 32
      description: >-
        The command that replaces the image's
        entrypoint, as a container's `command`
        does. Optional.
      items:
        type: string
        maxLength: 4096
    args:
      type: array
      maxItems: 64
      description: >-
        The arguments of the command, as a
        container's `args` are. Optional.
      items:
        type: string
        maxLength: 4096
    env:
      type: array
      maxItems: 32
      description: >-
        Variables that the operator adds to the
        container's environment before its own, as
        `{name, value}`. A variable that has the
        name of one of the operator's own is
        replaced by the operator's. Optional.
      x-kubernetes-list-type: map
      x-kubernetes-list-map-keys: [name]
      items:
        type: object
        required: [name, value]
        description: >-
          One variable.
        properties:
          name:
            type: string
            minLength: 1
            maxLength: 256
            pattern: "^[-._a-zA-Z][-._a-zA-Z0-9]*$"
            description: >-
              The variable's name, such as
              `RELAY_URL`.
          value:
            type: string
            maxLength: 32768
            description: >-
              The variable's value. It can be
              empty.
timeout:
  type: string
  maxLength: 32
  description: >-
    How long the action may take, its waits for
    `requires` and `after` included, as a duration
    such as `20m`. An action that passes it fails.
    Optional. Each action has a default.
  x-kubernetes-validations:
    - rule: "self.matches('^([0-9]+(\\\\.[0-9]+)?(ms|s|m|h))+$') && duration(self) > duration('0s')"
      message: "timeout must be a positive duration, such as 20m or 1h30m"
requires:
  type: array
  maxItems: 8
  description: >-
    The conditions that must hold before the
    action runs. The operator waits for each one
    until the action's timeout. They bind only the
    actions that the operator runs: a move that a
    person makes in KStars is stopped only by the
    drivers' park locks.
  items:
    type: object
    required: [type]
    description: >-
      One condition, and the status it must have.
    properties:
      kind:
        type: string
        enum: [Observatory, Telescope, OpticalTube, OpticalTrain, Mount, Camera, FilterWheel, Focuser, Rotator, DustCap, FlatPanel, PolarAligner, GPS, Dome, WeatherStation, Switch, Receiver, Guider]
        description: >-
          The kind of the resource whose condition
          it reads. With no `kind`, the condition
          is the resource's own. A `kind` of
          `Observatory` or `Telescope` with no
          `name` means the resource's own
          observatory or telescope.
      name:
        type: string
        minLength: 1
        maxLength: 253
        pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        description: >-
          The name of the resource, in this
          namespace. A device kind needs a name.
      type:
        type: string
        minLength: 1
        maxLength: 316
        description: >-
          The condition's type, such as `Safe` or
          `Parked`.
      status:
        type: string
        enum: ["True", "False", Unknown]
        description: >-
          The status that the condition must have:
          `True`, `False`, or `Unknown`. The
          default is `True`.
after:
  type: array
  maxItems: 8
  description: >-
    The resources whose runs for the same event
    must end before the action runs: the same
    lifecycle step, or the same transition of the
    same condition. A resource with no such run is
    not waited for. A resource in a later tier of
    the tree is waited for until the action's
    timeout, and the action then fails.
  items:
    type: object
    required: [kind]
    description: >-
      One resource, by its kind and name.
    properties:
      kind:
        type: string
        enum: [Observatory, Telescope, OpticalTube, OpticalTrain, Mount, Camera, FilterWheel, Focuser, Rotator, DustCap, FlatPanel, PolarAligner, GPS, Dome, WeatherStation, Switch, Receiver, Guider]
        description: >-
          The kind of the resource.
      name:
        type: string
        minLength: 1
        maxLength: 253
        pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        description: >-
          The name of the resource. With no
          `name`, the reference names every
          resource of the kind in the observatory,
          or the resource's own `Observatory` or
          `Telescope`.
{{- end }}
