# A `Camera` is an imaging or guiding camera: an INDI device that serves
# `CCD_INTERFACE`.
#
# A device resource is inventory: `observatory-operator` starts its pod
# only while a `Reservation` needs it. The fields that every device
# shares come from `device.yaml.tmpl`, and the procedure schema from
# `procedures.yaml.tmpl`, so all 13 device CRDs hold the same copy. The
# typed fields of INDI's standard properties come from
# `cameras-fields.yaml`.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: cameras.observatory.liken.sh
spec:
  group: observatory.liken.sh
  names:
    kind: Camera
    listKind: CameraList
    plural: cameras
    singular: camera
    shortNames: [cam]
    categories: [astro]
  scope: Namespaced
  versions:
    - name: v1alpha1
      served: true
      storage: true
      subresources:
        status: {}
      selectableFields:
        - jsonPath: .spec.opticalTrain
      additionalPrinterColumns:
        - name: Train
          type: string
          jsonPath: .spec.opticalTrain
        - name: Phase
          type: string
          jsonPath: .status.phase
        - name: Temp
          type: string
          jsonPath: .status.display.temperature
        - name: Setpoint
          type: string
          jsonPath: .status.display.setpoint
        - name: Cooler
          type: string
          jsonPath: .status.display.cooler
        - name: Exposure
          type: string
          jsonPath: .status.display.exposure
        - name: Set Up Until
          type: string
          jsonPath: .status.setUpExpiryTime
        - name: Age
          type: date
          jsonPath: .metadata.creationTimestamp
        - name: Cooler Power
          type: string
          jsonPath: .status.display.coolerPower
          priority: 1
        - name: Driver
          type: string
          jsonPath: .spec.driver.name
          priority: 1
        - name: Device
          type: string
          jsonPath: .status.indiDevice
          priority: 1
        - name: Node
          type: string
          jsonPath: .status.node
          priority: 1
        - name: Message
          type: string
          jsonPath: '.status.conditions[?(@.type=="Ready")].message'
          priority: 1
      schema:
        openAPIV3Schema:
          type: object
          x-kubernetes-validations:
            - rule: size(self.metadata.name) <= 32
              message: >-
                a Camera name is at most 32 characters, because
                observatory-operator names its pod and Service
                <name>-camera, and a Service name holds at most 63
                characters
          description: >-
            A `Camera` is an imaging or guiding camera: an INDI device
            that serves `CCD_INTERFACE`. It belongs to one `OpticalTrain`, and
            the operator writes the camera's `ACTIVE_DEVICES` from that
            train, so the camera snoops the mount, focuser, filter
            wheel, and rotator of its own light path.
          required: [spec]
          properties:
            spec:
              type: object
              description: >-
                One camera, with INDI's `CCD_INTERFACE`. The operator
                writes each setting that the spec states when a
                reservation configures the camera, and leaves the others
                as the driver sets them.
              x-kubernetes-validations:
{{ include "device rules" . | indent 16 }}
              properties:
                opticalTrain:
                  type: string
                  minLength: 1
                  maxLength: 253
                  pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  description: >-
                    The name of the `OpticalTrain` that the device is
                    on. The train's members set what each camera on it
                    snoops.
                    Optional. With no `opticalTrain`, the device is on
                    the shelf, and the operator creates nothing for it.
{{ include "device spec" . | indent 16 }}
{{ settings | indent 16 }}
{{ include "fits keywords" . | indent 16 }}
{{ include "procedure spec" . | indent 16 }}
            status:
              type: object
              description: >-
                What the operator observes. The operator writes it, and
                a person reads it.
              properties:
{{ include "device status" . | indent 16 }}
{{ standard | indent 16 }}
                display:
                  type: object
                  description: >-
                    The values of the typed fields as a person reads them,
                    with their units, for the printer columns.
                  properties:
                    temperature:
                      type: string
                      description: "The sensor's temperature, such as `-9.8 °C`."
                    setpoint:
                      type: string
                      description: "The setpoint of the `cool` action in `spec.activation`, such as `-10 °C`."
                    cooler:
                      type: string
                      description: "`On` or `Off`, from `CCD_COOLER`."
                    coolerPower:
                      type: string
                      description: "The cooler's power, such as `42 %`."
                    exposure:
                      type: string
                      description: "The time left, such as `12 s`, while an exposure runs. Otherwise the state of `CCD_EXPOSURE` in one word: `Idle` before the first exposure, `Done` when it ended (`Ok`), and `Failed` when it failed (`Alert`)."
{{- define "action" }}
type: object
description: >-
  One action, which names exactly one of `cool`,
  `warm`, `job`, and `notify`.
x-kubernetes-validations:
  - rule: "[has(self.cool), has(self.warm), has(self.job), has(self.notify)].filter(x, x).size() == 1"
    message: "an action names exactly one of cool, warm, job, and notify"
properties:
  cool:
    type: object
    required: [celsius]
    description: >-
      Cools the sensor: the operator writes
      `celsius` to `CCD_TEMPERATURE` and waits until
      the sensor is within `within` of it. The
      default timeout is 20 minutes.
    properties:
      celsius:
        type: number
        minimum: -100
        maximum: 50
        description: >-
          The setpoint, in degrees Celsius.
      within:
        type: number
        minimum: 0
        exclusiveMinimum: true
        maximum: 10
        description: >-
          How close to the setpoint the sensor must
          come, in degrees Celsius. The default is
          0.5.
  warm:
    type: object
    required: [celsius]
    description: >-
      Warms the sensor before its cooler goes off:
      the operator writes `celsius` to
      `CCD_TEMPERATURE`, waits until the sensor is
      within `within` of it or until the timeout,
      and switches `CCD_COOLER` off. A cooler cannot
      warm a sensor above the air around it, so the
      timeout ends the wait and does not fail the
      action. The default timeout is 10 minutes.
    properties:
      celsius:
        type: number
        minimum: -100
        maximum: 50
        description: >-
          The setpoint, in degrees Celsius.
      within:
        type: number
        minimum: 0
        exclusiveMinimum: true
        maximum: 10
        description: >-
          How close to the setpoint the sensor must
          come, in degrees Celsius. The default is
          0.5.
{{ include "action fields" . | indent 2 }}
{{- end }}
