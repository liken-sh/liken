# A `Telescope` is a mount with its optics and its instruments, and it
# has its own INDI server. INDI's snooping needs a mount and its trains
# on one server, and one server for each telescope limits a failure to
# one telescope.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: telescopes.observatory.liken.sh
spec:
  group: observatory.liken.sh
  names:
    kind: Telescope
    listKind: TelescopeList
    plural: telescopes
    singular: telescope
    shortNames: [tel]
    categories: [astro]
  scope: Namespaced
  versions:
    - name: v1alpha1
      served: true
      storage: true
      subresources:
        status: {}
      selectableFields:
        - jsonPath: .spec.observatory
      additionalPrinterColumns:
        - name: Observatory
          type: string
          jsonPath: .spec.observatory
        - name: Phase
          type: string
          jsonPath: .status.phase
        - name: Reservation
          type: string
          jsonPath: .status.reservation.name
        - name: Holder
          type: string
          jsonPath: .status.reservation.holder
        - name: Host
          type: string
          jsonPath: .status.server.host
        - name: Port
          type: integer
          jsonPath: .status.server.port
        - name: Age
          type: date
          jsonPath: .metadata.creationTimestamp
        - name: Guider
          type: string
          jsonPath: .status.display.guider
          priority: 1
        - name: Node
          type: string
          jsonPath: .status.server.node
          priority: 1
        - name: Message
          type: string
          jsonPath: '.status.conditions[?(@.type=="Ready")].message'
          priority: 1
      schema:
        openAPIV3Schema:
          type: object
          x-kubernetes-validations:
            - rule: size(self.metadata.name) <= 32
              message: >-
                a Telescope name is at most 32 characters, because
                observatory-operator builds the names of its pods,
                Services, and Job labels from the names of observatory
                resources, and Kubernetes limits those to 63 characters
          description: >-
            A `Telescope` is a mount with its optics and its
            instruments. It has one INDI server, with its `Mount` and
            the devices of its trains, while a `Reservation` of it is
            active. KStars connects one Ekos profile to that server.
          required: [spec]
          properties:
            spec:
              type: object
              required: [observatory]
              description: "Where the telescope is."
              properties:
                observatory:
                  type: string
                  minLength: 1
                  maxLength: 253
                  pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  description: >-
                    The name of the `Observatory` that the telescope is
                    in.
                horizon:
                  type: string
                  minLength: 1
                  maxLength: 253
                  pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  description: >-
                    The name of the `Horizon`, in the telescope's
                    namespace, that the telescope sees from where it
                    stands now. Optional. With no horizon, only the
                    sky's own geometry limits the telescope. A missing
                    `Horizon` never stops a reservation: the
                    `HorizonFound` condition reports it.
{{ include "fits keywords" . | indent 16 }}
{{ include "procedure spec" . | indent 16 }}
            status:
              type: object
              description: >-
                What the operator observes. The operator writes it, and
                a person reads it.
              properties:
                observedGeneration:
                  type: integer
                  format: int64
                  description: >-
                    The `metadata.generation` of the spec that the
                    operator last acted on.
                phase:
                  type: string
                  enum: [Idle, Activating, Ready, Deactivating, Error]
                  description: >-
                    The state in one word. `Idle`: no reservation needs
                    it, and nothing runs. `Activating`: a
                    reservation's activation steps run. `Ready`:
                    everything it needs runs and is connected.
                    `Deactivating`: a reservation's deactivation steps
                    run. `Error`: a step failed, and the `Ready`
                    condition gives the reason.
{{ include "procedure status" . | indent 16 }}
                conditions:
                  type: array
                  description: >-
                    `Ready` is `True` while the telescope's server runs and
                    every device of the telescope is connected. `ParentFound`
                    is `False` when the `Observatory` does not exist.
                    `HorizonFound` is `True` when the `Horizon` that
                    `spec.horizon` names exists, and `False` when it does
                    not. A telescope with no `spec.horizon` has no
                    `HorizonFound` condition. `Active`
                    is `True` from the start of its reservation's `Activation`
                    step until the start of its `Deactivation` step. Its
                    `lastTransitionTime` is the transition that starts the
                    activation and deactivation procedures. `SetUp` is the
                    condition that a person writes, such as with `kubectl
                    liken observatory set-up`, and the operator keeps it
                    until it expires and turns `False` with the reason
                    `Expired`. `AttentionNeeded` is `True` while a `notify`
                    action asks a person to do something.
                  x-kubernetes-list-type: map
                  x-kubernetes-list-map-keys: [type]
                  items:
                    type: object
                    required: [type, status, reason, message, lastTransitionTime]
                    description: >-
                      One condition, in the shape of `metav1.Condition`.
                    properties:
                      type:
                        type: string
                        minLength: 1
                        maxLength: 316
                        description: "The condition's name, such as `Ready`."
                      status:
                        type: string
                        enum: ["True", "False", Unknown]
                        description: >-
                          Whether the condition holds: `True`, `False`,
                          or `Unknown`.
                      observedGeneration:
                        type: integer
                        format: int64
                        minimum: 0
                        description: >-
                          The `metadata.generation` of the spec that the
                          condition reflects.
                      reason:
                        type: string
                        minLength: 1
                        maxLength: 1024
                        description: "One word in CamelCase for the cause."
                      message:
                        type: string
                        maxLength: 32768
                        description: >-
                          The cause, for a person to read. It can be
                          empty.
                      lastTransitionTime:
                        type: string
                        format: date-time
                        description: >-
                          When `status` last changed. A write with the
                          same status keeps this time.
                server:
                  type: object
                  required: [service, host, port]
                  description: >-
                    The telescope's INDI server, while it runs. KStars
                    and `astrophotography-operator` connect to its
                    `host` and `port`.
                  properties:
                    service:
                      type: string
                      description: "The name of the server's `Service`."
                    host:
                      type: string
                      description: "The `Service`'s DNS name in the cluster."
                    port:
                      type: integer
                      format: int32
                      description: "The INDI port of the `Service`, 7624."
                    pod:
                      type: string
                      description: "The name of the server's pod."
                    node:
                      type: string
                      description: "The node that runs the server's pod."
                reservation:
                  type: object
                  required: [name]
                  description: "The active `Reservation` of this telescope."
                  properties:
                    name:
                      type: string
                      description: "The reservation's name."
                    holder:
                      type: string
                      description: "The reservation's `spec.holder`."
                tubes:
                  type: array
                  description: "Each `OpticalTube` of this telescope."
                  x-kubernetes-list-type: set
                  items:
                    type: string
                trains:
                  type: array
                  description: >-
                    Each `OpticalTrain` of this telescope, with its
                    devices.
                  x-kubernetes-list-type: map
                  x-kubernetes-list-map-keys: [name]
                  items:
                    type: object
                    required: [name]
                    description: "One train."
                    properties:
                      name:
                        type: string
                        description: "The train's name."
                      opticalTube:
                        type: string
                        description: "The train's `spec.opticalTube`."
                      devices:
                        type: array
                        description: "Each device on the train."
                        x-kubernetes-list-type: atomic
                        items:
                          type: object
                          required: [kind, name]
                          description: "One device, with its phase."
                          properties:
                            kind:
                              type: string
                              enum: [Mount, Camera, FilterWheel, Focuser, Rotator, DustCap, FlatPanel, PolarAligner, GPS, Dome, WeatherStation, Switch, Receiver]
                              description: "The device's kind."
                            name:
                              type: string
                              description: "The device's name."
                            phase:
                              type: string
                              enum: [Inventory, Idle, Starting, Connecting, Connected, Disconnecting, Error]
                              description: "The device's `status.phase`."
                devices:
                  type: array
                  description: "Each device whose parent is this telescope."
                  x-kubernetes-list-type: atomic
                  items:
                    type: object
                    required: [kind, name]
                    description: "One device, with its phase."
                    properties:
                      kind:
                        type: string
                        enum: [Mount, Camera, FilterWheel, Focuser, Rotator, DustCap, FlatPanel, PolarAligner, GPS, Dome, WeatherStation, Switch, Receiver]
                        description: "The device's kind."
                      name:
                        type: string
                        description: "The device's name."
                      phase:
                        type: string
                        enum: [Inventory, Idle, Starting, Connecting, Connected, Disconnecting, Error]
                        description: "The device's `status.phase`."
                display:
                  type: object
                  required: [guider]
                  description: "What the printer columns show."
                  properties:
                    guider:
                      type: string
                      description: >-
                        The `Guider`'s phase, and PHD2's state while the
                        operator reads it, such as `Ready, Guiding`. It
                        is an empty string for a telescope with no
                        `Guider`.
                guider:
                  type: object
                  required: [name, ready]
                  description: >-
                    The telescope's `Guider`, and whether it is ready.
                  properties:
                    name:
                      type: string
                      description: "The guider's name."
                    ready:
                      type: boolean
                      description: >-
                        Whether the guider's `Ready` condition is
                        `True`.
                    reason:
                      type: string
                      description: >-
                        The reason of the guider's `Ready` condition.
                    phase:
                      type: string
                      enum: [Idle, Activating, Ready, Deactivating, Error]
                      description: "The `Guider`'s `status.phase`."
                    state:
                      type: string
                      enum: [Stopped, Selected, Calibrating, Guiding, LostLock, Paused, Looping]
                      description: >-
                        PHD2's state, the `Guider`'s `status.state`.
{{- define "action" }}
type: object
description: >-
  One action, which names exactly one of `job` and
  `notify`.
x-kubernetes-validations:
  - rule: "[has(self.job), has(self.notify)].filter(x, x).size() == 1"
    message: "an action of a Telescope names exactly one of job and notify"
properties:
{{ include "action fields" . | indent 2 }}
{{- end }}
