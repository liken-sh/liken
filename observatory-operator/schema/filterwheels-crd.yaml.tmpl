# A `FilterWheel` holds the filters in front of a camera: an INDI driver
# with `FILTER_INTERFACE`.
#
# A device resource is inventory: `observatory-operator` starts its pod
# only while a `Reservation` needs it. The fields that every device
# shares come from `device.yaml.tmpl`, and the procedure schema from
# `procedures.yaml.tmpl`, so all 13 device CRDs hold the same copy. The
# typed fields of INDI's standard properties come from
# `filterwheels-fields.yaml`.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: filterwheels.observatory.liken.sh
spec:
  group: observatory.liken.sh
  names:
    kind: FilterWheel
    listKind: FilterWheelList
    plural: filterwheels
    singular: filterwheel
    shortNames: [fw]
    categories: [astro]
  scope: Namespaced
  versions:
    - name: v1alpha1
      served: true
      storage: true
      subresources:
        status: {}
      selectableFields:
        - jsonPath: .spec.opticalTrain
      additionalPrinterColumns:
        - name: Train
          type: string
          jsonPath: .spec.opticalTrain
        - name: Phase
          type: string
          jsonPath: .status.phase
        - name: Slot
          type: integer
          jsonPath: .status.readings.slot
        - name: Filter
          type: string
          jsonPath: .status.readings.filter
        - name: Age
          type: date
          jsonPath: .metadata.creationTimestamp
        - name: Driver
          type: string
          jsonPath: .spec.driver.name
          priority: 1
        - name: Device
          type: string
          jsonPath: .status.indiDevice
          priority: 1
        - name: Node
          type: string
          jsonPath: .status.node
          priority: 1
        - name: Message
          type: string
          jsonPath: '.status.conditions[?(@.type=="Ready")].message'
          priority: 1
      schema:
        openAPIV3Schema:
          type: object
          x-kubernetes-validations:
            - rule: size(self.metadata.name) <= 32
              message: >-
                a FilterWheel name is at most 32 characters, because
                observatory-operator names its pod and Service
                <name>-filterwheel, and a Service name holds at most 63
                characters
          description: >-
            A `FilterWheel` holds the filters in front of a camera: an
            INDI driver with `FILTER_INTERFACE`.
          required: [spec]
          properties:
            spec:
              type: object
              description: "One filter wheel, with INDI's `FILTER_INTERFACE`."
              x-kubernetes-validations:
{{ include "device rules" . | indent 16 }}
              properties:
                opticalTrain:
                  type: string
                  minLength: 1
                  maxLength: 253
                  pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  description: >-
                    The name of the `OpticalTrain` that the device is
                    on. The train's members set what each camera on it
                    snoops.
                    Optional. With no `opticalTrain`, the device is on
                    the shelf, and the operator creates nothing for it.
{{ include "device spec" . | indent 16 }}
{{ settings | indent 16 }}
{{ include "procedure spec" . | indent 16 }}
            status:
              type: object
              description: >-
                What the operator observes. The operator writes it, and
                a person reads it.
              properties:
{{ include "device status" . | indent 16 }}
{{ standard | indent 16 }}
                readings:
                  type: object
                  description: >-
                    What the filter wheel reports, from `FILTER_SLOT`
                    and `FILTER_NAME`. A field is absent until the
                    driver sends it.
                  properties:
                    slot:
                      type: integer
                      format: int32
                      minimum: 1
                      description: "The slot in the light path, from 1."
                    filter:
                      type: string
                      description: "The name of the filter in that slot."
{{- define "action" }}
type: object
description: >-
  One action, which names `job`.
x-kubernetes-validations:
  - rule: "has(self.job)"
    message: "an action of a FilterWheel names job"
properties:
{{ include "action fields" . | indent 2 }}
{{- end }}
