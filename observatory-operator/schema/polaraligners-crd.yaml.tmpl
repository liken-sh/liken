# A `PolarAligner` moves a mount's polar axis in altitude and azimuth:
# an INDI driver with `PAC_INTERFACE`.
#
# A device resource is inventory: `observatory-operator` starts its pod
# only while a `Reservation` needs it. The fields that every device
# shares come from `device.yaml.tmpl`, and the procedure schema from
# `procedures.yaml.tmpl`, so all 14 device CRDs hold the same copy. The
# typed fields of INDI's standard properties come from
# `polaraligners-fields.yaml`.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: polaraligners.observatory.liken.sh
spec:
  group: observatory.liken.sh
  names:
    kind: PolarAligner
    listKind: PolarAlignerList
    plural: polaraligners
    singular: polaraligner
    shortNames: [pac]
    categories: [astro]
  scope: Namespaced
  versions:
    - name: v1alpha1
      served: true
      storage: true
      subresources:
        status: {}
      selectableFields:
        - jsonPath: .spec.telescope
      additionalPrinterColumns:
        - name: Telescope
          type: string
          jsonPath: .spec.telescope
        - name: Phase
          type: string
          jsonPath: .status.phase
        - name: Adjustment
          type: string
          jsonPath: .status.readings.adjustment
        - name: Age
          type: date
          jsonPath: .metadata.creationTimestamp
        - name: Driver
          type: string
          jsonPath: .spec.driver.name
          priority: 1
        - name: Device
          type: string
          jsonPath: .status.indiDevice
          priority: 1
        - name: Node
          type: string
          jsonPath: .status.node
          priority: 1
        - name: Message
          type: string
          jsonPath: '.status.conditions[?(@.type=="Ready")].message'
          priority: 1
      schema:
        openAPIV3Schema:
          type: object
          x-kubernetes-validations:
            - rule: size(self.metadata.name) <= 32
              message: >-
                a PolarAligner name is at most 32 characters, because
                observatory-operator names its pod and Service
                <name>-polaraligner, and a Service name holds at most 63
                characters
          description: >-
            A `PolarAligner` moves a mount's polar axis in altitude and
            azimuth: an INDI driver with `PAC_INTERFACE`.
          required: [spec]
          properties:
            spec:
              type: object
              required: [driver]
              description: >-
                One polar alignment corrector, with INDI's
                `PAC_INTERFACE`.
              properties:
                telescope:
                  type: string
                  minLength: 1
                  maxLength: 253
                  pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  description: >-
                    The name of the `Telescope` that the device belongs
                    to.
                    Optional. With no `telescope`, the device is on the
                    shelf, and the operator creates nothing for it.
{{ include "device spec" . | indent 16 }}
{{ settings | indent 16 }}
{{ include "procedure spec" . | indent 16 }}
            status:
              type: object
              description: >-
                What the operator observes. The operator writes it, and
                a person reads it.
              properties:
{{ include "device status" . | indent 16 }}
{{ standard | indent 16 }}
                readings:
                  type: object
                  description: >-
                    What the polar aligner reports, from
                    `PAC_MANUAL_ADJUSTMENT`. A field is absent until the
                    driver sends it.
                  properties:
                    adjustment:
                      type: string
                      enum: [Idle, Ok, Busy, Alert]
                      description: >-
                        The state of `PAC_MANUAL_ADJUSTMENT`: `Busy`
                        while the motors move, `Ok` when a move ended,
                        and `Alert` when it failed.
{{- define "action" }}
type: object
description: >-
  One action, which names `job`.
x-kubernetes-validations:
  - rule: "has(self.job)"
    message: "an action of a PolarAligner names job"
properties:
{{ include "action fields" . | indent 2 }}
{{- end }}
