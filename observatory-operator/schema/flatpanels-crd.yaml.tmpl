# A `FlatPanel` lights the optical tube evenly for flat frames: an INDI
# driver with `LIGHTBOX_INTERFACE`.
#
# A device resource is inventory: `observatory-operator` starts its pod
# only while a `Reservation` needs it. The fields that every device
# shares come from `device.yaml.tmpl`, and the procedure schema from
# `procedures.yaml.tmpl`, so all 14 device CRDs hold the same copy. The
# typed fields of INDI's standard properties come from
# `flatpanels-fields.yaml`.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: flatpanels.observatory.liken.sh
spec:
  group: observatory.liken.sh
  names:
    kind: FlatPanel
    listKind: FlatPanelList
    plural: flatpanels
    singular: flatpanel
    shortNames: [flat]
    categories: [astro]
  scope: Namespaced
  versions:
    - name: v1alpha1
      served: true
      storage: true
      subresources:
        status: {}
      selectableFields:
        - jsonPath: .spec.opticalTrain
      additionalPrinterColumns:
        - name: Train
          type: string
          jsonPath: .spec.opticalTrain
        - name: Phase
          type: string
          jsonPath: .status.phase
        - name: Light
          type: string
          jsonPath: .status.readings.light
        - name: Brightness
          type: string
          jsonPath: .status.display.brightness
        - name: Age
          type: date
          jsonPath: .metadata.creationTimestamp
        - name: Driver
          type: string
          jsonPath: .spec.driver.name
          priority: 1
        - name: Device
          type: string
          jsonPath: .status.indiDevice
          priority: 1
        - name: Node
          type: string
          jsonPath: .status.node
          priority: 1
        - name: Message
          type: string
          jsonPath: '.status.conditions[?(@.type=="Ready")].message'
          priority: 1
      schema:
        openAPIV3Schema:
          type: object
          x-kubernetes-validations:
            - rule: size(self.metadata.name) <= 32
              message: >-
                a FlatPanel name is at most 32 characters, because
                observatory-operator names its pod and Service
                <name>-flatpanel, and a Service name holds at most 63
                characters
          description: >-
            A `FlatPanel` lights the optical tube evenly for flat
            frames: an INDI driver with `LIGHTBOX_INTERFACE`.
            Deactivation switches its light off.
          required: [spec]
          properties:
            spec:
              type: object
              required: [driver]
              description: "One flat panel, with INDI's `LIGHTBOX_INTERFACE`."
              properties:
                opticalTrain:
                  type: string
                  minLength: 1
                  maxLength: 253
                  pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  description: >-
                    The name of the `OpticalTrain` that the device is
                    on. The train's members set what each camera on it
                    snoops.
                    Optional. With no `opticalTrain`, the device is on
                    the shelf, and the operator creates nothing for it.
{{ include "device spec" . | indent 16 }}
{{ settings | indent 16 }}
{{ include "procedure spec" . | indent 16 }}
            status:
              type: object
              description: >-
                What the operator observes. The operator writes it, and
                a person reads it.
              properties:
{{ include "device status" . | indent 16 }}
{{ standard | indent 16 }}
                display:
                  type: object
                  description: >-
                    The readings as a person reads them, with their units,
                    for the printer columns. The numbers are in `readings`.
                  properties:
                    brightness:
                      type: string
                      description: "The brightness against the maximum of `FLAT_LIGHT_INTENSITY`, such as `128 of 255`. INDI gives the brightness no unit."
                readings:
                  type: object
                  description: >-
                    What the flat panel reports, from
                    `FLAT_LIGHT_CONTROL` and `FLAT_LIGHT_INTENSITY`. A
                    field is absent until the driver sends it.
                  properties:
                    light:
                      type: string
                      enum: [Lit, Dark]
                      description: >-
                        `Lit` while the `FLAT_LIGHT_ON` member of
                        `FLAT_LIGHT_CONTROL` is on, and `Dark` while
                        `FLAT_LIGHT_OFF` is on.
                    brightness:
                      type: number
                      minimum: 0
                      description: >-
                        The light's brightness, in the driver's own
                        units, from 0 to the maximum that
                        `FLAT_LIGHT_INTENSITY` defines.
{{- define "action" }}
type: object
description: >-
  One action, which names exactly one of `state` and
  `job`.
x-kubernetes-validations:
  - rule: "[has(self.state), has(self.job)].filter(x, x).size() == 1"
    message: "an action of a FlatPanel names exactly one of state and job"
properties:
  state:
    type: string
    enum: [Lit, Dark]
    description: >-
      The light to reach: `Lit` or `Dark`, written
      to `FLAT_LIGHT_CONTROL`. The default timeout
      is 10 minutes.
{{ include "action fields" . | indent 2 }}
{{- end }}
