{{- define "device rules" }}
- rule: "has(self.driver) != has(self.device)"
  message: "set exactly one of spec.driver and spec.device"
- rule: "!has(self.device) || (!has(self.power) && !has(self.claim))"
  message: >-
    spec.power and spec.claim belong to the resource that runs the
    driver, which spec.device names
- rule: "has(self.device) == has(oldSelf.device)"
  message: >-
    a resource keeps spec.driver or spec.device for its life: delete it
    and create it again to change which one it has
{{- end }}
{{- define "device spec" }}
driver:
  type: object
  required: [name]
  description: >-
    The INDI driver that runs the device. With no
    `image`, the operator runs the image that the `indi`
    build lists for the driver, so `name` must then be
    an INDI driver that the image holds, such as
    `indi_simulator_ccd`. Set `driver` or `device`, not
    both.
  x-kubernetes-validations:
    - rule: "has(self.image) || self.name.matches('^indi_[a-z0-9_]+$')"
      message: "driver.name must match ^indi_[a-z0-9_]+$ when driver.image is not set"
  properties:
    name:
      type: string
      minLength: 1
      maxLength: 128
      pattern: "^[A-Za-z0-9_][A-Za-z0-9_.+-]*$"
      description: >-
        The driver's executable, such as
        `indi_simulator_ccd`. The device's pod runs it
        under `socat`, so the name holds no path, no
        space, no comma, and no colon.
    image:
      type: string
      minLength: 1
      maxLength: 512
      description: >-
        The container image that holds the driver, used
        as written. The image must hold `/usr/bin/socat`
        and the driver on `PATH`, and must run as user
        1000 with a read-only root filesystem and a
        writable `/tmp`. An image built `FROM
        ghcr.io/liken-sh/indi` meets all three.
        Optional.
device:
  type: object
  required: [kind, name]
  description: >-
    The resource whose driver serves this device, in
    place of a driver of its own. INDI puts every
    interface of one driver on one device, so a camera
    with a built-in filter wheel serves a `FilterWheel`,
    and a flat panel with a motorized cover serves a
    `DustCap`. The resource it names runs the driver,
    holds the pod, the claim, and the power, and must be
    on the same INDI server. The operator connects that
    device before this one's activation, and runs this
    one's deactivation before that device stops. Set
    `driver` or `device`, not both. The field cannot
    change, and a resource that runs a driver cannot
    gain it: delete the resource and create it again to
    move it to another device.
  x-kubernetes-validations:
    - rule: "self == oldSelf"
      message: >-
        spec.device cannot change: delete the resource and create
        it again to move it to another device
  properties:
    kind:
      type: string
      enum: [Mount, Camera, FilterWheel, Focuser, Rotator, DustCap, FlatPanel, PolarAligner, GPS, Dome, WeatherStation, Switch, Receiver]
      description: >-
        The kind of the resource that runs the driver,
        such as `Camera`.
    name:
      type: string
      minLength: 1
      maxLength: 253
      pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
      description: "The name of that resource in this namespace."
power:
  type: object
  required: [switch, output]
  description: >-
    The `Switch` output that powers the device.
    Activation switches the output on before the
    device's pod starts, and deactivation switches it
    off after the pod stops. Optional. With no power, a
    person powers the device on and off by hand.
  properties:
    switch:
      type: string
      minLength: 1
      maxLength: 253
      pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
      description: "The name of a `Switch` in this namespace."
    output:
      type: integer
      format: int32
      minimum: 1
      description: >-
        The number of the output, from 1, as the driver
        numbers `DIGITAL_OUTPUT_1`.
claim:
  type: object
  description: >-
    A `ResourceClaimSpec` of the `resource.k8s.io` API,
    for real hardware. The operator creates a
    `ResourceClaim` from it for the device's pod. The
    API server validates it when the operator creates
    the claim. Optional. A simulator needs no claim.
  x-kubernetes-preserve-unknown-fields: true
{{- end }}
{{- define "device status" }}
observedGeneration:
  type: integer
  format: int64
  description: >-
    The `metadata.generation` of the spec that the
    operator last acted on.
phase:
  type: string
  enum: [Inventory, Idle, Starting, Connecting, Connected, Disconnecting, Error]
  description: >-
    The device's state in one word. `Inventory`: the
    device is on the shelf, with no parent, and the
    operator creates nothing for it. `Idle`: the device
    is installed, but no reservation of its telescope or
    its observatory is active, so it has no pod.
    `Starting`: a reservation's activation began, or the
    device's pod starts. `Connecting`:
    the operator asked the driver to connect.
    `Connected`: the driver reports the device
    connected. `Disconnecting`: the operator asked the
    driver to disconnect, or stops the pod. `Error`: a
    step failed, and the `Ready` condition gives the
    reason.
conditions:
  type: array
  description: >-
    `Ready` is `True` while the device is connected.
    `ParentFound` is `False` when a resource that the
    spec names, up to the `Observatory`, does not exist,
    and its message names the missing resource. A
    device on the shelf names no parent, and its
    `ParentFound` is `True` with the reason `NoParent`.
    While a device is connected, it also reports the
    state that the triggers of procedures read, by
    kind: a `Dome` `Parked` and `Open` (the shutter), a
    `Mount` `Parked`, a `DustCap` `Open`,
    a `FlatPanel` `Lit` (the light), a `Camera`
    `Cooling` (the cooler), and a `WeatherStation`
    `Safe`. A park, a shutter, or a cover that moves is
    `Unknown` with the reason `Moving`. `Safe` is
    `False` with the reason `Warning` or `Danger`. A
    device that is not connected has none of them.
  x-kubernetes-list-type: map
  x-kubernetes-list-map-keys: [type]
  items:
    type: object
    required: [type, status, reason, message, lastTransitionTime]
    description: >-
      One condition, in the shape of `metav1.Condition`.
    properties:
      type:
        type: string
        minLength: 1
        maxLength: 316
        description: "The condition's name, such as `Ready`."
      status:
        type: string
        enum: ["True", "False", Unknown]
        description: >-
          Whether the condition holds: `True`, `False`,
          or `Unknown`.
      observedGeneration:
        type: integer
        format: int64
        minimum: 0
        description: >-
          The `metadata.generation` of the spec that the
          condition reflects.
      reason:
        type: string
        minLength: 1
        maxLength: 1024
        description: "One word in CamelCase for the cause."
      message:
        type: string
        maxLength: 32768
        description: >-
          The cause, for a person to read. It can be
          empty.
      lastTransitionTime:
        type: string
        format: date-time
        description: >-
          When `status` last changed. A write with the
          same status keeps this time.
{{ include "procedure status" . }}
indiDevice:
  type: string
  description: >-
    The name that the driver gives its device on the
    INDI server, such as `CCD Simulator`. KStars shows
    this name. A device that another resource serves
    names that resource's device. The field is present
    only while the driver runs and defines the device on
    its server, so an `Idle` device and a device on the
    shelf have none.
endpoint:
  type: object
  required: [service, host, port]
  description: >-
    The INDI server that runs the device. A client such
    as KStars reaches the device at this address by the
    name in `indiDevice`. The field is present only while
    the pod of the device's driver runs and is not
    stopping, which for a device that another resource
    serves is that resource's pod, and it names the
    server in that pod's `observatory.liken.sh/server`
    label. The driver stops on that server before the pod
    is deleted. A device that moves to another telescope
    names the server it left until that server deletes
    its pod. When a reservation ends, or the device moves
    to the shelf, the operator removes the field.
  properties:
    service:
      type: string
      description: "The name of the server's `Service`."
    host:
      type: string
      description: "The DNS name of the server's `Service` in the cluster."
    port:
      type: integer
      format: int32
      description: "The INDI port, 7624."
driver:
  type: string
  description: >-
    The driver that the device's pod runs. A device that
    another resource serves has no pod of its own.
image:
  type: string
  description: >-
    The image that the device's pod runs, after the
    operator resolved it.
pod:
  type: string
  description: "The name of the device's pod, while it exists."
node:
  type: string
  description: "The node that runs the device's pod, while the pod exists."
limits:
  type: object
  description: >-
    The range that the driver gives each number of this
    resource's typed fields that a client can write, by
    INDI property and then by member, such as
    `limits.CCD_TEMPERATURE.CCD_TEMPERATURE_VALUE`. Each
    range has `min` and `max`, the least and the greatest
    value that the driver accepts, and `step` when the
    driver states one. The schema describes each typed
    field, and the driver chooses only these ranges, such
    as a camera's least and greatest temperature or its
    range of gain.
  x-kubernetes-map-type: atomic
  additionalProperties:
    type: object
    description: "The members of one property, by name."
    additionalProperties:
      type: object
      required: [min, max]
      description: "The range of one member."
      properties:
        min:
          type: number
          description: "The least value that the driver accepts."
        max:
          type: number
          description: "The greatest value that the driver accepts."
        step:
          type: number
          description: >-
            The step between values. Absent when the driver
            states no step.
properties:
  type: array
  description: >-
    Each property of the INDI device that no typed field
    holds, as the driver defines it, with the values of
    its last update: a vendor's own properties, the
    properties that every INDI device has, such as
    `DEBUG`, and the standard properties of an interface
    that no resource on the device is, such as the
    `FILTER_SLOT` of a camera with no `FilterWheel`. Only
    the resource that runs the driver has the list, so
    each property is in one object, and no typed reading
    depends on one. The list holds no BLOB data.
  x-kubernetes-list-type: atomic
  items:
    type: object
    required: [name, type, permission, state]
    description: "One INDI property."
    properties:
      name:
        type: string
        minLength: 1
        description: >-
          The property's name, such as
          `CCD_TEMPERATURE`.
      label:
        type: string
        description: >-
          The label that the driver gives the property.
      group:
        type: string
        description: >-
          The group, or tab, that the driver puts the
          property in.
      type:
        type: string
        enum: [Number, Switch, Text, Light, BLOB]
        description: "The type of the members' values."
      permission:
        type: string
        enum: [ro, wo, rw]
        description: >-
          Whether a client can write the property: `ro`
          read-only, `wo` write-only, or `rw` read and
          write.
      state:
        type: string
        enum: [Idle, Ok, Busy, Alert]
        description: >-
          The property's state: `Busy` while the driver
          carries out a change, `Ok` or `Alert` when the
          change ends.
      rule:
        type: string
        enum: [OneOfMany, AtMostOne, AnyOfMany]
        description: >-
          For a switch property, how many members can be
          on at once.
      members:
        type: array
        description: >-
          The property's members, in the driver's order.
        x-kubernetes-list-type: atomic
        items:
          type: object
          required: [name]
          description: "One member of the property."
          properties:
            name:
              type: string
              minLength: 1
              description: >-
                The member's name, such as
                `CCD_TEMPERATURE_VALUE`.
            label:
              type: string
              description: >-
                The label that the driver gives the
                member.
            value:
              type: string
              description: >-
                The value as text: a number in the
                member's format, `On` or `Off` for a
                switch, a state for a light, or the
                text. A BLOB member has no value here.
            min:
              type: number
              description: >-
                For a number, the least value that the
                driver accepts.
            max:
              type: number
              description: >-
                For a number, the greatest value that
                the driver accepts.
            step:
              type: number
              description: >-
                For a number, the step between values.
                Zero means any step.
{{- end }}
