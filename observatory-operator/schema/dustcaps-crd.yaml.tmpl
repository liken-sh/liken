# A `DustCap` covers the front of an optical tube: an INDI driver with
# `DUSTCAP_INTERFACE`.
#
# A device resource is inventory: `observatory-operator` starts its pod
# only while a `Reservation` needs it. The fields that every device
# shares come from `device.yaml.tmpl`, and the procedure schema from
# `procedures.yaml.tmpl`, so all 14 device CRDs hold the same copy. The
# typed fields of INDI's standard properties come from
# `dustcaps-fields.yaml`.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: dustcaps.observatory.liken.sh
spec:
  group: observatory.liken.sh
  names:
    kind: DustCap
    listKind: DustCapList
    plural: dustcaps
    singular: dustcap
    shortNames: [cap]
    categories: [astro]
  scope: Namespaced
  versions:
    - name: v1alpha1
      served: true
      storage: true
      subresources:
        status: {}
      selectableFields:
        - jsonPath: .spec.opticalTrain
      additionalPrinterColumns:
        - name: Train
          type: string
          jsonPath: .spec.opticalTrain
        - name: Phase
          type: string
          jsonPath: .status.phase
        - name: Cover
          type: string
          jsonPath: .status.readings.cover
        - name: Age
          type: date
          jsonPath: .metadata.creationTimestamp
        - name: Driver
          type: string
          jsonPath: .spec.driver.name
          priority: 1
        - name: Device
          type: string
          jsonPath: .status.indiDevice
          priority: 1
        - name: Node
          type: string
          jsonPath: .status.node
          priority: 1
        - name: Message
          type: string
          jsonPath: '.status.conditions[?(@.type=="Ready")].message'
          priority: 1
      schema:
        openAPIV3Schema:
          type: object
          x-kubernetes-validations:
            - rule: size(self.metadata.name) <= 32
              message: >-
                a DustCap name is at most 32 characters, because
                observatory-operator names its pod and Service
                <name>-dustcap, and a Service name holds at most 63
                characters
          description: >-
            A `DustCap` covers the front of an optical tube: an INDI
            driver with `DUSTCAP_INTERFACE`. Activation opens it, and
            deactivation closes it.
          required: [spec]
          properties:
            spec:
              type: object
              required: [driver]
              description: "One dust cap, with INDI's `DUSTCAP_INTERFACE`."
              properties:
                opticalTrain:
                  type: string
                  minLength: 1
                  maxLength: 253
                  pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  description: >-
                    The name of the `OpticalTrain` that the device is
                    on. The train's members set what each camera on it
                    snoops.
                    Optional. With no `opticalTrain`, the device is on
                    the shelf, and the operator creates nothing for it.
{{ include "device spec" . | indent 16 }}
{{ settings | indent 16 }}
{{ include "procedure spec" . | indent 16 }}
            status:
              type: object
              description: >-
                What the operator observes. The operator writes it, and
                a person reads it.
              properties:
{{ include "device status" . | indent 16 }}
{{ standard | indent 16 }}
                readings:
                  type: object
                  description: >-
                    What the dust cap reports, from `CAP_PARK`. A field
                    is absent until the driver sends it.
                  properties:
                    cover:
                      type: string
                      enum: [Open, Closed, Moving]
                      description: >-
                        `Closed` when the cap is parked, `Open` when it
                        is unparked, and `Moving` while `CAP_PARK` is
                        `Busy`.
{{- define "action" }}
type: object
description: >-
  One action, which names exactly one of `state` and
  `job`.
x-kubernetes-validations:
  - rule: "[has(self.state), has(self.job)].filter(x, x).size() == 1"
    message: "an action of a DustCap names exactly one of state and job"
properties:
  state:
    type: string
    enum: [Open, Closed]
    description: >-
      The cover's position to reach: `Open` or
      `Closed`, written to `CAP_PARK` as `UNPARK` or
      `PARK`. The default timeout is 10 minutes.
{{ include "action fields" . | indent 2 }}
{{- end }}
