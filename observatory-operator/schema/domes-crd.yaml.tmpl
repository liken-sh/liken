# A `Dome` is the observatory's dome or roll-off roof: an INDI device
# that serves `DOME_INTERFACE`.
#
# A device resource is inventory: `observatory-operator` starts its pod
# only while a `Reservation` needs it. The fields that every device
# shares come from `device.yaml.tmpl`, and the procedure schema from
# `procedures.yaml.tmpl`, so all 13 device CRDs hold the same copy. The
# typed fields of INDI's standard properties come from
# `domes-fields.yaml`.
#
# The singular, `dome`, is already short, so the kind has no short name.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: domes.observatory.liken.sh
spec:
  group: observatory.liken.sh
  names:
    kind: Dome
    listKind: DomeList
    plural: domes
    singular: dome
    categories: [astro]
  scope: Namespaced
  versions:
    - name: v1alpha1
      served: true
      storage: true
      subresources:
        status: {}
      selectableFields:
        - jsonPath: .spec.observatory
      additionalPrinterColumns:
        - name: Observatory
          type: string
          jsonPath: .spec.observatory
        - name: Phase
          type: string
          jsonPath: .status.phase
        - name: Azimuth
          type: string
          jsonPath: .status.display.azimuth
        - name: Shutter
          type: string
          jsonPath: '.status.conditions[?(@.type=="Open")].reason'
        - name: Park
          type: string
          jsonPath: '.status.conditions[?(@.type=="Parked")].reason'
        - name: Age
          type: date
          jsonPath: .metadata.creationTimestamp
        - name: Driver
          type: string
          jsonPath: .spec.driver.name
          priority: 1
        - name: Device
          type: string
          jsonPath: .status.indiDevice
          priority: 1
        - name: Node
          type: string
          jsonPath: .status.node
          priority: 1
        - name: Message
          type: string
          jsonPath: '.status.conditions[?(@.type=="Ready")].message'
          priority: 1
      schema:
        openAPIV3Schema:
          type: object
          x-kubernetes-validations:
            - rule: size(self.metadata.name) <= 32
              message: >-
                a Dome name is at most 32 characters, because
                observatory-operator names its pod and Service
                <name>-dome, and a Service name holds at most 63
                characters
          description: >-
            A `Dome` is the observatory's dome or roll-off roof: an INDI
            device that serves `DOME_INTERFACE`. It runs on the observatory's
            own INDI server.
          required: [spec]
          properties:
            spec:
              type: object
              description: >-
                One dome or roll-off roof, with INDI's `DOME_INTERFACE`.
                While an `Observatory` has a dome, the dome does not
                park while a mount of the observatory is unparked, a
                mount does not unpark while the dome is parked, and the
                shutter closes when the dome parks and opens when it
                unparks. A `state` action sets the shutter too.
              x-kubernetes-validations:
{{ include "device rules" . | indent 16 }}
              properties:
                observatory:
                  type: string
                  minLength: 1
                  maxLength: 253
                  pattern: "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  description: >-
                    The name of the `Observatory` that the device
                    belongs to. The device runs on the observatory's own
                    INDI server.
                    Optional. With no `observatory`, the device is on
                    the shelf, and the operator creates nothing for it.
{{ include "device spec" . | indent 16 }}
{{ settings | indent 16 }}
{{ include "procedure spec" . | indent 16 }}
            status:
              type: object
              description: >-
                What the operator observes. The operator writes it, and
                a person reads it.
              properties:
{{ include "device status" . | indent 16 }}
{{ standard | indent 16 }}
                display:
                  type: object
                  description: >-
                    The values of the typed fields as a person reads them,
                    with their units, for the printer columns.
                  properties:
                    azimuth:
                      type: string
                      description: "The azimuth in degrees, such as `123.4°`."
{{- define "action" }}
type: object
description: >-
  One action, which names exactly one of `state`,
  `job`, and `notify`.
x-kubernetes-validations:
  - rule: "[has(self.state), has(self.job), has(self.notify)].filter(x, x).size() == 1"
    message: "an action of a Dome names exactly one of state, job, and notify"
properties:
  state:
    type: string
    enum: [Parked, Unparked]
    description: >-
      The park to reach: `Parked` or `Unparked`,
      written to `DOME_PARK`. A park that the driver
      reports already is not sent again. The shutter
      follows: after the park, the operator writes
      `SHUTTER_CLOSE` or `SHUTTER_OPEN` to
      `DOME_SHUTTER` when the shutter is not there
      already, because the driver moves the shutter
      only when the park state changes. The default
      timeout is 10 minutes.
{{ include "action fields" . | indent 2 }}
{{- end }}
