# The -cli image: one static binary, kubectl-liken-observatory, on a
# distroless base. It is built for linux/amd64 only.

# The build stage runs on the builder's own architecture and
# cross-compiles, so the build needs no emulation.
FROM --platform=$BUILDPLATFORM golang AS build
# proxy.golang.org sometimes drops a module download partway through.
# After a comma, `go` tries the origin only when the proxy returns 404
# or 410. After a pipe, it tries the origin after any proxy error. The
# default `GOSUMDB` still verifies a module fetched from its origin.
ENV GOPROXY="https://proxy.golang.org|direct"
WORKDIR /src
# The module files come first, so a source edit reuses the cached
# download layer.
COPY go.mod go.sum ./
# go.mod replaces the shared kubernetes module with ../kubernetes, so
# `go mod download` needs that module's go.mod, which comes from the
# build context named kubernetes. The CLI imports no package from that
# module, so the go.mod file is all it needs.
COPY --from=kubernetes go.mod /kubernetes/
RUN go mod download
# The CLI imports nothing from the operator's package, so only cli/ is
# copied.
COPY cli/ ./cli/
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
    -o /kubectl-liken-observatory ./cli
# The license files of the Go standard library and of each module the
# binary links. notices/go.sh explains why the image carries them.
COPY --from=notices go.sh /
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} sh /go.sh /notices ./cli

# The distroless static image has a nonroot user and no shell. The CA
# bundle of the trust component replaces the Debian bundle that
# distroless ships.
FROM distroless
COPY --from=trust / /
COPY --from=build /kubectl-liken-observatory /kubectl-liken-observatory
COPY --from=build /notices /
# With the binary as the entrypoint, `docker run` passes its arguments
# to the plugin.
ENTRYPOINT ["/kubectl-liken-observatory"]
