{
  "title": "display-operator",
  "uid": "display-operator",
  "schemaVersion": 42,
  "editable": true,
  "tags": ["liken"],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "type": "query",
        "name": "node",
        "label": "Node",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": {
          "query": "label_values(liken_build_info{component=\"display-operator\"}, node)",
          "refId": "node"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Build info",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "liken_build_info{component=\"display-operator\", node=~\"$node\"}",
          "legendFormat": "{{version}}",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 2,
      "title": "Reconcile rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(display_reconcile_duration_seconds_count{node=~\"$node\"}[5m]))",
          "legendFormat": "{{kind}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(display_reconcile_errors_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{kind}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 4,
      "title": "Reconcile duration (p50/p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, kind) (rate(display_reconcile_duration_seconds_bucket{node=~\"$node\"}[5m])))",
          "legendFormat": "p50 {{kind}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, kind) (rate(display_reconcile_duration_seconds_bucket{node=~\"$node\"}[5m])))",
          "legendFormat": "p99 {{kind}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 5,
      "title": "Watch restarts",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(display_watch_restarts_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{kind}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 6,
      "title": "Output connected",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "max": 1, "min": 0 }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "display_output_connected{node=~\"$node\"}",
          "legendFormat": "{{output}} ({{node}})",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 7,
      "title": "Output claimed",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "max": 1, "min": 0 }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "display_output_claimed{node=~\"$node\"}",
          "legendFormat": "{{output}} ({{node}})",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 8,
      "title": "Observation valid",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": { "defaults": { "max": 1, "min": 0 }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "display_observation_valid{node=~\"$node\"}",
          "legendFormat": "{{source}} ({{node}})",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 9,
      "title": "Seconds since last observation",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "time() - display_observation_last_success_timestamp_seconds{node=~\"$node\"}",
          "legendFormat": "{{source}} ({{node}})",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 10,
      "title": "Output mode",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 38 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "display_output_mode_info{node=~\"$node\"}",
          "legendFormat": "{{output}}",
          "format": "table",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 11,
      "title": "Compositor restarts",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(display_compositor_restarts_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{reason}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 12,
      "title": "Surfaces",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "display_surfaces{node=~\"$node\"}",
          "legendFormat": "{{output}} ({{node}})",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 13,
      "title": "Panel power",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "fieldConfig": { "defaults": { "max": 1, "min": 0 }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "display_panel_power{node=~\"$node\"}",
          "legendFormat": "{{output}} ({{node}})",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 14,
      "title": "Panel brightness",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "display_panel_brightness{node=~\"$node\"}",
          "legendFormat": "{{output}} ({{node}})",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    }
  ]
}
