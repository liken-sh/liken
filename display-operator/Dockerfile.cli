# The -cli image: the static binary kubectl-liken-display on a
# distroless base, built for linux/amd64 only.

# The build stage runs on the builder's architecture and
# cross-compiles, so it needs no emulation.
FROM --platform=$BUILDPLATFORM golang AS build
# The pipe lets `go` fall back to the origin after any proxy error, as
# in Dockerfile.
ENV GOPROXY="https://proxy.golang.org|direct"
WORKDIR /src
COPY go.mod go.sum ./
# go.mod replaces the kubernetes module with ../kubernetes, so
# `go mod download` needs that module's go.mod. The CLI imports none of
# its packages, so the go.mod alone is enough.
COPY --from=kubernetes go.mod /kubernetes/
RUN go mod download
COPY cli/ ./cli/
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
    -o /kubectl-liken-display ./cli
COPY --from=notices go.sh /
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} sh /go.sh /notices ./cli

# The CLI calls an HTTPS API, so the image needs a CA bundle. The
# bundle that the `trust` component pins replaces the Debian bundle of
# distroless, with its license notice.
FROM distroless
COPY --from=trust / /
COPY --from=build /kubectl-liken-display /kubectl-liken-display
COPY --from=build /notices /
ENTRYPOINT ["/kubectl-liken-display"]
