# The image for the solver pods and the worker pods: the operator's
# binary on the astrometry image, which has astrometry-engine,
# solve-field, source-extractor, and the libraries they load. The
# operator runs the binary in solver mode for each Solver, and in
# worker mode beside each Reservation's outbox. The build stage is the
# same as in Dockerfile, so both images contain the same binary.

FROM golang AS build
# Falls back to the module's origin after any proxy error, as in
# Dockerfile.
ENV GOPROXY="https://proxy.golang.org|direct"
WORKDIR /src
COPY go.mod go.sum ./
COPY --from=kubernetes go.mod go.sum /kubernetes/
COPY --from=observatory go.mod go.sum /observatory-operator/
RUN go mod download
COPY --from=kubernetes . /kubernetes/
COPY --from=observatory indi/*.go /observatory-operator/indi/
COPY --from=observatory phd2/*.go /observatory-operator/phd2/
COPY --from=observatory observatory/*.go /observatory-operator/observatory/
COPY *.go ./
COPY astrophotography/*.go ./astrophotography/
COPY catalog/*.go ./catalog/
COPY fits/*.go ./fits/
COPY outbox/*.go ./outbox/
COPY promote/*.go ./promote/
COPY sky/*.go ./sky/
COPY solver/*.go ./solver/
COPY worker/*.go ./worker/
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /astrophotography-operator .
# The Go notices go under /usr/share/doc, beside the astrometry image's
# own (notices/go.sh).
COPY --from=notices go.sh /
RUN CGO_ENABLED=0 sh /go.sh /notices .

# docker-bake.hcl at the top of the repository supplies the astrometry
# image of the same commit as the build context `astrometry`.
FROM astrometry
COPY --from=build /astrophotography-operator /astrophotography-operator
COPY --from=build /notices /
# The solver and worker pods run as user 1000, the same user as
# observatory-operator's drivers.
USER 1000:1000
ENTRYPOINT ["/astrophotography-operator"]
