          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (job, kind) (rate({__name__=~\"(liken|display|media|library|audio|bluetooth|equipment|git_csi|per_node_csi)_reconcile_errors_total\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{__name__}} {{job}}/{{kind}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Reconcile duration p50 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.50, sum by (job, kind, le) (rate({__name__=~\"(liken|display|media|library|audio|bluetooth|equipment|git_csi|per_node_csi)_reconcile_duration_seconds_bucket\"}[5m])))",
          "refId": "A",
          "legendFormat": "p50 {{__name__}} {{job}}/{{kind}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum by (job, kind, le) (rate({__name__=~\"(liken|display|media|library|audio|bluetooth|equipment|git_csi|per_node_csi)_reconcile_duration_seconds_bucket\"}[5m])))",
          "refId": "B",
          "legendFormat": "p99 {{__name__}} {{job}}/{{kind}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Watch restarts rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
