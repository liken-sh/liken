        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le, kind) (rate(equipment_reconcile_duration_seconds_bucket[5m])))",
          "refId": "B",
          "legendFormat": "p99 {{kind}}"
        }
      ]
