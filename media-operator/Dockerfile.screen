# Builds both screen images, idle and display, as two targets over one
# dependency stage. The two crates share a cargo workspace, so the
# dependencies compile once. Every build must name a target.

FROM rust AS deps
WORKDIR /src

# The manifests come before the sources, so a source edit reuses the
# cached dependency layer. The workspace has two path dependencies outside
# this directory: liken-iced from the `brand` build context and
# media-screen from the `media-screen` build context. Each is copied to
# the same path relative to /src that it has relative to this component.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY idle/Cargo.toml idle/
COPY display/Cargo.toml display/
COPY --from=brand iced/Cargo.toml iced/Cargo.lock /brand/iced/
COPY --from=media-screen Cargo.toml /media-screen/

# Empty stub sources let cargo build every dependency before the real
# sources are copied.
RUN mkdir -p idle/src display/src /brand/iced/src /media-screen/src \
    && echo 'fn main() {}' > idle/src/main.rs \
    && : > idle/src/lib.rs \
    && : > /media-screen/src/lib.rs \
    && echo 'fn main() {}' > display/src/main.rs \
    && : > display/src/lib.rs \
    && : > /brand/iced/src/lib.rs

# cargo-auditable records the crate graph in the binary's `.dep-v0`
# section, so syft and Trivy list the crates of the image. Every cargo
# build here, the stub build included, runs through it so the
# dependencies compile once. toolchains/cargo-auditable/fetch.sh pins it.
COPY --from=toolchains pin.sh /toolchains/
COPY --from=toolchains cargo-auditable/fetch.sh /toolchains/cargo-auditable/
RUN bash /toolchains/cargo-auditable/fetch.sh /usr/local/cargo/bin

# The cache mounts keep downloaded crates between builds. --locked
# fails the build when Cargo.lock needs changes.
#
# --no-default-features turns off the idle screen's `measure` feature,
# which adds frame capture and measurements and pulls in a PNG codec.
# The operator sets no command on the idle container, so nothing can pass
# the flag that uses it. `make test-rust` tests the default build with
# the feature on, so the idle target runs the shipped binary below to
# prove this configuration starts.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo auditable build --release --locked --no-default-features -p idle-screen \
    && cargo auditable build --release --locked -p media-display

# The real liken-iced sources replace the stub, with the two brand files
# it parses and the fonts it embeds. The stub build does not need them.
COPY --from=brand iced/src/ /brand/iced/src/
COPY --from=brand liken.svg liken.css /brand/
COPY --from=brand fonts/ /brand/fonts/

FROM deps AS build-idle
COPY --from=media-screen src/ /media-screen/src/
COPY idle/src/ idle/src/
COPY --from=notices cargo.sh /
# touch makes the three crates' sources newer than the stub build, so
# cargo recompiles them and reuses the dependencies. cargo.sh copies the
# license files of the standard library and of each linked crate. It runs
# in the same RUN as the build because it reads the crate sources from the
# registry cache, and a cache mount exists only during the RUN that
# mounts it.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    touch idle/src/main.rs idle/src/lib.rs /media-screen/src/lib.rs \
        /brand/iced/src/*.rs \
    && cargo auditable build --release --locked --no-default-features -p idle-screen \
    && sh /cargo.sh /notices --no-default-features -p idle-screen

FROM deps AS build-display
COPY display/src/ display/src/
COPY --from=notices cargo.sh /
# As in build-idle, touch forces cargo to recompile the crates and reuse
# the dependencies, and cargo.sh copies the license files.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    touch display/src/main.rs display/src/lib.rs /brand/iced/src/*.rs \
    && cargo auditable build --release --locked -p media-display \
    && sh /cargo.sh /notices -p media-display

# fonts-droid-fallback supplies Chinese, Japanese, and Korean glyphs.
# Both screens show text that users write, and Source Sans 3 has none of
# those characters, so without a fallback each one draws as a blank box.
# The runtime images have no package manager, so this stage installs the
# package from the same Debian snapshot as the vulkan base. snapshot.sh
# comes from the `builder` build context, which is the vulkan directory,
# and SNAPSHOT is vulkan's version.
FROM debian AS fonts
ARG SNAPSHOT
COPY --from=builder snapshot.sh snapshot.sha256 /
RUN sh /snapshot.sh "$SNAPSHOT" \
    && apt-get install -y --no-install-recommends fonts-droid-fallback \
    && rm -rf /var/lib/apt/lists/*

# The idle image runs the Rust client that draws the idle screen. It is
# separate from the operator's scratch image because the client needs a
# graphics stack.
#
# The vulkan base has the Vulkan loader, the Intel and AMD drivers, the
# Wayland and keyboard libraries that winit opens by name at run time,
# and the zoneinfo database. Rust's standard library has no time zones,
# so the clock reads the zone that TZ names from that database. The
# compositor image builds on the same base, so a node that runs both
# stores one copy of Mesa.
#
# The binary embeds the brand's two faces. The toolkit finds every other
# face, such as the fallback fonts, in /usr/share/fonts.
FROM vulkan AS idle

COPY --from=fonts /usr/share/fonts/truetype/droid /usr/share/fonts/truetype/droid
COPY --from=fonts /usr/share/doc/fonts-droid-fallback/copyright /usr/share/doc/fonts-droid-fallback/copyright

COPY --from=build-idle /src/target/release/idle-screen /idle-screen
COPY --from=build-idle /notices /
# The SIL Open Font License requires the license to ship with the
# embedded faces.
COPY --from=brand fonts/LICENSE.md /usr/share/doc/source-sans-3/LICENSE.md

# Runs the binary at build time. --help opens no window and needs no
# compositor, so this proves that the linked libraries resolve and the
# process starts and exits 0. It does not prove that the Wayland and
# Vulkan libraries, which the toolkit opens at run time, load. The exec
# form is needed because the image has no shell.
RUN ["/idle-screen", "--help"]

# The operator sets no command on the idle container, so the entrypoint
# starts the binary as the container's main process.
ENTRYPOINT ["/idle-screen"]

# The display image runs the Rust client that draws the on-screen display
# over the film, on the same base as the idle image.
FROM vulkan AS display

COPY --from=fonts /usr/share/fonts/truetype/droid /usr/share/fonts/truetype/droid
COPY --from=fonts /usr/share/doc/fonts-droid-fallback/copyright /usr/share/doc/fonts-droid-fallback/copyright

# The binary embeds the same two faces. The files in /usr/share/fonts
# make the family resolve when the toolkit looks it up by name.
COPY --from=brand fonts/SourceSans3-Regular.otf \
     fonts/SourceSans3-It.otf \
     fonts/LICENSE.md \
     /usr/share/fonts/opentype/source-sans-3/

COPY --from=build-display /src/target/release/media-display /media-display
COPY --from=build-display /notices /

# The display binary has no flag that prints and exits, so this build
# step runs the loader's --list mode, which fails when a linked library
# is missing. It does not cover libraries that the toolkit opens at run
# time.
RUN ["/lib64/ld-linux-x86-64.so.2", "--list", "/media-display"]

# The compositor blends the display over the film by its alpha, and the
# scrims fade from an alpha of 0.796 to clear, so the surface needs more
# than a few alpha levels.
#
# iced_wgpu 0.14 picks the first non-sRGB format that the swapchain lists,
# and the program cannot choose another. Mesa's Wayland swapchain lists
# its 10-bit formats first, such as A2B10G10R10, whose alpha has 2 bits
# and so four levels. Each scrim then draws as two flat bands, and
# dithering the alpha shows as grain.
#
# vk_wsi_force_bgra8_unorm_first is a driconf option of Mesa's Vulkan
# swapchain, and Mesa also reads it from the environment. It lists
# B8G8R8A8_UNORM first, which has 8 bits of alpha. Only this image sets
# it, because the idle screen and the media browser draw opaque frames.
# The option works only on Mesa, and it chooses 8-bit color even on a GPU
# that offers a 16-bit format with full alpha. The open problem "the
# display cannot choose its surface format" in
# media-operator/plans/open-problems describes a fix that picks from the
# list.
ENV vk_wsi_force_bgra8_unorm_first=true

# As in the idle image, the operator sets no command on the container.
ENTRYPOINT ["/media-display"]
