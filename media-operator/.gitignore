# The built operator binary.
/media-operator

# Hugo's build output. The workflow and a workstation both write the
# site here, and the lock file guards a single hugo process against a
# second one in the same source tree.
/docs/dist/
/docs/.hugo_build.lock
/docs/public/

# The coverage profile the gate measures. CI writes it on every
# run and reads it once; it never belongs to the tree.
/coverage.out

# The Rust build tree. cargo writes it under idle/ and rebuilds anything
# it needs, so it never belongs to the tree.
/idle/target/
