# syntax=docker/dockerfile:1

# The idle image: the Rust client that draws the idle screen, and the
# Wayland and Vulkan libraries it opens by name on a real machine. It is
# an image of its own, because this client shares no code with the Go
# binary and needs a graphics stack the operator's scratch image has
# none of.
#
# The build context is the repository root, the way every other image takes
# it, so the build reaches both crates and the brand submodule the client
# reads its mark and its palette from.

FROM rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS build
WORKDIR /src

# The two Rust crates are one cargo workspace, so the build copies the
# workspace manifest, the lock file, and the toolchain pin, then both member
# manifests. liken-iced is a path dependency in the brand submodule, and the
# stub build below needs only its manifest, so the manifest and its lock file
# arrive here and the crate's sources arrive after that layer. A source edit
# or a submodule bump then reuses the cached dependency layer.
#
# The dependencies are almost all of the build, and they change only when the
# lock file changes.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY idle/Cargo.toml idle/
COPY media-screen/Cargo.toml media-screen/
COPY docs/themes/brand/iced/Cargo.toml docs/themes/brand/iced/Cargo.lock docs/themes/brand/iced/

# A stub library and a stub binary for each workspace member, and a stub
# library for liken-iced, give cargo something to compile the dependencies
# against. That build is the layer the image cache keeps.
RUN mkdir idle/src media-screen/src docs/themes/brand/iced/src \
    && echo 'fn main() {}' > idle/src/main.rs \
    && : > idle/src/lib.rs \
    && : > media-screen/src/lib.rs \
    && : > docs/themes/brand/iced/src/lib.rs

# The cache mounts hold the crate registry and the git checkouts between
# builds, so a rebuild on a workstation downloads no crate a second time.
# --locked builds the versions the lock file names and never rewrites it.
#
# --no-default-features drops the crate's `measure` feature, which is the frame
# capture and the measurements. No pod reaches either one: the operator sets no
# command on the idle container, so the entrypoint below takes no flag. Without
# the feature the binary carries no PNG codec and collects no per-frame sample.
#
# This is a narrower configuration than the crate's own gates measure, because
# `make test` in idle/ runs the default build with the feature on. The last
# step of this file runs the binary it produced, so the configuration the image
# ships is proven to start rather than assumed to.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --locked --no-default-features -p idle-screen

COPY media-screen/src/ media-screen/src/
COPY idle/src/ idle/src/
# liken-iced's sources land here, over the stub, with the two brand files it
# parses and the two font files it embeds. All four are inputs of the real
# build alone; the stub compiles without them.
COPY docs/themes/brand/iced/src/ docs/themes/brand/iced/src/
COPY docs/themes/brand/liken.svg docs/themes/brand/liken.css docs/themes/brand/
COPY docs/themes/brand/fonts/ docs/themes/brand/fonts/

# The touch marks all three crates' own sources newer than the stub build, so
# cargo compiles them again and leaves the dependencies as they are.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    touch idle/src/main.rs idle/src/lib.rs media-screen/src/lib.rs \
        docs/themes/brand/iced/src/*.rs \
    && cargo build --release --locked --no-default-features -p idle-screen

# A distribution base, unlike the operator's scratch, and for the reason the
# player image gives: the toolkit opens a wide dynamic closure at run time, the
# Wayland client libraries and the Vulkan loader with its driver, and the
# closure comes soundest from the distribution that built them.
#
# The digest pins the base to one exact image, so a rebuild starts from the same
# bytes after Ubuntu republishes the 26.04 tag. To move to a newer base, read
# the new digest with docker inspect and replace it here.
FROM ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b

# libwayland-client0 and libxkbcommon0 are the Wayland and keyboard libraries
# winit opens by name. libvulkan1 with mesa-vulkan-drivers is the renderer's
# path to the Intel graphics these machines have.
#
# The image installs no font package for the screen's own family. The
# binary carries the brand's two faces and loads them into the toolkit
# before the first frame.
#
# fonts-droid-fallback is one small file that draws Chinese, Japanese, and
# Korean, for the reason the player image installs it: the unit's name and its
# parts are text a household writes, Source Sans 3 carries none of those
# characters, and a face with no CJK draws a blank box for each one. tzdata
# carries the zoneinfo database, because Rust's standard library has no time
# zones and the clock reads the zone TZ names.
#
# The Snapshot line pins apt to the archive as it stood at one instant, so the
# versions below stay fetchable after Ubuntu publishes newer ones. To move the
# image forward, set a later serial and refresh the six versions from a build
# at that serial. snapshot.ubuntu.com serves over HTTPS, and the base carries no
# certificate store, so the build installs ca-certificates from the default
# archive first, then purges it after the pinned install so it leaves no trace
# in the runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && sed -i '/^Signed-By:/a Snapshot: 20260822T000000Z' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libwayland-client0=1.24.0-2 \
        libxkbcommon0=1.13.1-1 \
        libvulkan1=1.4.341.0-1 \
        mesa-vulkan-drivers=26.0.8-1ubuntu0.3 \
        fonts-droid-fallback=1:8.1.0r7-1~1.gbp36536bbuild1 \
        tzdata=2026c-0ubuntu0.26.04.1 \
    && apt-get purge -y ca-certificates \
    && apt-get autoremove -y --purge \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/target/release/idle-screen /idle-screen

# The binary runs here, in the image that ships it. --help opens no window
# and reaches no compositor, and the toolkit opens its Wayland and Vulkan
# libraries by name at run time, so what this proves is that the linked
# closure resolves and the process starts and exits 0, not that the
# graphics stack loads.
RUN /idle-screen --help > /dev/null

# The binary is the container's own process, so the kubelet sends it the
# signal and carries its exit code out as the pod's outcome. The operator
# names this image on an idle container and sets no command, so the entrypoint
# is the whole of how the client starts.
ENTRYPOINT ["/idle-screen"]
