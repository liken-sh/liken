# The api image runs `/media-operator-pod api`. /media-operator-pod is
# the program built with the `pod` tag, which the operator image also
# ships. The api cannot run in the operator image, because that image
# is scratch and the api starts ffmpeg to mux each capture.

FROM golang AS build
# proxy.golang.org sometimes drops a download partway through. With a
# comma, `go` falls back to the origin only on a 404 or 410, so a
# dropped download fails the build. With a pipe, it falls back after any
# proxy error. `GOSUMDB` keeps its default, so the checksum database
# still verifies a module fetched from its origin.
ENV GOPROXY="https://proxy.golang.org|direct"
WORKDIR /src
# Copying the module files first lets a source edit reuse the cached
# download layer.
COPY go.mod go.sum ./
# go.mod replaces the kubernetes module with ../kubernetes, so the
# build takes that directory as the build context `kubernetes` and
# copies it to /kubernetes, which is ../kubernetes relative to /src.
# Its module files come first for the same caching reason.
COPY --from=kubernetes go.mod go.sum /kubernetes/
RUN go mod download
COPY --from=kubernetes . /kubernetes/
COPY *.go ./
# The api embeds openapi.json.
COPY openapi.json ./
COPY edl/ ./edl/
# The binary is static even though this image has a libc, so that the
# same build runs in every image that ships /media-operator-pod.
RUN CGO_ENABLED=0 go build -trimpath -tags pod -ldflags "-s -w" -o /media-operator-pod .
# Collects the license files of the standard library and of each linked
# module (notices/go.sh).
COPY --from=notices go.sh /
RUN CGO_ENABLED=0 GOFLAGS=-tags=pod sh /go.sh /notices .

# The api runs ffmpeg with `-c copy`, which copies the video and audio
# streams into one file without decoding them, so the node needs no
# GPU. docker-bake.hcl supplies the ffmpeg image of the same commit as
# the build context `ffmpeg`.
FROM ffmpeg

COPY --from=build /media-operator-pod /media-operator-pod
COPY --from=build /notices /

ENTRYPOINT ["/media-operator-pod", "api"]
