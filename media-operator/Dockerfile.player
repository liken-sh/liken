# The player image: mpv, the libraries that decode on a real
# machine, and the same binary the operator image carries. In this
# image the binary runs as the player shim, and the operator also
# overrides the entrypoint to run it in the bridge and remote modes.
# The operator's image cannot serve this role, because it is one
# static binary on scratch and mpv needs a video and audio stack
# under it.

# The build stage repeats the operator image's, so both images carry
# the same binary from the same source at the same commit.
FROM golang:1.26.5-bookworm AS build
WORKDIR /src
# The module file comes first, so a source edit reuses the cached
# download layer.
COPY go.mod ./
RUN go mod download
COPY *.go ./
# CGO_ENABLED=0 with -trimpath is liken's own build discipline: a
# static binary with no paths from the build machine in it. Static
# even though this image has a libc, because the same artifact then
# serves both images.
RUN CGO_ENABLED=0 go build -trimpath -o /media-operator .

# A distribution base, unlike the operator's scratch. mpv opens a
# wide dynamic closure at run time, the GL and EGL stack, the VA-API
# driver, and the PipeWire client libraries, and the closure comes
# soundest from the distribution that built mpv against it.
#
# The digest pins the base to one exact image, so a rebuild starts from the
# same bytes after Ubuntu republishes the 26.04 tag. To move to a newer base,
# read the new digest with docker inspect and replace it here.
FROM ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b

# mpv plays. intel-media-va-driver decodes on the Intel iGPUs these
# machines have. libgl1-mesa-dri renders the gpu video output.
#
# pipewire-bin is not optional: libpipewire refuses to build a
# client context without /usr/share/pipewire/client.conf, that file
# ships in pipewire-bin, and --ao=pipewire fails without it.
#
# The display draws its text in Source Sans 3, so fonts-adobe-sourcesans3
# installs that family. fonts-noto-core covers the glyphs Source Sans 3 does
# not carry, such as a foreign title or a subtitle track name, so no glyph
# drops to a blank box.
#
# fonts-droid-fallback is one small file that draws Chinese, Japanese, and
# Korean, so a CJK title or subtitle track name renders instead of a blank box.
# The full Noto CJK family reads better but is far larger, and this face is
# enough to read.
#
# tzdata carries the zoneinfo database, so the display clock resolves the
# household's TZ to a wall-clock time instead of UTC.
#
# The Snapshot line pins apt to the archive as it stood at one instant, so the
# versions below stay fetchable after Ubuntu publishes newer ones. To move the
# image forward, set a later serial and refresh the eight versions from a build
# at that serial. snapshot.ubuntu.com serves over HTTPS, and the base carries
# no certificate store, so the build installs ca-certificates from the default
# archive first, then purges it after the pinned install so it leaves no trace
# in the runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && sed -i '/^Signed-By:/a Snapshot: 20260822T000000Z' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        mpv=0.41.0-2ubuntu4 \
        intel-media-va-driver=26.1.2+dfsg1-1 \
        libgl1-mesa-dri=26.0.8-1ubuntu0.3 \
        pipewire-bin=1.6.2-1ubuntu1.1 \
        fonts-adobe-sourcesans3=3.052+dfsg-2 \
        fonts-noto-core=20201225-2build1 \
        fonts-droid-fallback=1:8.1.0r7-1~1.gbp36536bbuild1 \
        tzdata=2026c-0ubuntu0.26.04.1 \
    && apt-get purge -y ca-certificates \
    && apt-get autoremove -y --purge \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /media-operator /media-operator

# mpv treats a directory that holds main.lua as one client and adds it to
# Lua's package path, so the display script directory copies whole.
COPY display/ /display/

# The entrypoint is the player shim, and mpv is the container's own
# process. The display operator writes DISPLAY_APP_ID into the
# environment at run time, after the pod spec is fixed, so the shim
# reads that one variable, appends it as --wayland-app-id, and execs
# mpv. Because it execs, no supervisor wraps mpv, and the kubelet
# drives mpv directly: the kubelet sends the signal, reaps the
# children, and carries mpv's exit code out as the pod's outcome.
ENTRYPOINT ["/media-operator", "player"]
