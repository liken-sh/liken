# The player image: the display operator's mpv image, the brand's fonts,
# the display script, and the same binary the operator image carries. In
# this image the binary runs as the player shim alone; every sidecar mode
# runs on the sidecar image. The operator's own image cannot serve here,
# because it is one static binary on scratch and mpv needs a video and
# audio stack under it.

# The runtime base of the last stage. An argument a FROM line reads has
# to be declared before the first stage, so it is here and not beside
# the stage that uses it. The tag pins one release of the display
# operator, and a workstation sets the argument to a base it built.
ARG MPV_BASE=ghcr.io/liken-sh/mpv:2026.09.11-002

# The build stage repeats the operator image's, so every image that
# carries the binary carries the same one, built from the same source.
FROM golang:1.27.0-bookworm AS build
WORKDIR /src
# The module files come first, so a source edit reuses the cached
# download layer.
COPY go.mod go.sum ./
RUN go mod download
COPY *.go ./
# The EDL package builds into the binary, so the source tree it needs is the
# root files and this one directory.
COPY edl/ ./edl/
# CGO_ENABLED=0 with -trimpath is liken's own build discipline: a
# static binary with no paths from the build machine in it. Static
# even though this image has a libc, because the same artifact then
# serves both images.
RUN CGO_ENABLED=0 go build -trimpath -o /media-operator .

# fonts-droid-fallback is one small file that draws Chinese, Japanese, and
# Korean, so a CJK title or subtitle track name renders instead of a blank box.
# Source Sans 3 carries none of those characters, and the full Noto CJK family
# reads better but is far larger, so this face is what the image installs.
# The runtime below has no package manager, so the file comes out of a
# Debian stage on the suite the base is built from.
FROM debian:trixie-slim AS fonts
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-droid-fallback \
    && rm -rf /var/lib/apt/lists/*

# The runtime is liken's mpv image: mpv, the PipeWire client modules and
# SPA plugins it opens by name, and the fontconfig configuration libass
# reads, on the ffmpeg, VA-API, and Vulkan trees under it, on scratch.
# The display operator builds it beside the compositor, so a node that
# runs both holds one libva and one Mesa. The base carries the zoneinfo
# database, so the display clock resolves the household's TZ to a
# wall-clock time. No font package is installed for the display's own
# family: the brand's two OTF files arrive below as files, and libass
# resolves the family display/theme.lua names through fontconfig.
FROM ${MPV_BASE}

COPY --from=fonts /usr/share/fonts/truetype/droid /usr/share/fonts/truetype/droid

COPY --from=build /media-operator /media-operator

# The brand's upright and italic faces, as files fontconfig finds when it
# scans /usr/share/fonts, so libass resolves the family the display names
# with no cache step and no font package.
COPY docs/themes/brand/fonts/SourceSans3-Regular.otf \
     docs/themes/brand/fonts/SourceSans3-It.otf \
     docs/themes/brand/fonts/LICENSE.md \
     /usr/share/fonts/opentype/source-sans-3/

# mpv treats a directory that holds main.lua as one client and adds it to
# Lua's package path, so the display script directory copies whole.
COPY display/ /display/

# The entrypoint is the player shim, and mpv is the container's own
# process. The shim builds mpv's arguments from what the operator set
# in the environment and execs mpv. Because it execs, no supervisor
# wraps mpv, and the kubelet
# drives mpv directly: the kubelet sends the signal, reaps the
# children, and carries mpv's exit code out as the pod's outcome.
ENTRYPOINT ["/media-operator", "player"]
