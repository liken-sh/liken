# The image of a playback pod: mpv and its video and audio libraries,
# with /media-operator-pod as the entrypoint in its player mode. The
# operator image cannot be the base, because it is scratch with static
# binaries and mpv needs its shared libraries.

FROM golang AS build
# With the default comma in GOPROXY, `go` downloads from the module's
# origin only when proxy.golang.org returns 404 or 410, so a download
# that the proxy drops partway fails the build. With a pipe, `go` falls
# back to the origin after any proxy error. GOSUMDB keeps its default,
# so the checksum database still verifies a module from the origin.
ENV GOPROXY="https://proxy.golang.org|direct"
WORKDIR /src
# The module files come first, so a source edit reuses the cached
# download layer.
COPY go.mod go.sum ./
# go.mod replaces the kubernetes module with ../kubernetes, so the
# `kubernetes` build context is copied to /kubernetes, which is
# ../kubernetes from /src.
COPY --from=kubernetes go.mod go.sum /kubernetes/
RUN go mod download
COPY --from=kubernetes . /kubernetes/
COPY *.go ./
# The api role embeds openapi.json at compile time.
COPY openapi.json ./
COPY edl/ ./edl/
# These are the flags that the operator image's Dockerfile uses for its
# own build of /media-operator-pod, so both images run the same program.
# The `pod` build tag leaves out client-go's leader election, which only
# the operator needs.
RUN CGO_ENABLED=0 go build -trimpath -tags pod -ldflags "-s -w" -o /media-operator-pod .
# License notices for the Go standard library and each linked module.
COPY --from=notices go.sh /
RUN CGO_ENABLED=0 GOFLAGS=-tags=pod sh /go.sh /notices .

# fonts-droid-fallback draws Chinese, Japanese, and Korean, which Source
# Sans 3 does not, so a title or a track name in those scripts does not
# render as empty boxes. The full Noto CJK family is much larger. The
# runtime image has no package manager, so this stage installs the
# package from the Debian snapshot that the base images use. The
# `builder` build context is the vulkan directory, which holds
# snapshot.sh. package.toml sets SNAPSHOT to the vulkan component's
# version, which is the date of that snapshot.
FROM debian AS fonts
ARG SNAPSHOT
COPY --from=builder snapshot.sh snapshot.sha256 /
RUN sh /snapshot.sh "$SNAPSHOT" \
    && apt-get install -y --no-install-recommends fonts-droid-fallback \
    && rm -rf /var/lib/apt/lists/*

# The mpv base image builds on the ffmpeg, vaapi, and vulkan images. The
# compositor's image also builds on vulkan, so a node that runs both
# stores one copy of Mesa.
FROM mpv

# The base images start from scratch and have no CA bundle. The player
# runs mpv with --tls-verify=yes, so without the trust component's
# bundle every https:// URL would fail.
COPY --from=trust / /

COPY --from=fonts /usr/share/fonts/truetype/droid /usr/share/fonts/truetype/droid
COPY --from=fonts /usr/share/doc/fonts-droid-fallback/copyright /usr/share/doc/fonts-droid-fallback/copyright

COPY --from=build /media-operator-pod /media-operator-pod
COPY --from=build /notices /

# The files that a pattern:// URI plays. `make patterns` writes them
# into patterns/ and they are committed, so the image build runs no
# encoder.
COPY patterns/*.mkv /usr/share/liken/patterns/

# fontconfig finds the brand's faces under /usr/share/fonts, so libass
# uses them with no font package and no font cache step.
COPY --from=brand fonts/SourceSans3-Regular.otf \
     fonts/SourceSans3-It.otf \
     fonts/LICENSE.md \
     /usr/share/fonts/opentype/source-sans-3/

# The player mode builds mpv's arguments from the environment that the
# operator sets and then execs mpv. So mpv is the container's main
# process: the kubelet's stop signal goes to mpv, and mpv's exit code is
# the container's.
ENTRYPOINT ["/media-operator-pod", "player"]
