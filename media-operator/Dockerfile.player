# The player image: mpv, the libraries that decode on a real
# machine, and the same binary the operator image carries. In this
# image the binary runs as the player shim, and the operator also
# overrides the entrypoint to run it in the bridge and remote modes.
# The operator's image cannot serve this role, because it is one
# static binary on scratch and mpv needs a video and audio stack
# under it.

# The build stage repeats the operator image's, so both images carry
# the same binary from the same source at the same commit.
FROM golang:1.26.5-bookworm AS build
WORKDIR /src
# The module file comes first, so a source edit reuses the cached
# download layer.
COPY go.mod ./
RUN go mod download
COPY *.go ./
# CGO_ENABLED=0 with -trimpath is liken's own build discipline: a
# static binary with no paths from the build machine in it. Static
# even though this image has a libc, because the same artifact then
# serves both images.
RUN CGO_ENABLED=0 go build -trimpath -o /media-operator .

# A distribution base, unlike the operator's scratch. mpv opens a
# wide dynamic closure at run time, the GL and EGL stack, the VA-API
# driver, and the PipeWire client libraries, and the closure comes
# soundest from the distribution that built mpv against it. The open
# problem "The player image is still Debian" holds the path out.
FROM debian:stable-slim

# mpv plays. intel-media-va-driver decodes on the Intel iGPUs these
# machines have. libgl1-mesa-dri renders the gpu video output.
#
# pipewire-bin is not optional: libpipewire refuses to build a
# client context without /usr/share/pipewire/client.conf, that file
# ships in pipewire-bin, and --ao=pipewire fails without it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        mpv \
        intel-media-va-driver \
        libgl1-mesa-dri \
        pipewire-bin \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /media-operator /media-operator

# The entrypoint is the player shim, and mpv is the container's own
# process. The display operator writes DISPLAY_APP_ID into the
# environment at run time, after the pod spec is fixed, so the shim
# reads that one variable, appends it as --wayland-app-id, and execs
# mpv. Because it execs, no supervisor wraps mpv, and the kubelet
# drives mpv directly: the kubelet sends the signal, reaps the
# children, and carries mpv's exit code out as the pod's outcome.
ENTRYPOINT ["/media-operator", "player"]
