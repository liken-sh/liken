# The player image: the mpv base image, the brand's fonts,
# and the pod build of the program, the same /media-operator-pod the
# operator image carries. In this image the binary runs as the player
# shim alone; every sidecar mode runs on the sidecar
# image. The operator's own image cannot serve here, because it is one
# static binary on scratch and mpv needs a video and audio stack under it.

# The build stage repeats the operator image's pod build, so every image
# that carries the pod build carries the same one, built from the same
# source.
FROM golang:1.27.1-bookworm AS build
# proxy.golang.org sometimes drops a module download partway through
# the stream. With the default comma, `go` tries the origin only when
# the proxy answers 404 or 410, so a dropped stream fails the build.
# With a pipe, `go` fetches the module from its origin after any proxy
# error, with the git that this image includes. `GOSUMDB` keeps its
# default, so the checksum database still verifies a module that `go`
# fetched from its origin.
ENV GOPROXY="https://proxy.golang.org|direct"
WORKDIR /src
# The module files come first, so a source edit reuses the cached
# download layer.
COPY go.mod go.sum ./
# go.mod replaces the shared kubernetes module with ../kubernetes, and
# the build takes that directory as a second build context named
# kubernetes. It lands at /kubernetes, the same place relative to /src
# that kubernetes/ has relative to this component. Its module file
# comes first for the same reason as this module's.
COPY --from=kubernetes go.mod go.sum /kubernetes/
RUN go mod download
COPY --from=kubernetes . /kubernetes/
COPY *.go ./
# The api role embeds the OpenAPI document at build time, so the
# committed copy has to be in the tree the compiler sees.
COPY openapi.json ./
# The EDL package builds into the binary, so the source tree it needs is the
# root files and this one directory.
COPY edl/ ./edl/
# CGO_ENABLED=0 with -trimpath is liken's own build discipline: a
# static binary with no paths from the build machine in it. Static
# even though this image has a libc, because the same build then
# serves both images. The build tag pod leaves out client-go's leader
# election, which only the operator needs.
RUN CGO_ENABLED=0 go build -trimpath -tags pod -o /media-operator-pod .

# fonts-droid-fallback is one small file that draws Chinese, Japanese, and
# Korean, so a CJK title or subtitle track name renders instead of a blank box.
# Source Sans 3 carries none of those characters, and the full Noto CJK family
# reads better but is far larger, so this face is what the image installs.
# The runtime below has no package manager, so the file comes out of a
# Debian stage on the suite the base is built from.
FROM debian:trixie-slim AS fonts
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-droid-fallback \
    && rm -rf /var/lib/apt/lists/*

# The runtime is liken's mpv image: mpv, the PipeWire client modules and
# SPA plugins it opens by name, and the fontconfig configuration libass
# reads, on the ffmpeg, VA-API, and Vulkan trees under it, on scratch.
# The compositor's image builds on the same Vulkan tree, so a node that
# runs both holds one Mesa. The bake file at the top of the repository
# gives this build the mpv image of the same commit as the named
# context mpv. No font package is installed for the brand's own family:
# its two OTF files arrive below as files, and libass resolves the
# family through fontconfig.
FROM mpv

COPY --from=fonts /usr/share/fonts/truetype/droid /usr/share/fonts/truetype/droid

COPY --from=build /media-operator-pod /media-operator-pod

# The test patterns that a pattern:// URI plays. The files are committed
# in patterns/, and the Makefile's patterns target makes them, so the
# build runs no encoder and the image carries none.
COPY patterns/*.mkv /usr/share/liken/patterns/

# The brand's upright and italic faces, as files fontconfig finds when it
# scans /usr/share/fonts, so libass resolves the family with no cache step
# and no font package. They come from the build context named brand, which
# the build sets to brand/ in the repository.
COPY --from=brand fonts/SourceSans3-Regular.otf \
     fonts/SourceSans3-It.otf \
     fonts/LICENSE.md \
     /usr/share/fonts/opentype/source-sans-3/

# The entrypoint is the player shim, and mpv is the container's own
# process. The shim builds mpv's arguments from what the operator set
# in the environment and execs mpv. Because it execs, no supervisor
# wraps mpv, and the kubelet
# drives mpv directly: the kubelet sends the signal, reaps the
# children, and carries mpv's exit code out as the pod's outcome.
ENTRYPOINT ["/media-operator-pod", "player"]
