# The image of the kubectl-liken-media plugin, which the base
# kubectl-liken command pulls at the operator's version.

# The build stage runs on the builder's architecture and cross-compiles,
# so the build needs no emulation.
FROM --platform=$BUILDPLATFORM golang AS build
# With the default comma in GOPROXY, `go` downloads from the module's
# origin only when proxy.golang.org returns 404 or 410, so a download
# that the proxy drops partway fails the build. With a pipe, `go` falls
# back to the origin after any proxy error. GOSUMDB keeps its default,
# so the checksum database still verifies a module from the origin.
ENV GOPROXY="https://proxy.golang.org|direct"
WORKDIR /src
# The module files come first, so a source edit reuses the cached
# download layer.
COPY go.mod go.sum ./
# go.mod replaces the kubernetes module with ../kubernetes, so
# `go mod download` reads its go.mod. The CLI imports no package of that
# module, so its source is not copied.
COPY --from=kubernetes go.mod /kubernetes/
RUN go mod download
# The CLI imports nothing from the operator's package, so only cli/ is
# copied.
COPY cli/ ./cli/
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
    -o /kubectl-liken-media ./cli
# License notices for the Go standard library and each linked module.
COPY --from=notices go.sh /
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} sh /go.sh /notices ./cli

FROM distroless
# The trust component's CA bundle replaces distroless's Debian bundle.
COPY --from=trust / /
COPY --from=build /kubectl-liken-media /kubectl-liken-media
COPY --from=build /notices /
ENTRYPOINT ["/kubectl-liken-media"]
