#!/usr/bin/env python3
"""Run two transect binaries against one cluster and diff their pages.

Each binary serves on its own port with the same flags.  Once both
answer, every path is read from both at the same moment, reduced to its
visible text the way the text goldens are (tags stripped, a block to a
line), with every number masked, since ages, rates, usage, and counts
move between two reads.  The script prints a diff per page that differs
and exits 1 if any does.

    scripts/side-by-side --old ./transect-before --new ./transect-after \\
        --path / --path /machines/a-machine --from-map -- \\
        --kubeconfig ~/.kube/config --prometheus http://localhost:9090

Every argument after `--` goes to both binaries, which must not name
`--listen`; `--old-arg` and `--new-arg` give one binary a flag of its
own, such as a resources directory from before a change, written as
`--old-arg=--resources=old/`.  `--from-map` adds each machine and namespace the old
binary's map links to.  Each start lists the whole cluster, so run it
when a comparison needs the live cluster, not on every change.
"""

import argparse
import concurrent.futures
import difflib
import html.parser
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

# The tags that run inside a line, as the goldens read them.
INLINE = {
    "a", "abbr", "b", "code", "em", "i", "kbd", "label", "mark", "s",
    "small", "span", "strong", "sub", "sup", "time", "u", "wbr",
}
HIDDEN = {"script", "style", "template"}
NUMBER = re.compile(r"\d+(?:[.,]\d+)*")


class Text(html.parser.HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.lines, self.line, self.hidden = [], [], 0

    def boundary(self, tag):
        if tag in INLINE:
            self.line.append(" ")
        else:
            self.lines.append("".join(self.line))
            self.line = []

    def handle_starttag(self, tag, attrs):
        if tag in HIDDEN:
            self.hidden += 1
        self.boundary(tag)

    def handle_endtag(self, tag):
        if tag in HIDDEN and self.hidden:
            self.hidden -= 1
        self.boundary(tag)

    def handle_data(self, data):
        if not self.hidden:
            self.line.append(data)

    def text(self):
        self.lines.append("".join(self.line))
        lines = (" ".join(line.split()) for line in self.lines)
        return [NUMBER.sub("#", line) for line in lines if line]


def visible(page):
    parser = Text()
    parser.feed(page)
    parser.close()
    return parser.text()


def read(port, path, timeout=30):
    url = f"http://127.0.0.1:{port}{path}"
    try:
        with urllib.request.urlopen(url, timeout=timeout) as answer:
            return answer.status, answer.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as error:
        return error.code, error.read().decode("utf-8", "replace")


def start(binary, port, flags, log):
    command = [binary, *flags, "--listen", f"127.0.0.1:{port}"]
    return subprocess.Popen(
        command, stdout=log, stderr=subprocess.STDOUT, start_new_session=True
    )


def wait_for(process, port, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if process.poll() is not None:
            sys.exit(f"the server on :{port} exited with {process.returncode}")
        try:
            if read(port, "/", timeout=5)[0] == 200:
                return
        except OSError:
            pass
        time.sleep(1)
    sys.exit(f"the server on :{port} did not answer in {timeout}s")


def from_map(port):
    _, page = read(port, "/")
    links = re.findall(r'href="(/(?:machines|namespaces)/[^/"?#]+)"', page)
    return sorted(set(links))


def main():
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--old", required=True, help="the binary before the change")
    parser.add_argument("--new", required=True, help="the binary after the change")
    parser.add_argument("--old-port", type=int, default=8081)
    parser.add_argument("--new-port", type=int, default=8082)
    parser.add_argument("--path", action="append", default=[], help="a page to compare")
    parser.add_argument("--old-arg", action="append", default=[], help="a flag only the old binary gets")
    parser.add_argument("--new-arg", action="append", default=[], help="a flag only the new binary gets")
    parser.add_argument("--from-map", action="store_true", help="add the map's machines and namespaces")
    parser.add_argument("--wait", type=int, default=120, help="seconds a start may take")
    parser.add_argument(
        "--settle",
        type=int,
        default=90,
        help="seconds to wait once both answer, for each poller's and search's first round",
    )
    parser.add_argument("--logs", help="where each server's log goes; a new temporary directory without it")
    parser.add_argument("flags", nargs=argparse.REMAINDER, help="-- and the flags both get")
    args = parser.parse_args()
    flags = args.flags[1:] if args.flags[:1] == ["--"] else args.flags

    logs = args.logs or tempfile.mkdtemp(prefix="side-by-side-")
    print(f"logs in {logs}")
    servers = []
    try:
        runs = (
            ("old", args.old, args.old_port, args.old_arg),
            ("new", args.new, args.new_port, args.new_arg),
        )
        for name, binary, port, own in runs:
            log = open(os.path.join(logs, f"side-by-side-{name}.log"), "w")
            servers.append((start(binary, port, flags + own, log), port))
        for process, port in servers:
            wait_for(process, port, args.wait)
        time.sleep(args.settle)
        paths = list(dict.fromkeys((args.path or ["/"]) + (from_map(args.old_port) if args.from_map else [])))
        differ = 0
        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
            # A page draws from the last model built, and its read starts
            # the build of a newer one, so a page read once after a quiet
            # spell can be minutes old.  Each page is read once to start
            # those builds, and compared on the second read.
            for path in paths:
                list(pool.map(lambda port: read(port, path), (args.old_port, args.new_port)))
            time.sleep(10)
            for path in paths:
                old, new = pool.map(lambda port: read(port, path), (args.old_port, args.new_port))
                old_text = [f"status {old[0]}", *visible(old[1])]
                new_text = [f"status {new[0]}", *visible(new[1])]
                diff = list(difflib.unified_diff(old_text, new_text, f"old {path}", f"new {path}", lineterm=""))
                if diff:
                    differ += 1
                    print("\n".join(diff))
                else:
                    print(f"same: {path}")
        print(f"{len(paths)} pages, {differ} differ")
        return 1 if differ else 0
    finally:
        for process, _ in servers:
            if process.poll() is None:
                os.killpg(process.pid, signal.SIGTERM)
                try:
                    process.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, signal.SIGKILL)


if __name__ == "__main__":
    sys.exit(main())
