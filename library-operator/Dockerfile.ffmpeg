# The image the two file facts run on: the same operator binary as Dockerfile's,
# on liken's ffmpeg base, which carries Debian's ffmpeg and ffprobe and the
# VA-API drivers on scratch. The probe container of the enricher Job and the
# container of the trickplay Job take this image, and every other container
# takes the operator's own.

# The runtime base of the last stage. An argument a FROM line reads has to be
# declared before the first stage, so it is here and not beside the stage that
# uses it. The display operator builds the base, so a node that runs both holds
# one copy of the drivers.
ARG FFMPEG_BASE=ghcr.io/liken-sh/ffmpeg:2026.09.11-001

FROM golang:1.27.0-bookworm AS build
WORKDIR /src
# The module files come first, so a source edit reuses the cached
# download layer.
COPY go.mod go.sum ./
RUN go mod download
COPY *.go ./
# CGO_ENABLED=0 with -trimpath is liken's own build discipline: a
# static binary with no paths from the build machine in it. It runs
# from scratch, where there is no loader to need.
RUN CGO_ENABLED=0 go build -trimpath -o /library-operator .

FROM ${FFMPEG_BASE}
COPY --from=build /library-operator /library-operator
# A scratch image carries no trust store, and every TLS call fails without
# one. The bundle is the build stage's own Debian set.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# A scratch image carries no PATH, and the two file facts find their tools by
# name.
ENV PATH=/usr/bin
# The entrypoint is the operator binary, not the base's ffmpeg, because the
# container runs a fact and the fact runs the tool.
ENTRYPOINT ["/library-operator"]
