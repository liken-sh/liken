# The image the two file facts run on: the same pod build of the program as
# Dockerfile's, on liken's ffmpeg base, which carries Debian's ffmpeg and
# ffprobe and the VA-API drivers on scratch. The probe container of the enricher Job and the
# container of the trickplay Job take this image, and every other container
# takes the operator's own.

FROM golang:1.27.1-bookworm AS build
WORKDIR /src
# The module files come first, so a source edit reuses the cached
# download layer.
COPY go.mod go.sum ./
# go.mod replaces the shared kubernetes module with ../kubernetes, and
# the build takes that directory as a second build context named
# kubernetes. It lands at /kubernetes, the same place relative to /src
# that kubernetes/ has relative to this component. Its module file
# comes first for the same reason as this module's.
COPY --from=kubernetes go.mod go.sum /kubernetes/
RUN go mod download
COPY --from=kubernetes . /kubernetes/
COPY *.go ./
# CGO_ENABLED=0 with -trimpath is liken's own build discipline: a
# static binary with no paths from the build machine in it. It runs
# from scratch, where there is no loader to need. The tag pod builds the
# program without the operator, which no container of this image runs.
RUN CGO_ENABLED=0 go build -trimpath -tags pod -o /library-operator-pod .

# The bake file at the top of the repository gives this build the ffmpeg
# image of the same commit as the named context ffmpeg. display-operator's
# capture container builds on the same image, so a node that runs both holds
# one copy of the drivers.
FROM ffmpeg
COPY --from=build /library-operator-pod /library-operator-pod
# A scratch image carries no trust store, and every TLS call fails without
# one. The bundle is the build stage's own Debian set.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
# A scratch image carries no PATH, and the two file facts find their tools by
# name.
ENV PATH=/usr/bin
# The entrypoint is the program, not the base's ffmpeg, because the container
# runs a fact and the fact runs the tool.
ENTRYPOINT ["/library-operator-pod"]
