        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (rate(library_reconcile_duration_seconds_count[5m]))",
          "refId": "A",
          "legendFormat": "{{kind}}"
        }
      ]
    },
