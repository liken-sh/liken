        },
        "query": {
          "query": "label_values(liken_build_info{component=\"media-browser\"}, pod)",
          "refId": "pod"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
