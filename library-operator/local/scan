#!/usr/bin/env bash
# Local/scan runs one scan Job against a directory of media on this
# workstation, into the local Corrosion cluster local/catalog starts, so a
# parser change shows in the catalog without a cluster. The Job exits when
# the harness reporter publishes its run back, the same wait a Job makes in
# the cluster.
#
# Usage:
#   local/scan <media-directory> [kind]   walk the directory into the catalog;
#                                         kind is movies (the default) or series
#   local/scan <art-directory> franchises <git-url> [ref]
#                                         clone the repository into the catalog
#                                         as a franchises library, downloading
#                                         its art into the directory; ref is main
set -euo pipefail

# The repository is the directory above this file, so every path resolves
# from this script's own directory and none is absolute.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$here/.." && pwd)"

# The scanner runs from the image the root Dockerfile builds, not from a
# go build on the workstation, so it runs the same bytes here and in the
# cluster.
image="library-operator:local"

# The scanner posts to one local agent's HTTP API, the first the
# local/catalog harness answers on. The other two replicate the writes,
# so a read against any of them shows the walk.
catalog_api="http://127.0.0.1:20081"

# The broker the harness reporter publishes over. The Job hears its own
# run come back on it.
bus_address="127.0.0.1:20883"

# The cap on the run. The walk and the echo end the run, so this number
# bounds only a Job that never reaches its last line.
run_seconds="${RUN_SECONDS:-600}"

# The mount point inside the container, the path the pod mounts the claim
# at. The root is the whole mount, so the scanner reads the workstation
# directory the way it reads a claim. A movies or series run mounts the
# directory read-only. A franchises run mounts it writable, because the
# scan downloads the art each franchise.yaml links to into it.
container_mount="/library"

# Where a franchises run clones the repository, the path the pod mounts
# the emptyDir at. It is a tmpfs here, because the checkout lives for the
# length of the run and nothing keeps it.
container_checkout="/checkout"

usage() {
  sed -n '8,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

media="${1:-}"
kind="${2:-movies}"
[ -n "$media" ] || usage

# A franchises library names both a directory and a repository: the
# directory is the claim the art lands in, and the repository holds the
# story orders. The checkout is a tmpfs, the way the Job's emptyDir is in
# the cluster, so nothing keeps it. The directory is mounted writable for
# this kind, because the scan downloads the art into it.
git_url=""
git_ref=""
if [ ! -d "$media" ]; then
  echo "local/scan: $media is not a directory" >&2
  exit 1
fi
media="$(cd "$media" && pwd)"
if [ "$kind" = franchises ]; then
  git_url="${3:-}"
  git_ref="${4:-main}"
  [ -n "$git_url" ] || usage
  source_volume=(--volume "$media:$container_mount" --tmpfs "$container_checkout")
else
  source_volume=(--volume "$media:$container_mount:ro")
fi

# The local cluster must be up, because the scanner writes through an
# agent's API and reports nothing a read can find without one.
if ! curl --silent --fail --max-time 2 \
  --header 'content-type: application/json' \
  --data '"SELECT 1"' "$catalog_api/v1/queries" >/dev/null 2>&1; then
  echo "local/scan: no catalog agent answers on $catalog_api; run 'local/catalog up' first" >&2
  exit 1
fi

# The Job waits for the reporter's message before it exits, so the
# broker has to be up as well as the agents.
if ! (exec 3<>"/dev/tcp/${bus_address%:*}/${bus_address##*:}") 2>/dev/null; then
  echo "local/scan: no broker answers on $bus_address; run 'local/catalog up' first" >&2
  exit 1
fi

# A missing image is built here rather than reported, and the build is
# the same one CI runs.
if [ -z "$(docker images --quiet "$image")" ]; then
  echo "local/scan: building $image" >&2
  docker build "$repo" --tag "$image" >&2
fi

# `--network host` puts the Job on loopback, where the catalog API
# port and the broker port are the addresses it uses. --user runs it as the
# person at the keyboard, so it reads a media directory they own.
#
# The Job runs detached, because this script reads its log while it runs.
echo "local/scan: walking $media as a $kind library into $catalog_api" >&2
container="library-operator-scan-$$"
docker run --detach --name "$container" \
  --network host \
  --user "$(id -u):$(id -g)" \
  "${source_volume[@]}" \
  --env LIBRARY_NAMESPACE=local \
  --env LIBRARY_GIT_URL="$git_url" \
  --env LIBRARY_GIT_REF="$git_ref" \
  --env LIBRARY_NAME="$kind" \
  --env LIBRARY_KIND="$kind" \
  --env LIBRARY_ROOT=/ \
  --env LIBRARY_CATALOG_API="$catalog_api" \
  --env LIBRARY_BUS_ADDRESS="$bus_address" \
  --env LIBRARY_TOPIC_BASE= \
  --env JOB_NAME="$container" \
  --env ECHO_TIMEOUT=2m \
  "$image" scan >/dev/null

# The Job exits on its own, and every way out of this script removes
# what is left of its container.
cleanup() {
  docker rm --force "$container" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# The Job logs one line for the end of its walk, and that line
# reports the prune as well. The log runs to the end of the container,
# because the Job holds the container open until it hears its own run.
walk="capped"
while IFS= read -r line; do
  printf '%s\n' "$line" >&2
  case "$line" in
    *"walk complete:"*)
      walk="complete"
      case "$line" in
        *"prune deferred"*) walk="unpruned" ;;
      esac
      ;;
    *"incomplete walk:"*)
      walk="incomplete"
      ;;
  esac
done < <(timeout --signal=TERM "$run_seconds" docker logs --follow "$container" 2>&1)

# A container still running at the cap is a Job that did not finish,
# and one that left carries the exit code the Job ended with: zero once the
# reporter has echoed its run, and non-zero on a failed walk or an echo
# that never came.
job=1
if [ -n "$(docker ps --quiet --filter "name=^${container}\$")" ]; then
  echo "local/scan: the job did not finish within the RUN_SECONDS cap of ${run_seconds}s" >&2
else
  job="$(docker inspect --format '{{.State.ExitCode}}' "$container" 2>/dev/null || echo 1)"
  if [ "$walk" = "capped" ]; then
    walk="ended"
  fi
fi

# A walk prunes only when it read the whole directory, so a run that
# did not finish leaves the rows of every file that left the directory.
case "$walk" in
  complete) ;;
  unpruned)
    echo "local/scan: the walk finished and its prune did not run; rows for files that left $media are still in the catalog" >&2
    ;;
  incomplete)
    echo "local/scan: the walk did not read all of $media, so it pruned nothing; rows for files that left $media are still in the catalog" >&2
    ;;
  ended)
    echo "local/scan: the job ended before it finished a walk; the catalog holds what it wrote up to that point" >&2
    ;;
  capped)
    echo "local/scan: the walk did not finish within the RUN_SECONDS cap of ${run_seconds}s, so it pruned nothing; rows for files that left $media are still in the catalog, and a longer RUN_SECONDS finishes the walk" >&2
    ;;
esac

# The row count the walk left, read straight off the agent, so a person
# sees the walk landed without opening the database.
count="$(curl --silent --fail --max-time 5 \
  --header 'content-type: application/json' \
  --data "\"SELECT count(*) FROM $kind\"" \
  "$catalog_api/v1/queries" 2>/dev/null | grep -o '\[[0-9]*\]' | head -1 || true)"
echo "local/scan: the $kind table holds ${count:-an unknown number of} rows" >&2

# The script ends with what the Job ended with, so a failed walk or
# an echo that never came fails the run here too.
exit "$job"
