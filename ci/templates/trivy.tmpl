{% define "trivy-setup" %}
      # The step installs Trivy from its release archive, and checks the
      # archive against trivySHA256 in ci/trivy.go before it unpacks the
      # binary, so a release that changed after the bump fails here.
      - {% if . %}if: {% . %}
        {% end %}continue-on-error: true
        env:
          TRIVY_VERSION: {% trivyVersion %}
          TRIVY_SHA256: {% trivySHA256 %}
        run: |
          archive="trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz"
          curl -fsSL --retry 5 --retry-all-errors --retry-delay 5 -o "$RUNNER_TEMP/$archive" \
            "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/$archive"
          echo "$TRIVY_SHA256  $RUNNER_TEMP/$archive" | sha256sum --check --strict -
          mkdir -p "$RUNNER_TEMP/trivy-bin"
          tar -xzf "$RUNNER_TEMP/$archive" -C "$RUNNER_TEMP/trivy-bin" trivy
          echo "$RUNNER_TEMP/trivy-bin" >> "$GITHUB_PATH"{% end %}
{% define "trivy-upload" %}
      - if: ${{ !cancelled(){% if .Dry %} && !inputs.dryrun{% end %} && hashFiles('{% .Present %}') != '' }}
        continue-on-error: true
        uses: {% action "github/codeql-action/upload-sarif" %}
        with:
          sarif_file: trivy/{% .Image %}.sarif
          category: trivy/{% .Image %}{% end %}
{% define "trivy-db-restore" %}
      - id: trivy-day{% if . %}
        if: {% . %}{% end %}
        run: echo "day=$(date -u +%Y-%m-%d)" >> "$GITHUB_OUTPUT"

      - {% if . %}if: {% . %}
        {% end %}continue-on-error: true
        uses: {% action "actions/cache/restore" %}
        with:
          path: ~/.cache/trivy/db
          key: trivy-db-${{ steps.trivy-day.outputs.day }}
          restore-keys: trivy-db-{% end %}
{% define "trivy-db" %}
  # Each scan needs Trivy's vulnerability database, about 140 MB to
  # download and 1.7 GB on disk. Trivy builds it every 6 hours, and the
  # database's metadata says it is current for 24 hours. A run can scan
  # dozens of images, in the trivy job's matrix and in each publish job,
  # and a download in each of them would meet the registry's rate limit.
  # So this job downloads the database once a day, and saves it to the
  # Actions cache under trivy-db-<day>. The trivy job and each publish
  # job that scans wait for this job, and restore the newest entry.
  #
  # Trivy reads the metadata of the restored database, and it downloads
  # nothing while the database is current. When a restore fails, or
  # restores a database that is no longer current, Trivy downloads its
  # own, so a scan never depends on this job. Every step continues on
  # an error, and the job never fails the run.
  #
  # The repository's Actions cache holds 10 GB, and each entry of the
  # database takes about 140 MB of it. A save deletes every older entry,
  # so the cache holds one at a time. The plan runs this job only when
  # the run scans an image: ScansImages in ci/rescan.go gives the rule.
  trivy-db:
    needs: plan
    if: ${{ needs.plan.outputs.trivy-db == 'true' }}
    runs-on: ubuntu-26.04
    timeout-minutes: 10
    # actions: write deletes the older entries of the cache.
    permissions:
      contents: read
      actions: write
    steps:
      - id: day
        run: echo "day=$(date -u +%Y-%m-%d)" >> "$GITHUB_OUTPUT"

      # The lookup reads only whether today's entry exists, and
      # downloads nothing.
      - id: lookup
        continue-on-error: true
        uses: {% action "actions/cache/restore" %}
        with:
          path: ~/.cache/trivy/db
          key: trivy-db-${{ steps.day.outputs.day }}
          lookup-only: true

      # Trivy installs only when today's entry is missing.{% template "trivy-setup" "${{ steps.lookup.outputs.cache-hit != 'true' }}" %}

      # Trivy writes the database under ~/.cache/trivy, the directory
      # that every scan reads by default.
      - id: download
        if: ${{ steps.lookup.outputs.cache-hit != 'true' }}
        continue-on-error: true
        run: trivy image --download-db-only --cache-dir ~/.cache/trivy

      - if: ${{ steps.download.outcome == 'success' }}
        continue-on-error: true
        uses: {% action "actions/cache/save" %}
        with:
          path: ~/.cache/trivy/db
          key: trivy-db-${{ steps.day.outputs.day }}

      - if: ${{ steps.download.outcome == 'success' }}
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
          KEEP: trivy-db-${{ steps.day.outputs.day }}
        run: |
          gh cache list --repo "$GITHUB_REPOSITORY" --key trivy-db- --limit 100 --json key --jq '.[].key' |
            sort -u | { grep -vx "$KEEP" || true; } | while read -r key; do
              gh cache delete "$key" --repo "$GITHUB_REPOSITORY"
            done
{% end %}
{% define "trivy-rescan" %}
  # Trivy scans each published image again when the Trivy configuration
  # changes. The configuration is two files: ci/trivy.go, which holds
  # the Trivy version and the arguments of a scan, and
  # ci/templates/trivy.tmpl, which holds this job, the trivy-db job,
  # and the steps that install Trivy, restore its database, and upload
  # each scan. A publish scans only the images that it pushes, so
  # without this job a new version or a new argument would reach an
  # image only at its next publish, and the Security tab would show the
  # results of the old configuration until then. This job pushes
  # nothing, so a change to the scanner gives no component a new
  # version, and no cluster that follows the development builds
  # restarts a pod for it.
  #
  # The plan names each image and the version to scan: the newest
  # release or development build of a tracked component on ghcr.io, and
  # the published tag of a pinned component. It leaves out each
  # component that publishes in this run, because that component's
  # publish job scans the images it pushes. Only a push to main scans
  # again, when one of the two files changed since the newest main run
  # that passed, or when every job runs. Planner.Rescan in ci/rescan.go
  # gives the rule.
  #
  # A scan reports and never fails the run, so the job continues on an
  # error, and the run's result does not depend on it.
  trivy:
    name: trivy ${{ matrix.image }}
    needs: [plan, trivy-db]
    if: ${{ !cancelled() && fromJSON(needs.plan.outputs.trivy)[0] != null }}
    runs-on: ubuntu-26.04
    timeout-minutes: 20
    continue-on-error: true
    permissions:
      contents: read
      packages: read
      security-events: write
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.plan.outputs.trivy) }}
    steps:
      - uses: {% action "actions/checkout" %}
{% template "go-restore" . %}

      # The scan reads the image from ghcr.io. The login lets it read a
      # package that is not public, and a login that fails leaves the
      # scan to read the image without one.
      - continue-on-error: true
        uses: {% action "docker/login-action" %}
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ github.token }}

      # The database that the trivy-db job saved.{% template "trivy-db-restore" "" %}

      # A scan reports and does not gate. An install that fails here
      # makes the scan fail, and the scan prints a warning and the job
      # goes on.{% template "trivy-setup" "" %}

      - name: scan
        working-directory: ci
        env:
          IMAGE: ${{ matrix.image }}
          VERSION: ${{ matrix.version }}
        run: go run . scan -root .. -image "$IMAGE" -version "$VERSION" -sarif "${{ github.workspace }}/trivy"

      # The upload goes under the category that the image's publish
      # uploads under, so it replaces the results of the image's last
      # scan. The step runs when the scan wrote its file.{% template "trivy-upload" (trivyUpload "${{ matrix.image }}" "trivy/*.sarif" false) %}
{% end %}
