# This file is generated from {% .Dir %}/package.toml. Do not edit it:
# edit that file or the templates in ci/templates/, then run
# `make workflows` at the top of the repository.
#
# ci.yaml calls this workflow when a change reaches {% .Name %}. Each
# check below is a job from package.toml, and it runs the same command
# that a workstation runs.{% if .Images %} The images job builds each image and runs
# its smoke check.{% end %}
#
# The plan names the jobs{% if .Images %} and the images{% end %} that read the change, and
# only those run, in a run that publishes too.{% if .Images %} A run that publishes also
# runs each image that reads the VERSION build argument, because the
# publish gives it a new version.{% end %}{% if .Publishes %} ci.yaml calls this workflow a
# second time for the publish job, after every check that ran here and
# in this component's closure passed.{% end %}
#
# The name carries the component- prefix because the ci component would
# otherwise share the name ci with the root workflow, and a lookup by
# name could not tell the two apart.
name: component-{% .Name %}

on:
  workflow_call:
    inputs:
      # check runs the jobs{% if .Images %} and the images{% end %} that the plan names. publish
      # runs the publish job alone: ci.yaml calls this workflow a second
      # time for it, after the checks of every component in this one's
      # closure pass.
      stage:
        type: string
        required: true
      # true when the check stage also runs the publish job in its dry
      # mode, because the code of the publish changed: it builds what a
      # publish would push, and it pushes nothing.
      dryrun:
        type: boolean
        required: true
      # The version the outputs get: the release tag, a development
      # version, a pinned component's own tag, or empty when the run
      # publishes nothing.
      version:
        type: string
        required: true
      # none, dev, or release.
      publish:
        type: string
        required: true
      # The names of the jobs that run, as a JSON list.
      jobs:
        type: string
        required: true{% if .Images %}
      # The images that run, as a JSON list of the images job's matrix
      # entries.
      images:
        type: string
        required: true
      # The override file that `ci bases` wrote in the plan job. It
      # points each build at the published image of every pinned base
      # that passed its checks, and every other base builds from the
      # tree. ci/bases.go gives the checks.
      bases:
        type: string
        required: true{% end %}

permissions:
  contents: read
  packages: write

# proxy.golang.org sometimes drops a module download partway through
# the stream. With the default comma, `go` tries the origin only when
# the proxy answers 404 or 410, so a dropped stream fails the job.
# With a pipe, `go` fetches the module from its origin after any proxy
# error, with the runner's git. `GOSUMDB` keeps its default, so the
# checksum database still verifies a module that `go` fetched from its
# origin. The value covers the Go of every job here, and of the
# build-setup action, which takes the env of the job that uses it.
# The images set the same value in their own build stages.
env:
  GOPROXY: https://proxy.golang.org|direct

jobs:{% range .Jobs %}
  {% .Name %}:{% if eq .Toolchain "codeql" %}
    # ci/codeql.go derives this job. A pull request from a fork gets a
    # token that cannot write to code scanning, so the analysis runs
    # only for a branch of this repository.
    if: ${{ inputs.stage == 'check' && contains(fromJSON(inputs.jobs), '{% .Name %}') && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) }}{% else %}
    if: ${{ inputs.stage == 'check' && contains(fromJSON(inputs.jobs), '{% .Select %}') }}{% end %}{% if .Needs %}
    # The job merges the coverage files of its shards and checks them,
    # so it waits for every shard.
    needs: {% .Needs %}{% end %}
    runs-on: ubuntu-26.04{% if .Matrix %}
    # The shards of the job {% .Select %}. Each runs the tests of its share
    # on a runner of its own, and a failed shard leaves the others to
    # finish, so one run reports every failing test.
    strategy:
      fail-fast: false
      matrix:
        shard: [{% range $i, $s := .Matrix %}{% if $i %}, {% end %}{% $s %}{% end %}]{% end %}
    timeout-minutes: {% .Timeout %}{% if eq .Toolchain "codeql" %}
    permissions:
      contents: read
      security-events: write{% end %}
    defaults:
      run:
        working-directory: {% .WorkDir %}{% if .Env %}
    env:{% range $key, $value := .Env %}
      {% $key %}: {% $value %}{% end %}{% end %}
    steps:{% if eq .Toolchain "os" %}
      # The build names itself with git describe, which needs the
      # history and the tags.
      - uses: {% action "actions/checkout" %}
        with:
          fetch-depth: 0

      # The toolchain, KVM access, and the caches of the vendored
      # inputs.
      - id: build-setup
        uses: ./.github/actions/build-setup{% else %}
      - uses: {% action "actions/checkout" %}{% end %}{% if .Go %}
{% template "go-restore" .Cache %}{% end %}{% if eq .Toolchain "hugo" %}

      # The entry holds the compiled Hugo and the brand's page
      # generators. go.sum chooses the version of each, so the key
      # holds the hash of go.sum and no commit, and main saves an entry
      # only when go.sum changes. A run restores the entry for its
      # go.sum, or the newest entry for any go.sum when none matches,
      # as on a branch that changes it. Every manual with the same
      # go.sum shares the entry.
      - id: hugo-cache
        uses: {% action "actions/cache/restore" %}
        with:
          path: ~/.cache/go-build
          key: hugo-build-${{ runner.os }}-${{ hashFiles('{% .ModuleDir %}/go.sum') }}
          restore-keys: hugo-build-${{ runner.os }}-{% end %}{% if .Apt %}

      - name: install {% join .Apt ", " %}
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends {% join .Apt " " %}{% end %}{% if eq .Toolchain "rust" %}

      # rustup reads the toolchain pin from rust-toolchain.toml.
      - name: install the toolchain
        run: rustup show

      # The key holds the component, so a workspace never restores
      # another component's target directory. Only a push to main
      # saves, so a branch never writes an entry that pushes one of
      # main's out of the repository's 10 GB.
      - uses: {% action "Swatinem/rust-cache" %}
        with:
          workspaces: {% .WorkDir %}
          key: {% .Component %}
          save-if: ${{ github.ref == 'refs/heads/main' }}
          cache-on-failure: true

      - uses: {% action "taiki-e/install-action" %}
        with:
          tool: cargo-llvm-cov{% end %}{% if eq .Toolchain "prek" %}

      # prek runs the hooks of this component only, with
      # --show-diff-on-failure, so a hook that changes a file fails
      # with the change it would make. sha256 is the digest
      # that prekSHA256 in ci/workflow.go pins, because the action checks
      # only the versions in its own table.{% if .Skip %} SKIP leaves out the hooks
      # that another job of this workflow runs.{% end %}
      - uses: {% action "j178/prek-action" %}{% if .Skip %}
        env:
          SKIP: {% join .Skip "," %}{% end %}
        with:
          prek-version: {% prekVersion %}
          sha256: {% prekSHA256 %}
          extra-args: --all-files {% .Dir %}/{% else %}{% if eq .Toolchain "codeql" %}{% template "codeql-init" . %}{% end %}{% if .Needs %}

      # Each shard's files are in a directory named for its artifact.
      - uses: {% action "actions/download-artifact" %}
        with:
          pattern: coverage-{% .Component %}-{% .Needs %}-*
          path: {% .Dir %}/coverage-shards{% end %}{% $lines := lines .Run %}{% if not .Run %}{% else if eq (len $lines) 1 %}

      - run: {% .Run %}{% else %}

      - run: |{% range $lines %}
          {% . %}{% end %}{% end %}{% if eq .Toolchain "codeql" %}{% template "codeql-analyze" . %}{% end %}{% end %}{% if eq .Toolchain "os" %}{% template "os-go-save" %}{% template "userland-ccache-save" %}{% end %}{% if .Go %}{% template "go-save" .Cache %}{% end %}{% if eq .Toolchain "hugo" %}

      - if: ${{ github.ref == 'refs/heads/main' && steps.hugo-cache.outputs.cache-hit != 'true' }}
        uses: {% action "actions/cache/save" %}
        with:
          path: ~/.cache/go-build
          key: ${{ steps.hugo-cache.outputs.cache-primary-key }}{% end %}{% if .Coverage %}

      # {% if .Matrix %}The job {% .Select %} merges these files from every shard.{% else %}The site renders the coverage report from these files.{% end %}
      - uses: {% action "actions/upload-artifact" %}
        with:
          name: coverage-{% .Component %}-{% .Name %}{% if .Matrix %}-${{ matrix.shard }}{% end %}
          path: |{% range .Coverage %}
            {% . %}{% end %}
          if-no-files-found: error
          retention-days: 7{% end %}{% if .Artifacts %}

      - uses: {% action "actions/upload-artifact" %}
        if: always()
        with:
          name: {% .Component %}-{% .Name %}-logs
          path: |{% range .Artifacts %}
            {% . %}{% end %}
          if-no-files-found: ignore{% end %}
{% end %}{% if .Images %}
  # Each image builds through docker-bake.hcl at the top of the
  # repository, as the target of the same name. A Dockerfile that
  # builds on a base of the repository, as in FROM mpv, gets that base
  # as a named context: the base's published image when the override
  # file names it, and otherwise the base's target, so the base builds
  # at this commit, from its layer cache when nothing in it changed.
  #
  # The layer cache is on ghcr, as a :buildcache tag beside each image.
  # Every build reads it. Every push to main and every run that
  # publishes also writes the cache of the image this job builds, and
  # never the cache of a base under it, so the next build finds each
  # layer that did not change, and the publish job's build of the same
  # image finds every layer there. A push to another branch only reads
  # it, so a topic branch cannot replace main's cache.
  #
  # Off main, a pinned base's job also writes its layers to ghcr, as a
  # :buildcache-<version>-<revision> tag beside the image, and every
  # build reads that tag too. A consumer's job runs after its bases'
  # jobs, so on a branch that raises a base's revision, the consumer
  # builds the base from the layers that the base's own job wrote a
  # moment before, instead of from snapshot.debian.org. The bake file
  # decides which target writes. Each write ignores an error: a cache
  # that cannot be written makes the next build slower, and it never
  # fails this one.
  #
  # The matrix comes from the plan: one entry for each image that runs,
  # with whether it is pinned, whether it loads, and its smoke check.
  images:
    name: ${{ matrix.image }}
    if: ${{ inputs.stage == 'check' && fromJSON(inputs.images)[0] != null }}
    runs-on: ubuntu-26.04
    timeout-minutes: {% .ImageTimeout %}
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(inputs.images) }}
    steps:
      - uses: {% action "actions/checkout" %}

{% template "bases" %}      - uses: {% action "docker/setup-buildx-action" %}

      # A pinned base writes its branch cache on every branch, so its job
      # logs in on every branch too.
      - if: ${{ inputs.publish != 'none' || (github.event_name == 'push' && github.ref == 'refs/heads/main') || matrix.pinned }}
        uses: {% action "docker/login-action" %}
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ github.token }}

      # An image whose package.toml sets cache-mount keeps a cache
      # mount, such as a compiler cache, that BuildKit never writes into
      # the registry's layer cache. So the job restores the files of an
      # earlier build into .image-cache/ and copies them into the mount
      # with the image's cache-seed target before the build. The build
      # reads the mount only when it misses the layer cache. The key
      # holds the run, so the restore takes the newest entry that main
      # saved.
      - id: image-cache
        if: ${{ matrix.cache }}
        uses: {% action "actions/cache/restore" %}
        with:
          path: .image-cache/${{ matrix.image }}
          key: image-cache-${{ matrix.image }}-${{ github.run_id }}
          restore-keys: image-cache-${{ matrix.image }}-

      - name: seed the cache mount
        if: ${{ matrix.cache }}
        run: |
          mkdir -p ".image-cache/${{ matrix.image }}"
          find ".image-cache/${{ matrix.image }}" -type f | sort > "$RUNNER_TEMP/image-cache-before"
          docker buildx bake -f docker-bake.hcl -f docker-bake.override.hcl "${{ matrix.image }}-cache-seed"

      # An image for more than one platform cannot load into the
      # runner's Docker daemon, so only a single-platform image loads,
      # and only a loaded image has a smoke check. The build reads the
      # bake file from the checkout, so a named context reaches the
      # directories of the repository.
      - if: ${{ !matrix.published }}
        uses: {% action "docker/bake-action" %}
        with:
          source: .
          files: |
            docker-bake.hcl
            docker-bake.override.hcl
          targets: ${{ matrix.image }}
          load: ${{ matrix.load }}
          push: false
          vars: |
            VERSION=${{ inputs.version || 'check' }}
            CACHE_WRITE=${{ (inputs.publish != 'none' || (github.event_name == 'push' && github.ref == 'refs/heads/main')) && matrix.image || '' }}
            BRANCH_CACHE=${{ matrix.image }}

      # A pinned image whose tag is published with the tree's recipe is
      # the build of this commit's recipe, so the job pulls it by its
      # tag and checks it, and builds nothing. ci/plan.go gives the
      # rule.
      - name: pull the published image
        if: ${{ matrix.published }}
        run: docker pull "ghcr.io/liken-sh/${{ matrix.image }}:${{ inputs.version }}"

      - name: smoke check
        if: ${{ matrix.smoke != '' && matrix.load }}
        run: bash "${{ matrix.smoke }}" "ghcr.io/liken-sh/${{ matrix.image }}:${{ inputs.version || 'check' }}"

      # Only main saves the cache, as with the Go caches, and only when
      # the build added files to the mount: a build that hit the layer
      # cache compiled nothing, and its entry would repeat the one it
      # restored.
      - id: image-cache-export
        name: copy the cache mount out
        if: ${{ matrix.cache && github.ref == 'refs/heads/main' }}
        run: |
          docker buildx bake -f docker-bake.hcl -f docker-bake.override.hcl "${{ matrix.image }}-cache-export"
          find ".image-cache/${{ matrix.image }}" -type f | sort > "$RUNNER_TEMP/image-cache-after"
          if cmp -s "$RUNNER_TEMP/image-cache-before" "$RUNNER_TEMP/image-cache-after"; then
            echo changed=false >> "$GITHUB_OUTPUT"
          else
            echo changed=true >> "$GITHUB_OUTPUT"
          fi

      - if: ${{ steps.image-cache-export.outputs.changed == 'true' }}
        uses: {% action "actions/cache/save" %}
        with:
          path: .image-cache/${{ matrix.image }}
          key: ${{ steps.image-cache.outputs.cache-primary-key }}
{% end %}{% if .Publishes %}
  publish:
    if: ${{ inputs.stage == 'publish' || inputs.dryrun }}
    runs-on: ubuntu-26.04
    timeout-minutes: {% .PublishTimeout %}{% if and .Images (not .Channel) %}
    # security-events: write uploads the Trivy scan of each image.
    # id-token: write lets cosign take the job's OIDC token and sign
    # each image keyless, with this workflow at its ref as the signer.
    # No other job of the workflow holds it.
    permissions:
      contents: read
      packages: write
      security-events: write
      id-token: write{% end %}{% if .Channel %}
    # id-token: write lets cosign take the job's OIDC token and sign
    # each file of the release keyless, with this workflow at its ref
    # as the signer. No other job of the workflow holds it.
    # packages: write lets the build push the userland that it compiles
    # on main to ghcr.io/liken-sh/userland, as the build job does.
    # liken/userland/artifact.sh gives the details.
    permissions:
      contents: read
      packages: write
      id-token: write
    # The channel's key comes from the repository secrets that
    # liken.sh/terraform.tf keeps delivered.
    env:
      RELEASES_ACCESS_KEY: ${{ secrets.RELEASES_ACCESS_KEY }}
      RELEASES_SECRET_KEY: ${{ secrets.RELEASES_SECRET_KEY }}{% end %}
    steps:
      - uses: {% action "actions/checkout" %}
        with:
          fetch-depth: 0{% if .Channel %}

      - id: build-setup
        uses: ./.github/actions/build-setup

      # The release build stamps the tag's version into every binary,
      # so it is a new build, and the smoke drill boots it before a byte
      # leaves the runner. Releases are immutable, so this is the last
      # point where a bundle that cannot boot is caught.
      #
      # A dry run builds under today's date and serial 000, the serial
      # of the lab's bundle, which no publish ever carries.
      - name: build and boot the release
        working-directory: {% .Dir %}
        run: |
          version="${{ inputs.version }}"
          if [ "${{ inputs.dryrun }}" = true ]; then version="$(date -u +%Y.%m.%d)-000"; fi
          make release VERSION="$version"
          make smoke-uefi

      # A dry run has no channel key, so it uploads nothing, and it
      # checks only that the script parses.
      - name: check the publish script
        if: ${{ inputs.dryrun }}
        working-directory: {% .Dir %}
        run: bash -n releases/publish.sh

      # cosign, from the image that toolchains/images.toml pins, signs
      # each file of the release keyless and writes the signature, the
      # certificate, and the Rekor entry into one bundle beside the
      # file, which the publish uploads with it. releases/sign.sh gives
      # the details. A dry run signs nothing.
      - name: sign the release's files
        if: ${{ !inputs.dryrun }}
        working-directory: {% .Dir %}
        run: releases/sign.sh "${{ inputs.version }}"

      - name: publish to the channel
        if: ${{ !inputs.dryrun }}
        working-directory: {% .Dir %}
        run: releases/publish.sh "${{ inputs.version }}"{% template "os-go-save" %}{% template "userland-ccache-save" %}{% else %}
{% template "go-restore" (goCache "ci/go.mod" "ci/go.sum" "ci" true) %}{% if .Images %}

      - uses: {% action "docker/setup-buildx-action" %}{% end %}

      # A dry run pushes nothing, so it needs no login.
      - if: ${{ !inputs.dryrun }}
        uses: {% action "docker/login-action" %}
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ github.token }}{% if .Deploy %}

      - uses: {% action "fluxcd/flux2/action" %}
        with:
          version: {% .Flux %}{% end %}{% if .Images %}

      # The publish scans each image that it pushes with Trivy, so an
      # image that this run publishes is scanned, and a pinned base is
      # scanned once for each tag. The root workflow's trivy job scans
      # every published image again when the Trivy configuration
      # changes. The scan reports and does not gate: an install that
      # fails here makes each scan fail, and the publish warns and pushes
      # the next image. Each scan reads Trivy's vulnerability database
      # that the root workflow's trivy-db job saved to the cache, and
      # Trivy downloads the database once, before the first scan, when
      # the restore finds none that is current.{% template "trivy-db-restore" "${{ !inputs.dryrun }}" %}
{% template "trivy-setup" "${{ !inputs.dryrun }}" %}{% end %}

{% if .Images %}{% template "bases" %}      # Each image builds again through docker-bake.hcl, and pushes. An
      # image that ran in the images job above builds from the layers that
      # the job wrote to the cache. An image that did not run reads
      # neither the version nor any file that changed, and it builds from
      # the layers that an earlier run on main wrote. Each push carries
      # buildx's SBOM and provenance attestations, and cosign, from the
      # image that toolchains/images.toml pins, signs the digest of each
      # image that the push wrote. ci/sign.go gives the details.{% if .Deploy %} The deploy artifact
      # goes last, because a cluster follows the deploy artifact, and it
      # must never name an image that is not pushed yet.{% end %}
{% else %}      # The component builds no image, so the deploy artifact pushes
      # alone.
{% end %}      - name: publish
        working-directory: ci
        run: go run . publish -root .. -component {% .Name %} -version "${{ inputs.version }}" -mode "${{ inputs.dryrun && 'dry' || inputs.publish }}"{% if .Images %} -sarif "${{ github.workspace }}/trivy"

      # The scan of each image goes under a category of its own,
      # trivy/<image>. Code scanning closes an alert only when a later
      # upload in the same category no longer reports it, so the upload
      # of one image never closes the alerts of another, and the next
      # scan of the same image replaces its results. Each step runs when
      # the publish wrote its image's scan, even when a later image
      # failed.{% range $i, $image := .Images %}{% if $i %}
{% end %}{% template "trivy-upload" (trivyUpload $image.Name (printf "trivy/%s.sarif" $image.Name) true) %}{% end %}{% end %}{% template "go-save" (goCache "ci/go.mod" "ci/go.sum" "ci" true) %}{% end %}
{% end %}
{% define "bases" %}      # The plan job checked the published image of each pinned base,
      # and this file points the build at each one that passed.
      - name: write the published bases
        env:
          BASES: ${{ inputs.bases }}
        run: printf '%s\n' "$BASES" > docker-bake.override.hcl

{% end %}
