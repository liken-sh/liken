# This file is generated from {% .Dir %}/package.toml. Do not edit it:
# edit that file or the templates in ci/templates/, then run
# `make workflows` at the top of the repository.
#
# ci.yaml calls this workflow when a change reaches {% .Name %}. Each
# check below is a job from package.toml, and it runs the same command
# that a workstation runs.{% if .Images %} The images job builds every image and runs
# its smoke check. The publish job pushes nothing until every other
# job in this workflow passes.{% end %}
name: {% .Name %}

on:
  workflow_call:
    inputs:
      # The version the outputs get: the release tag, a development
      # version, or empty when the run publishes nothing.
      version:
        type: string
        required: true
      # none, dev, or release.
      publish:
        type: string
        required: true

permissions:
  contents: read
  packages: write

jobs:{% range .Jobs %}
  {% .Name %}:
    runs-on: ubuntu-26.04
    timeout-minutes: {% .Timeout %}
    defaults:
      run:
        working-directory: {% .WorkDir %}{% if .Env %}
    env:{% range $key, $value := .Env %}
      {% $key %}: {% $value %}{% end %}{% end %}
    steps:{% if eq .Toolchain "os" %}
      # The build names itself with git describe, which needs the
      # history and the tags.
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      # The toolchain, KVM access, and the caches of the vendored
      # inputs.
      - uses: ./.github/actions/build-setup{% else %}
      - uses: actions/checkout@v7{% end %}{% if or (eq .Toolchain "go") (eq .Toolchain "hugo") (eq .Toolchain "prek") %}

      - uses: actions/setup-go@v6
        with:
          go-version-file: {% .ModuleDir %}/go.mod
          cache-dependency-path: {% .ModuleDir %}/go.sum{% end %}{% if eq .Toolchain "hugo" %}

      # setup-go saves its cache only when its key misses, and the key
      # follows go.sum, so between two changes to that file the build
      # cache inside it never refreshes, and Go trims the compiled
      # Hugo out of it. This entry saves on every run, under a key that
      # ends in the commit, and restores the newest one for the same
      # go.sum.
      - uses: actions/cache@v6
        with:
          path: ~/.cache/go-build
          key: {% .Component %}-{% .Name %}-build-${{ runner.os }}-${{ hashFiles('{% .ModuleDir %}/go.sum') }}-${{ github.sha }}
          restore-keys: {% .Component %}-{% .Name %}-build-${{ runner.os }}-${{ hashFiles('{% .ModuleDir %}/go.sum') }}-{% end %}{% if .Apt %}

      - name: install {% join .Apt ", " %}
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends {% join .Apt " " %}{% end %}{% if eq .Toolchain "rust" %}

      # rustup reads the toolchain pin from rust-toolchain.toml.
      - name: install the toolchain
        run: rustup show

      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: {% .WorkDir %}
          cache-on-failure: true

      - uses: taiki-e/install-action@v2.87.1
        with:
          tool: cargo-llvm-cov{% end %}{% if eq .Toolchain "prek" %}

      # prek runs the hooks of this component only, with
      # --show-diff-on-failure, so a hook that changes a file fails
      # with the change it would make.
      - uses: j178/prek-action@v2
        with:
          prek-version: 0.5.2
          extra-args: --all-files {% .Component %}/{% else %}{% $lines := lines .Run %}{% if eq (len $lines) 1 %}

      - run: {% .Run %}{% else %}

      - run: |{% range $lines %}
          {% . %}{% end %}{% end %}{% end %}{% if .Coverage %}

      # The site renders the coverage report from these files.
      - uses: actions/upload-artifact@v7
        with:
          name: coverage-{% .Component %}-{% .Name %}
          path: |{% range .Coverage %}
            {% . %}{% end %}
          if-no-files-found: error
          retention-days: 7{% end %}{% if .Artifacts %}

      - uses: actions/upload-artifact@v7
        if: always()
        with:
          name: {% .Component %}-{% .Name %}-logs
          path: |{% range .Artifacts %}
            {% . %}{% end %}
          if-no-files-found: ignore{% end %}
{% end %}{% if .Images %}
  # The layer cache is on ghcr, as a :buildcache tag beside each image.
  # Every build reads it. Every push to main and every run that
  # publishes also writes it, so the next build finds each layer that did
  # not change, and the publish job's build of the same image finds every
  # layer there. A push to another branch only reads it, so a topic
  # branch cannot replace main's cache. The write ignores an error: a
  # cache that cannot be written makes the next build slower, and it
  # never fails this one.
  images:
    name: ${{ matrix.image }}
    runs-on: ubuntu-26.04
    timeout-minutes: {% .ImageTimeout %}
    strategy:
      fail-fast: false
      matrix:
        include:{% range .Images %}
          - image: {% .Name %}
            context: {% .ContextPath %}
            file: {% .FilePath %}
            target: '{% .Target %}'
            platforms: {% .PlatformList %}
            load: {% .Load %}
            build-contexts: '{% .BuildContexts %}'
            smoke: '{% .Smoke %}'{% end %}
    steps:
      - uses: actions/checkout@v7

      - uses: docker/setup-buildx-action@v3

      - if: ${{ inputs.publish != 'none' || (github.event_name == 'push' && github.ref == 'refs/heads/main') }}
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ github.token }}

      # An image for more than one platform cannot load into the
      # runner's Docker daemon, so only a single-platform image loads,
      # and only a loaded image has a smoke check.
      - uses: docker/build-push-action@v6
        with:
          context: ${{ matrix.context }}
          file: ${{ matrix.file }}
          target: ${{ matrix.target }}
          platforms: ${{ matrix.platforms }}
          build-contexts: ${{ matrix.build-contexts }}
          build-args: |
            VERSION=${{ inputs.version || 'check' }}
          load: ${{ matrix.load }}
          push: false
          tags: ghcr.io/liken-sh/${{ matrix.image }}:${{ inputs.version || 'check' }}
          cache-from: type=registry,ref=ghcr.io/liken-sh/${{ matrix.image }}:buildcache
          cache-to: ${{ (inputs.publish != 'none' || (github.event_name == 'push' && github.ref == 'refs/heads/main')) && format('type=registry,ref=ghcr.io/liken-sh/{0}:buildcache,mode=max,ignore-error=true', matrix.image) || '' }}

      - name: smoke check
        if: ${{ matrix.smoke != '' && matrix.load }}
        run: bash "${{ matrix.smoke }}" "ghcr.io/liken-sh/${{ matrix.image }}:${{ inputs.version || 'check' }}"
{% end %}{% if .Publishes %}
  publish:
    needs: [{% .NeedsList %}]
    if: ${{ inputs.publish != 'none' }}
    runs-on: ubuntu-26.04
    timeout-minutes: {% .PublishTimeout %}{% if .Channel %}
    # The channel's key comes from the repository secrets that
    # liken.sh/terraform.tf keeps delivered.
    env:
      RELEASES_ACCESS_KEY: ${{ secrets.RELEASES_ACCESS_KEY }}
      RELEASES_SECRET_KEY: ${{ secrets.RELEASES_SECRET_KEY }}{% end %}
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0{% if .Channel %}

      - uses: ./.github/actions/build-setup

      # The release build stamps the tag's version into every binary,
      # so it is a new build, and the smoke drill boots it before a byte
      # leaves the runner. Releases are immutable, so this is the last
      # point where a bundle that cannot boot is caught.
      - name: build and boot the release
        working-directory: {% .Dir %}
        run: |
          make release VERSION="${{ inputs.version }}"
          make smoke-uefi

      - uses: actions/download-artifact@v8
        with:
          name: coverage-{% .Name %}-checks
          path: {% .Dir %}

      - name: publish to the channel
        working-directory: {% .Dir %}
        run: releases/publish.sh "${{ inputs.version }}"{% else %}

      - uses: actions/setup-go@v6
        with:
          go-version-file: ci/go.mod
          cache-dependency-path: ci/go.sum

      - uses: docker/setup-buildx-action@v3

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ github.token }}{% if .Deploy %}

      - uses: fluxcd/flux2/action@v2.9.5
        with:
          version: 2.9.5{% end %}

      # Each image builds again from the layer cache that the images
      # job wrote, and pushes. The deploy artifact goes last, because a
      # cluster follows the deploy artifact, and it must never name an
      # image that is not pushed yet.
      - name: publish
        working-directory: ci
        run: go run . publish -root .. -component {% .Name %} -version "${{ inputs.version }}" -mode "${{ inputs.publish }}"{% end %}
{% end %}
