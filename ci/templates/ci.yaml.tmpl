# This file is generated. Do not edit it: edit a component's
# package.toml or the templates in ci/templates/, then run
# `make workflows` at the top of the repository. The repository job
# below fails when this file differs from what the generator writes.
#
# This is the one workflow for every component in the repository. Each
# component is a directory with a package.toml, and each one has its
# own workflow, .github/workflows/component-<component>.yaml, which this file
# calls twice: once for its checks and once for its publish.
#
# A component's checks need only the pinned components it depends on:
# its images build on those bases, from the layers that the bases' own
# jobs write to the cache a moment before. It builds every other
# dependency from source at the same commit, so its checks start at
# once. Its publish needs its own checks and the checks of every
# component in its closure, so a component never publishes when a
# dependency failed.
#
# The plan job decides what the run does with each component. Its
# summary on the run page says, for each component, whether its jobs
# run and why, and what a release tag at this commit would publish.
#
#   A push to a branch, a pull request, or a dispatch runs the jobs of
#   each component whose files changed. It publishes nothing. A push
#   diffs with the commit before it and with its merge base with main,
#   and a pull request diffs with its merge base.
#
#   A push to main also diffs with the newest main run that passed, and
#   it runs every job when the plan cannot find that run. It publishes
#   a development build of each component whose outputs changed since
#   its newest published version, under a version such as
#   2026.10.02-001-dev-017-abcdef01.
#
#   A release tag, such as 2026.10.02-001, publishes each component
#   whose outputs changed since its own newest release, under the
#   tag's version. A component that did not change keeps its version.
#
#   A run that publishes runs the same jobs and images as a run that
#   does not: those that read the change since the newest main run
#   that passed. A job whose files did not change passed on the same
#   files in that run. It also runs each image that reads the VERSION
#   build argument, because the publish gives it a new version. The
#   publish builds every image of the component, from the layer cache.
#
# A pinned component, such as a base image, states its own version and
# revision, and it publishes under the tag <version>-<revision>, such
# as 20260928-1. Its jobs run, and a push to main or a release tag
# publishes it, when that tag is not published yet. The published
# image carries the hash of its recipe as a label, and the plan fails
# when the tree's recipe differs from the published one: the recipe
# changed, and the revision did not.
#
# A job that needs a skipped job is skipped too, unless its condition
# says otherwise. So each call's condition says: run when the plan
# says so, as long as nothing it needs failed.
#
# A real publish happens only when the repository variable PUBLISH is
# true. Without it, main and the tags run their checks and push
# nothing, and the plan job still proves that the workflow can push
# to every package.
name: ci

# A change to plans only starts no run. No job reads a plan, and plans
# often land in commits of their own. GitHub skips the workflow only
# when every changed file matches paths-ignore: the top-level plans/
# and each component's plans/, where a * does not match a /. A change
# with any other file runs as usual. GitHub does not evaluate path
# filters for a tag push, so a release tag always runs. A skipped push
# loses no check: it makes no run, so the next push to main still
# diffs with the newest main run that passed, and the next push to a
# branch still diffs with the branch's merge base with main. No
# ruleset requires these checks, so a skipped run blocks no merge.
on:
  push:
    branches: ['**']
    # A release tag is the bare version. A glob cannot state the whole
    # grammar, so the plan job checks the rest. The tags that the
    # components brought from their own repositories start with the
    # component's name, and they do not match.
    tags: ['2*']
    paths-ignore: ['plans/**', '*/plans/**']
  pull_request:
    branches: [main]
    paths-ignore: ['plans/**', '*/plans/**']
  workflow_dispatch:

# On a branch or a pull request, a new push cancels the run of the old
# one. Each commit on main and each tag gets its own group and its own
# verdict, and nothing cancels it.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref == 'refs/heads/main' && github.sha || github.ref }}
  cancel-in-progress: ${{ github.ref != 'refs/heads/main' && github.ref_type != 'tag' }}

permissions:
  contents: read

# proxy.golang.org sometimes drops a module download partway through
# the stream. With the default comma, `go` tries the origin only when
# the proxy answers 404 or 410, so a dropped stream fails the job.
# With a pipe, `go` fetches the module from its origin after any proxy
# error, with the runner's git. `GOSUMDB` keeps its default, so the
# checksum database still verifies a module that `go` fetched from its
# origin. A called workflow does not take this workflow's env, so each
# component's workflow sets the same value.
env:
  GOPROXY: https://proxy.golang.org|direct

jobs:
  plan:
    runs-on: ubuntu-26.04
    timeout-minutes: 10
    # packages: write lets the plan prove that this workflow can push
    # to each package. A pull request from a fork gets a read-only
    # token, and the plan skips the proof. actions: read lets a push to
    # main find the newest main run that passed: the plan diffs with it
    # too, so a change that a failed run did not verify runs again.
    permissions:
      contents: read
      packages: write
      actions: read
    outputs:
      components: ${{ steps.plan.outputs.components }}
      site: ${{ steps.plan.outputs.site }}
      actions: ${{ steps.plan.outputs.actions }}
      trivy: ${{ steps.plan.outputs.trivy }}
      trivy-db: ${{ steps.plan.outputs.trivy-db }}
      bases: ${{ steps.bases.outputs.bases }}
    steps:
      # The plan diffs against the commit before the push and against
      # each component's release tag, so it needs the history and the
      # tags.
      - uses: {% action "actions/checkout" %}
        with:
          fetch-depth: 0
{% template "go-restore" (goCache "ci/go.mod" "ci/go.sum" "ci" true) %}

      - id: plan
        working-directory: ci
        env:
          EVENT: ${{ github.event_name }}
          REF: ${{ github.ref }}
          BEFORE: ${{ github.event.before }}
          BASE: ${{ github.event.pull_request.base.sha }}
          PUBLISH: ${{ vars.PUBLISH }}
          PROBE: ${{ github.event_name == 'push' || github.event_name == 'workflow_dispatch' }}
          GITHUB_TOKEN: ${{ github.token }}
        run: go run . plan -root ..

      # Every build of the run pulls the published image of each pinned
      # base that passes its checks, and builds every other base from
      # the tree. The command is the one that `make bases` runs on a
      # workstation, and its output is the override file that each
      # build writes beside docker-bake.hcl. A check runs once here, so
      # every build of the run uses the same bases.
      - id: bases
        working-directory: ci
        run: go run . bases -root ..{% template "go-save" (goCache "ci/go.mod" "ci/go.sum" "ci" true) %}

  # The files at the top of the repository belong to no component: the
  # plans, the agent files, and the workflows. The root
  # .pre-commit-config.yaml checks them. Each component's own hooks run
  # in its prek job, and the generator refuses a component that has
  # hooks and no prek job.
  #
  # The job skips the `workflows` hook, because the graph job runs the
  # same `generate -check`, and the hook would compile ci a second
  # time. The hook stays in the root .pre-commit-config.yaml for a
  # workstation. The skip is a `--skip` argument and not the SKIP
  # variable, because prek ignores SKIP when the command line has a
  # `--skip`. sha256 is the digest that prekSHA256 in ci/workflow.go
  # pins, because prek-action checks only the versions in its own table.
  repository:
    runs-on: ubuntu-26.04
    timeout-minutes: 5
    steps:
      - uses: {% action "actions/checkout" %}
      - uses: {% action "j178/prek-action" %}
        with:
          prek-version: {% prekVersion %}
          sha256: {% prekSHA256 %}
          extra-args: >-
            --all-files
            --skip workflows{% range .Components %}
            --skip {% .Dir %}/{% end %}

  # The graph job proves that the generated workflows are current, that
  # each pin that several files share names one version, and that each
  # package.toml names every component its code uses. A dependency that
  # package.toml leaves out fails silently: the component would not
  # rebuild when the dependency changes.
  graph:
    runs-on: ubuntu-26.04
    timeout-minutes: 15
    steps:
      - uses: {% action "actions/checkout" %}
{% template "go-restore" (goCache "ci/go.mod" "**/go.sum" "every-module" false) %}

      - name: check the generated workflows
        working-directory: ci
        run: go run . generate -root .. -check

      - name: check the pins and the downloads against the rules in AGENTS.md
        working-directory: ci
        run: go run . pins -root ..

      - name: check that a namespace override moves no deploy object
        working-directory: ci
        run: go run . namespaces -root ..

      # A DeviceClass selector that reads an attribute that a device
      # lacks fails with a CEL error, and the scheduler then fails every
      # claim of the class on that node. ci/selectors.go gives the rule.
      - name: check that each DeviceClass guards the attributes it reads
        working-directory: ci
        run: go run . selectors -root ..

      - name: check each package.toml against the code
        working-directory: ci
        run: go run . deps -root ..{% template "go-save" (goCache "ci/go.mod" "**/go.sum" "every-module" false) %}

  # CodeQL analyzes the GitHub Actions code: the workflows and the local
  # actions under .github/. That code belongs to no component, so this
  # workflow runs the analysis, and the plan decides whether it runs:
  # when a file under .github/ changed, which includes each generated
  # workflow that a change to ci/ or a package.toml writes again, and
  # when every job runs. ci/codeql.go gives the rule. A pull request from
  # a fork gets a token that cannot write to code scanning, so the
  # analysis runs only for a branch of this repository.
  codeql-actions:
    needs: plan
    if: ${{ needs.plan.outputs.actions == 'true' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) }}
    runs-on: ubuntu-26.04
    timeout-minutes: 15
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: {% action "actions/checkout" %}

      - uses: {% action "github/codeql-action/init" %}
        with:
          languages: actions
          build-mode: none
          config: |
            paths:
              - .github

      - uses: {% action "github/codeql-action/analyze" %}
        with:
          category: codeql/actions
{% template "trivy-db" %}{% template "trivy-rescan" .TrivyCache %}{% range .Components %}
  {% .Name %}:
    needs: [plan{% range .Needs %}, {% . %}{% end %}]
    if: ${{ !failure() && !cancelled() && fromJSON(needs.plan.outputs.components)['{% .Name %}'].check }}
    uses: ./.github/workflows/component-{% .Name %}.yaml
    with:
      stage: check
      dryrun: ${{ fromJSON(needs.plan.outputs.components)['{% .Name %}'].dryrun }}
      version: ${{ fromJSON(needs.plan.outputs.components)['{% .Name %}'].version }}
      publish: ${{ fromJSON(needs.plan.outputs.components)['{% .Name %}'].publish }}
      jobs: ${{ toJSON(fromJSON(needs.plan.outputs.components)['{% .Name %}'].jobs) }}{% if .Images %}
      images: ${{ toJSON(fromJSON(needs.plan.outputs.components)['{% .Name %}'].images) }}
      bases: ${{ needs.plan.outputs.bases }}{% end %}
    permissions:
      contents: read
      packages: write{% if .SecurityEvents %}
      security-events: write{% end %}{%/* id-token: write lets the
      publish job of the component's workflow sign with cosign: each
      image, or each file of the OS release. GitHub checks every job of
      a called workflow against the call, including the publish job
      that the check call skips, so both calls grant it. */%}{% if or .Images .Channel %}
      id-token: write{% end %}
{% if .Publishes %}
  {% .Name %}-publish:
    needs: [plan, {% .Name %}{% range .PublishNeeds %}, {% . %}{% end %}{% if and .Images (not .Channel) %}, trivy-db{% end %}]
    if: ${{ !failure() && !cancelled() && fromJSON(needs.plan.outputs.components)['{% .Name %}'].publish != 'none' }}
    uses: ./.github/workflows/component-{% .Name %}.yaml
    with:
      stage: publish
      dryrun: false
      version: ${{ fromJSON(needs.plan.outputs.components)['{% .Name %}'].version }}
      publish: ${{ fromJSON(needs.plan.outputs.components)['{% .Name %}'].publish }}
      jobs: '[]'{% if .Images %}
      images: '[]'
      bases: ${{ needs.plan.outputs.bases }}{% end %}
    permissions:
      contents: read
      packages: write{% if .SecurityEvents %}
      security-events: write{% end %}{% if or .Images .Channel %}
      id-token: write{% end %}{% if .Channel %}
    # The OS publishes to the release channel with the channel's key.
    secrets: inherit{% end %}
{% end %}{% end %}
  # The site is every component's manual in one tree: liken's manual
  # at the root, and each other component's manual under its prefix,
  # such as liken.sh/display/. GitHub Pages serves it from this
  # repository at liken.sh, together with the coverage report of each
  # component. A push to main deploys it when the plan says the site
  # changed: a manual's job ran, a job that writes a coverage profile
  # ran, the site's build changed, or every job runs. A push of plans
  # only starts no run, and the site holds no plan.
  #
  # A job that did not run in this push wrote no coverage profile, and
  # it has no artifact to download. The site serves each profile beside
  # the reports, and `ci reports` takes that copy: the job's files did
  # not change since the run that wrote it, so it is the profile of this
  # commit. ci/coverage.go gives the whole argument.
  #
  # The site reads only the tree and the coverage artifacts of the
  # check jobs. So it waits for the plan and each component's checks,
  # and not for the publish jobs, and it deploys while they run.
  site:
    needs: [plan{% range .Components %}, {% .Name %}{% end %}]
    if: ${{ !failure() && !cancelled() && github.event_name == 'push' && github.ref == 'refs/heads/main' && vars.PUBLISH == 'true' && needs.plan.outputs.site == 'true' }}
    runs-on: ubuntu-26.04
    timeout-minutes: 20
    permissions:
      contents: read
      pages: write
      id-token: write
    # Two deploys in quick succession would race, and the check at the
    # end needs nothing else to change while it runs.
    concurrency:
      group: site
    steps:
      - uses: {% action "actions/checkout" %}
{% template "go-restore" (goCache "liken/docs/go.mod" "**/docs/go.sum" "manuals" false) %}

      # The site compiles Hugo and the brand's page generators in every
      # manual's module, as each manual's docs job does. So the site
      # keeps its build cache in the same family as the docs jobs. The
      # site restores the newest entry of any of them. A docs job with
      # no entry for its own go.sum restores the newest entry of the
      # family, and the site's entry holds every manual's build. The
      # hash covers every manual's go.sum, so the site's key never
      # equals the key that a docs job saves. The key holds no commit,
      # for the reason the docs jobs give, so the site saves an entry
      # only when a manual's go.sum changes.
      - id: hugo-cache
        uses: {% action "actions/cache/restore" %}
        with:
          path: ~/.cache/go-build
          key: hugo-build-${{ runner.os }}-${{ hashFiles('**/docs/go.sum') }}
          restore-keys: hugo-build-${{ runner.os }}-
{% range .Coverage %}
      - uses: {% action "actions/download-artifact" %}
        if: ${{ fromJSON(needs.plan.outputs.components)['{% .Component %}'].check && contains(fromJSON(needs.plan.outputs.components)['{% .Component %}'].jobs, '{% .Job %}') }}
        with:
          name: coverage-{% .Component %}-{% .Job %}
          path: {% .Dir %}
{% end %}
      # Each manual is a target of the root Makefile's site, so -j builds
      # the manuals together, one for each processor.
      - name: build the site
        run: make -j"$(nproc)" site SITE_URL=https://liken.sh{% template "go-save" (goCache "liken/docs/go.mod" "**/docs/go.sum" "manuals" false) %}

      - if: ${{ github.ref == 'refs/heads/main' && steps.hugo-cache.outputs.cache-hit != 'true' }}
        uses: {% action "actions/cache/save" %}
        with:
          path: ~/.cache/go-build
          key: ${{ steps.hugo-cache.outputs.cache-primary-key }}

      # A rerun of a job that the site needs runs this job again in the
      # same run, and deploy-pages refuses a run that holds two
      # artifacts of one name. So the artifact's name carries the
      # attempt.
      - uses: {% action "actions/upload-pages-artifact" %}
        with:
          path: dist/docs
          name: github-pages-${{ github.run_attempt }}

      - uses: {% action "actions/deploy-pages" %}
        with:
          artifact_name: github-pages-${{ github.run_attempt }}

      # The deploy finishing does not mean the public name serves the
      # new tree yet: Pages is behind a CDN that caches pages for up to
      # ten minutes. release.txt holds the commit, so the loop waits
      # until the public name serves this commit's tree.
      - name: check the served site
        run: |
          expected="${{ github.sha }}"
          for _ in $(seq 1 48); do
            served="$(curl --fail --silent https://liken.sh/release.txt || true)"
            if [ "$served" = "$expected" ]; then break; fi
            sleep 15
          done
          [ "$served" = "$expected" ] || {
            echo "the site still serves ${served:-nothing}, expected $expected"
            exit 1
          }
          fetch() {
            curl --fail --silent --retry 5 --retry-delay 3 --retry-all-errors "$@"
          }
          echo "checking the front page"
          fetch https://liken.sh/ | grep -q "boots a machine"
          echo "checking the markdown twin of a page"
          fetch --head https://liken.sh/docs/guides/install/index.md \
            | grep -qi "content-type: text/markdown"
          echo "checking llms.txt"
          fetch https://liken.sh/llms.txt | grep -q "^# liken"{% range .Sites %}
          echo "checking the {% .Component %} manual"
          fetch https://liken.sh/{% .Prefix %}/ > page.html
          grep -q "<title>" page.html{% end %}

  # The release record is the GitHub release for the tag: every
  # component and its version at this tag, whether this tag published
  # it or an earlier one did.
  record:
    needs: [plan{% range .Components %}, {% .Name %}{% if .Publishes %}, {% .Name %}-publish{% end %}{% end %}]
    if: ${{ !cancelled() && github.ref_type == 'tag' && vars.PUBLISH == 'true' }}
    runs-on: ubuntu-26.04
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - uses: {% action "actions/checkout" %}
        with:
          fetch-depth: 0
{% template "go-restore" (goCache "ci/go.mod" "ci/go.sum" "ci" true) %}

      - name: write the release record
        working-directory: ci
        env:
          GH_TOKEN: ${{ github.token }}
        run: go run . record -root .. -tag "${{ github.ref_name }}"{% template "go-save" (goCache "ci/go.mod" "ci/go.sum" "ci" true) %}
