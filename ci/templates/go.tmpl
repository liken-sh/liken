{% define "go-restore" %}
      - id: setup-go
        uses: actions/setup-go@v6
        with:
          go-version-file: {% .Mod %}
          cache: false
{% if .Build %}
      # Every run restores the Go cache, and only a push to main saves
      # it, so a branch never writes an entry that pushes one of main's
      # out of the repository's 10 GB. The cache holds the Go modules
      # and the build cache.
      #
      # The build cache holds Go's test results and the compiled
      # packages of the job's own module, and most commits change both.
      # So the key ends in the commit: each push to main saves a new
      # entry, and every run restores the newest one. A key without the
      # commit would save one entry when its files last changed. That
      # entry would keep the test results and packages of that commit,
      # and each run would compile the module's packages again and run
      # the tests of every package. The cost is one entry for each job
      # on each push to main, and GitHub evicts the oldest entries when
      # the repository's caches pass 10 GB.
      #
      # Before the commit, the key holds the hash of these files:
      #{% range .Keys %}
      #   {% . %}{% end %}
      #{% if gt (len .Keys) 1 %}
      # The files after go.sum choose what the job compiles and with
      # which flags.
      #{% end %}
      # A restore takes the newest entry with the same hash. When no
      # entry has that hash, as on a branch that changes one of the
      # files, the restore takes the newest entry of the same job. Each
      # job has entries of its own: a job that builds less would save
      # an entry without the packages that the other job compiles, and
      # the other job would restore it and compile them again.
      - id: go-cache
        uses: actions/cache/restore@v6
        with:
          path: |
            ~/go/pkg/mod
            ~/.cache/go-build
          key: go-build-${{ runner.os }}-${{ steps.setup-go.outputs.go-version }}-{% .Family %}-${{ github.job }}-${{ {% .HashFiles %} }}-${{ github.sha }}
          restore-keys: |
            go-build-${{ runner.os }}-${{ steps.setup-go.outputs.go-version }}-{% .Family %}-${{ github.job }}-${{ {% .HashFiles %} }}-
            go-build-${{ runner.os }}-${{ steps.setup-go.outputs.go-version }}-{% .Family %}-${{ github.job }}-{% else %}
      # Every run restores the Go modules, and only a push to main saves
      # them, when the key missed, so a branch never writes an entry
      # that pushes one of main's out of the repository's 10 GB. The key
      # follows the hash of {% range .Keys %}`{% . %}`{% end %}. When no entry has that
      # key, as on a branch that changes it, the restore takes the newest
      # entry of the same family, which holds most of the modules that
      # the job needs.
      - id: go-cache
        uses: actions/cache/restore@v6
        with:
          path: |
            ~/go/pkg/mod
          key: go-modules-${{ runner.os }}-${{ steps.setup-go.outputs.go-version }}-{% .Family %}-${{ {% .HashFiles %} }}
          restore-keys: go-modules-${{ runner.os }}-${{ steps.setup-go.outputs.go-version }}-{% .Family %}-{% end %}{% end %}
{% define "go-save" %}

      - if: ${{ github.ref == 'refs/heads/main' && steps.go-cache.outputs.cache-hit != 'true' }}
        uses: actions/cache/save@v6
        with:
          path: |
            ~/go/pkg/mod{% if .Build %}
            ~/.cache/go-build{% end %}
          key: ${{ steps.go-cache.outputs.cache-primary-key }}{% end %}
{% define "os-go-save" %}

      - if: ${{ github.ref == 'refs/heads/main' && steps.build-setup.outputs.go-cache-hit != 'true' }}
        uses: actions/cache/save@v6
        with:
          path: |
            ~/go/pkg/mod
            ~/.cache/go-build
          key: ${{ steps.build-setup.outputs.go-cache-key }}{% end %}
