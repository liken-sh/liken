# The buildroot options that every build of this tree shares.
# buildroot.sh writes this file and one fragment of programs, such as
# os.config or bluetoothd.config, into one defconfig, expands it with
# `make defconfig`, and buildroot fills every option that the two files
# leave out with its default.
#
# The target is a generic x86-64 machine. buildroot builds its own
# cross-compiler from source, with musl as the C library, and links
# every program static, because a liken machine and the bluetoothd
# image have no loader and no shared libraries. The compiler and the
# kernel headers take buildroot's defaults, so they move when the
# buildroot pin moves.
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_STATIC_LIBS=y

# No program here runs a shell, an init, or busybox, and each build
# takes single files out of buildroot's target tree, so buildroot
# writes no root filesystem image.
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set

# Every download must match a line of a .hash file, or the build
# stops. buildroot's own .hash files cover its recipes, the .hash file
# beside each recipe of this tree covers that recipe, and the patches/
# directory beside this file covers each version that versions.mk
# sets.
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_LIKEN_PATH)/patches"
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_LIKEN_PATH)/versions.mk"

# The compiler cache keeps a rebuild after a pin bump to minutes. The
# caller sets its directory in BR2_CCACHE_DIR and its size limit in
# CCACHE_MAXSIZE, and CI saves the directory between runners.
BR2_CCACHE=y
BR2_JLEVEL=8
