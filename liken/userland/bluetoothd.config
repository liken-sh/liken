# The static daemons and tools of the bluetoothd image of
# bluetooth-operator. bluetooth-operator/bluetoothd/Dockerfile builds
# this fragment with common.config.

# BlueZ, from the recipe in bluetooth/bluez-static, and dbus, from
# buildroot's recipe. dbus-daemon is the bus that bluetoothd serves
# org.bluez on, and dbus-send is how a person calls a method on it.
BR2_PACKAGE_BLUEZ_STATIC=y
BR2_PACKAGE_DBUS=y
