# The buildroot configuration of the static programs. build.sh expands
# it with `make defconfig`, and buildroot fills every option that this
# file leaves out with its default.
#
# The target is a generic x86-64 machine. buildroot builds its own
# cross-compiler from source, with musl as the C library, and links
# every program static, because a liken machine has no loader and no
# shared libraries. The compiler and the kernel headers take
# buildroot's defaults, so they move when the buildroot pin moves.
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_STATIC_LIBS=y

# No program here runs a shell, an init, or busybox, and the OS image
# takes single files out of the build, so buildroot writes no root
# filesystem image.
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set

# Every download must match a line of a .hash file, or the build
# stops. buildroot's own .hash files cover its recipes, and the
# patches/ directory beside this file covers each version that
# versions.mk sets.
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_LIKEN_PATH)/patches"
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_LIKEN_PATH)/versions.mk"

# The compiler cache keeps a rebuild after a pin bump to minutes.
# build.sh sets its directory to cache/ccache beside the downloads.
BR2_CCACHE=y
BR2_JLEVEL=8

# mke2fs creates the ext4 filesystems on the disks that init claims.
# The image takes mke2fs alone, so the fsck programs stay out.
BR2_PACKAGE_E2FSPROGS=y
# BR2_PACKAGE_E2FSPROGS_FSCK is not set

# mount.nfs is the NFS client, the host half of the nfs feature.
# rpc.nfsd and its rpcbind serve exports, and a liken machine mounts
# exports and never serves them.
BR2_PACKAGE_NFS_UTILS=y
# BR2_PACKAGE_NFS_UTILS_RPC_NFSD is not set

# wpa_supplicant runs the WPA handshake for a wireless spec.network
# entry. OpenSSL supplies the elliptic-curve math of SAE, which is
# WPA3 personal. external.mk replaces the recipe's feature list with
# wpa_supplicant.config.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y

# The time zone database, compiled with zic. build.sh copies the
# POSIX tree out of the build.
BR2_TARGET_TZ_INFO=y
