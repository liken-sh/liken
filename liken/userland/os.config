# The static programs that every liken image carries. build.sh builds
# this fragment with common.config.

# mke2fs creates the ext4 filesystems on the disks that init claims.
# The image takes mke2fs alone, so the fsck programs stay out.
BR2_PACKAGE_E2FSPROGS=y
# BR2_PACKAGE_E2FSPROGS_FSCK is not set

# mount.nfs is the NFS client, the host half of the nfs feature.
# rpc.nfsd and its rpcbind serve exports, and a liken machine mounts
# exports and never serves them.
BR2_PACKAGE_NFS_UTILS=y
# BR2_PACKAGE_NFS_UTILS_RPC_NFSD is not set

# iscsid and iscsiadm are the iSCSI initiator, the host half of the
# iscsi feature. buildroot's open-iscsi and kmod recipes build shared
# libraries only, so the recipes in iscsi/ build them static.
BR2_PACKAGE_OPEN_ISCSI_STATIC=y

# wpa_supplicant runs the WPA handshake for a wireless spec.network
# entry. OpenSSL supplies the elliptic-curve math of SAE, which is
# WPA3 personal. external.mk replaces the recipe's feature list with
# wpa_supplicant.config.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y

# The time zone database, compiled with zic. build.sh copies the
# POSIX tree out of the build.
BR2_TARGET_TZ_INFO=y
