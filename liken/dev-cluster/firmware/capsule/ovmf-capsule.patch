+++ b/OvmfPkg/Library/LabFmpDeviceLib/LabFmpDeviceLib.inf
@@ -0,0 +1,30 @@
+## @file
+#  A test firmware device for FmpDxe. The device has no hardware: its
+#  firmware version is one non-volatile UEFI variable, and a successful
+#  SetImage() stores the version that the capsule's FMP payload header
+#  carries. It lets a QEMU guest take a signed FMP capsule end to end,
+#  through the ESRT, fwupd, and UpdateCapsule(), without a real flash
+#  part to write.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+##
+
+[Defines]
+  INF_VERSION     = 0x00010005
+  BASE_NAME       = LabFmpDeviceLib
+  FILE_GUID       = 33ee3f86-b429-4520-a8cd-7d79ce79e1af
+  MODULE_TYPE     = DXE_DRIVER
+  VERSION_STRING  = 1.0
+  LIBRARY_CLASS   = FmpDeviceLib|DXE_DRIVER UEFI_DRIVER
+
+[Sources]
+  LabFmpDeviceLib.c
+
+[Packages]
+  MdePkg/MdePkg.dec
+  FmpDevicePkg/FmpDevicePkg.dec
+
+[LibraryClasses]
+  BaseLib
+  DebugLib
+  UefiRuntimeServicesTableLib
