diff --git a/OvmfPkg/Library/LabFmpDeviceLib/LabFmpDeviceLib.c b/OvmfPkg/Library/LabFmpDeviceLib/LabFmpDeviceLib.c
new file mode 100644
index 0000000..3dddad5
--- /dev/null
+++ b/OvmfPkg/Library/LabFmpDeviceLib/LabFmpDeviceLib.c
@@ -0,0 +1,326 @@
+/** @file
+  A test firmware device for FmpDxe.
+
+  The device has no hardware. Its firmware version is the UINT32 in the
+  non-volatile variable LabFmpVersion. The variable's GUID is
+  gEfiCallerIdGuid, the FILE_GUID of the FmpDxe that links this library,
+  which the platform DSC sets to the device's image type ID.
+  When the variable does not exist, the device reports version 1, so a
+  fresh variable store starts every guest at version 1.
+
+  A successful SetImage() writes the version that the FMP payload header of
+  the capsule carries. FmpDxe has already checked the capsule's PKCS7
+  signature and its lowest supported version before it calls this library,
+  so the library checks only that a payload is present.
+
+  The variable has runtime access so that a person can read the stored
+  version from the OS through efivarfs. That also lets the OS write it,
+  which is acceptable for a test device and is not acceptable for real
+  firmware.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <PiDxe.h>
+#include <Guid/SystemResourceTable.h>
+#include <Protocol/FirmwareManagement.h>
+#include <Library/BaseLib.h>
+#include <Library/DebugLib.h>
+#include <Library/FmpDeviceLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+
+#define LAB_FMP_VERSION_VARIABLE  L"LabFmpVersion"
+#define LAB_FMP_INITIAL_VERSION   1
+
+//
+// FmpDxe refuses a capsule whose version is lower than this. Version 1 is
+// the version a fresh device reports, so any capsule from 1 up applies.
+//
+#define LAB_FMP_LOWEST_SUPPORTED_VERSION  1
+
+#define LAB_FMP_ATTRIBUTES  (IMAGE_ATTRIBUTE_IMAGE_UPDATABLE | \
+                             IMAGE_ATTRIBUTE_RESET_REQUIRED |  \
+                             IMAGE_ATTRIBUTE_AUTHENTICATION_REQUIRED | \
+                             IMAGE_ATTRIBUTE_IN_USE)
+
+EFI_STATUS
+EFIAPI
+RegisterFmpInstaller (
+  IN FMP_DEVICE_LIB_REGISTER_FMP_INSTALLER  Function
+  )
+{
+  //
+  // EFI_UNSUPPORTED makes FmpDxe install its one FMP instance on its own
+  // image handle, which is all a single test device needs.
+  //
+  return EFI_UNSUPPORTED;
+}
+
+EFI_STATUS
+EFIAPI
+RegisterFmpUninstaller (
+  IN FMP_DEVICE_LIB_REGISTER_FMP_UNINSTALLER  Function
+  )
+{
+  return EFI_UNSUPPORTED;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceSetContext (
+  IN EFI_HANDLE  Handle,
+  IN OUT VOID    **Context
+  )
+{
+  return EFI_UNSUPPORTED;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceGetSize (
+  OUT UINTN  *Size
+  )
+{
+  if (Size == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *Size = sizeof (UINT32);
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceGetImageTypeIdGuidPtr (
+  OUT EFI_GUID  **Guid
+  )
+{
+  //
+  // FmpDxe then reads PcdFmpDeviceImageTypeIdGuid, which the platform DSC
+  // sets to LAB_FMP_GUID, the same GUID as FmpDxe's FILE_GUID.
+  //
+  return EFI_UNSUPPORTED;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceGetAttributes (
+  OUT UINT64  *Supported,
+  OUT UINT64  *Setting
+  )
+{
+  if ((Supported == NULL) || (Setting == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *Supported = LAB_FMP_ATTRIBUTES;
+  *Setting   = LAB_FMP_ATTRIBUTES;
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceGetLowestSupportedVersion (
+  OUT UINT32  *LowestSupportedVersion
+  )
+{
+  if (LowestSupportedVersion == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *LowestSupportedVersion = LAB_FMP_LOWEST_SUPPORTED_VERSION;
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceGetVersionString (
+  OUT CHAR16  **VersionString
+  )
+{
+  if (VersionString == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  //
+  // FmpDxe builds the version string from the version number when the
+  // device does not give one.
+  //
+  *VersionString = NULL;
+  return EFI_UNSUPPORTED;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceGetVersion (
+  OUT UINT32  *Version
+  )
+{
+  EFI_STATUS  Status;
+  UINT32      Stored;
+  UINTN       Size;
+
+  if (Version == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  Size   = sizeof (Stored);
+  Status = gRT->GetVariable (
+                  LAB_FMP_VERSION_VARIABLE,
+                  &gEfiCallerIdGuid,
+                  NULL,
+                  &Size,
+                  &Stored
+                  );
+  if (EFI_ERROR (Status) || (Size != sizeof (Stored))) {
+    *Version = LAB_FMP_INITIAL_VERSION;
+  } else {
+    *Version = Stored;
+  }
+
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceGetHardwareInstance (
+  OUT UINT64  *HardwareInstance
+  )
+{
+  return EFI_UNSUPPORTED;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceGetImage (
+  OUT    VOID   *Image,
+  IN OUT UINTN  *ImageSize
+  )
+{
+  return EFI_UNSUPPORTED;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceCheckImage (
+  IN  CONST VOID  *Image,
+  IN  UINTN       ImageSize,
+  OUT UINT32      *ImageUpdatable
+  )
+{
+  UINT32  LastAttemptStatus;
+
+  return FmpDeviceCheckImageWithStatus (Image, ImageSize, ImageUpdatable, &LastAttemptStatus);
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceCheckImageWithStatus (
+  IN  CONST VOID  *Image,
+  IN  UINTN       ImageSize,
+  OUT UINT32      *ImageUpdatable,
+  OUT UINT32      *LastAttemptStatus
+  )
+{
+  if ((ImageUpdatable == NULL) || (LastAttemptStatus == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if ((Image == NULL) || (ImageSize == 0)) {
+    *ImageUpdatable    = IMAGE_UPDATABLE_INVALID;
+    *LastAttemptStatus = LAST_ATTEMPT_STATUS_ERROR_INVALID_FORMAT;
+    return EFI_SUCCESS;
+  }
+
+  *ImageUpdatable    = IMAGE_UPDATABLE_VALID;
+  *LastAttemptStatus = LAST_ATTEMPT_STATUS_SUCCESS;
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceSetImage (
+  IN  CONST VOID                                     *Image,
+  IN  UINTN                                          ImageSize,
+  IN  CONST VOID                                     *VendorCode        OPTIONAL,
+  IN  EFI_FIRMWARE_MANAGEMENT_UPDATE_IMAGE_PROGRESS  Progress           OPTIONAL,
+  IN  UINT32                                         CapsuleFwVersion,
+  OUT CHAR16                                         **AbortReason
+  )
+{
+  UINT32  LastAttemptStatus;
+
+  return FmpDeviceSetImageWithStatus (
+           Image,
+           ImageSize,
+           VendorCode,
+           Progress,
+           CapsuleFwVersion,
+           AbortReason,
+           &LastAttemptStatus
+           );
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceSetImageWithStatus (
+  IN  CONST VOID                                     *Image,
+  IN  UINTN                                          ImageSize,
+  IN  CONST VOID                                     *VendorCode        OPTIONAL,
+  IN  EFI_FIRMWARE_MANAGEMENT_UPDATE_IMAGE_PROGRESS  Progress           OPTIONAL,
+  IN  UINT32                                         CapsuleFwVersion,
+  OUT CHAR16                                         **AbortReason,
+  OUT UINT32                                         *LastAttemptStatus
+  )
+{
+  EFI_STATUS  Status;
+
+  if (LastAttemptStatus == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if ((Image == NULL) || (ImageSize == 0)) {
+    *LastAttemptStatus = LAST_ATTEMPT_STATUS_ERROR_INVALID_FORMAT;
+    return EFI_ABORTED;
+  }
+
+  if (Progress != NULL) {
+    Progress (50);
+  }
+
+  Status = gRT->SetVariable (
+                  LAB_FMP_VERSION_VARIABLE,
+                  &gEfiCallerIdGuid,
+                  EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS,
+                  sizeof (CapsuleFwVersion),
+                  &CapsuleFwVersion
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LabFmpDeviceLib: storing version %u failed: %r\n", CapsuleFwVersion, Status));
+    *LastAttemptStatus = LAST_ATTEMPT_STATUS_ERROR_UNSUCCESSFUL;
+    return Status;
+  }
+
+  DEBUG ((DEBUG_INFO, "LabFmpDeviceLib: stored version %u from a %Lu byte payload\n", CapsuleFwVersion, (UINT64)ImageSize));
+
+  if (Progress != NULL) {
+    Progress (100);
+  }
+
+  *LastAttemptStatus = LAST_ATTEMPT_STATUS_SUCCESS;
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+EFIAPI
+FmpDeviceLock (
+  VOID
+  )
+{
+  //
+  // The platform's CapsuleUpdatePolicyLib never asks for the lock, because
+  // fwupd's EFI updater calls UpdateCapsule() after the end of DXE, and a
+  // locked device would refuse that update.
+  //
+  return EFI_UNSUPPORTED;
+}
diff --git a/OvmfPkg/Library/LabFmpDeviceLib/LabFmpDeviceLib.inf b/OvmfPkg/Library/LabFmpDeviceLib/LabFmpDeviceLib.inf
