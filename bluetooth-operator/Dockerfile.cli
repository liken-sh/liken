# The CLI image: the static binary kubectl-liken-bluetooth on a
# distroless base, built for linux/amd64 only.

# The build stage runs on the build machine's architecture and
# cross-compiles, so the build needs no emulation.
FROM --platform=$BUILDPLATFORM golang AS build
# proxy.golang.org sometimes drops a module download partway through.
# With the default comma separator, `go` falls back to the module's
# origin only when the proxy answers 404 or 410, so a dropped download
# fails the build. With a pipe, `go` falls back after any proxy error,
# using the git in the `golang` image. `GOSUMDB` keeps its default, so
# the checksum database still verifies modules fetched from the origin.
ENV GOPROXY="https://proxy.golang.org|direct"
WORKDIR /src
COPY go.mod go.sum ./
# go.mod replaces the shared kubernetes module with ../kubernetes, so
# `go mod download` needs that module's go.mod, which comes from the
# build context named kubernetes. The CLI imports no package from it,
# so go.mod alone is enough.
COPY --from=kubernetes go.mod /kubernetes/
RUN go mod download
# The CLI imports no package of the operator, so only cli/ is copied.
COPY cli/ ./cli/
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
    -o /kubectl-liken-bluetooth ./cli
# Collects the license files of the Go standard library and of each
# linked module. notices/go.sh explains why the image needs them.
COPY --from=notices go.sh /
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} sh /go.sh /notices ./cli

# The distroless static image has a nonroot user and a CA bundle, and
# a static Go binary that calls the Kubernetes API needs nothing else.
FROM distroless
# Replaces distroless's Debian CA bundle with the one that the trust
# component pins for every liken image, and adds its notice.
COPY --from=trust / /
COPY --from=build /kubectl-liken-bluetooth /kubectl-liken-bluetooth
COPY --from=build /notices /
ENTRYPOINT ["/kubectl-liken-bluetooth"]
