# The -cli image: the static kubectl-liken-audio binary on a distroless
# base, built for linux/amd64 only.

# The build stage runs on the builder's own architecture and
# cross-compiles, so the build needs no emulation.
FROM --platform=$BUILDPLATFORM golang AS build
# proxy.golang.org sometimes drops a module download partway through.
# With the default comma separator, go falls back to the origin only
# when the proxy returns 404 or 410, so a dropped download fails the
# build. With a pipe, go falls back to the origin after any proxy
# error, using the git in this image. GOSUMDB keeps its default, so
# the checksum database still verifies modules fetched from the origin.
ENV GOPROXY="https://proxy.golang.org|direct"
WORKDIR /src
COPY go.mod go.sum ./
# go.mod replaces the kubernetes module with ../kubernetes, so go
# needs that module's go.mod from the build context named kubernetes.
# The CLI imports none of its packages, so go.mod is all it copies.
COPY --from=kubernetes go.mod /kubernetes/
RUN go mod download
# The CLI shares no code with the operator package.
COPY cli/ ./cli/
# -ldflags sets main.version, as in the operator image.
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
    -o /kubectl-liken-audio ./cli
# The license files of the Go standard library and of each module the
# binary links. See notices/go.sh.
COPY --from=notices go.sh /
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} sh /go.sh /notices ./cli

# distroless has a nonroot user and no shell, which is all that a
# static Go binary calling an HTTPS API needs.
FROM distroless
# Replaces distroless's own Debian CA bundle with the bundle, and its
# notice, that the trust component pins for every liken image.
COPY --from=trust / /
COPY --from=build /kubectl-liken-audio /kubectl-liken-audio
COPY --from=build /notices /
# The binary is the entrypoint, so docker run and a Job in the cluster
# pass their arguments straight to it.
ENTRYPOINT ["/kubectl-liken-audio"]
