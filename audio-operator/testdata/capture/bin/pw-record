#!/bin/sh
# Stands in for pw-record in the tap's tests. It records its own
# argument list, so a test asserts the command line the container
# built and the fake pw-dump beside it reads the name the container
# gave this stream out of the same file.
#
# It never ends. A real tap is an endless stream, and the container
# discards from it on a clock while the link is confirmed, so a
# stand-in that ran out would answer an empty body rather than the
# span that was asked for.
#
# CAPTURE_FAKE_ONCE is how a test asks for the other case: the samples
# run out and this process ends, which is what a pw-record that died
# under a tap looks like to the container.
#
# The loop keeps a child's death from ending this process. When the
# container closes the pipe it reads, cat dies of SIGPIPE, and set -e
# would then end this shell with a status of its own. A real recorder
# dies of the signal instead, which the container reads as a process it
# stopped and not one that failed.
set -eu
printf '%s\n' "$@" > "$CAPTURE_FAKE_ARGS"
if [ "${CAPTURE_FAKE_ONCE:-no}" = yes ]; then
	exec cat "$CAPTURE_FAKE_SAMPLES"
fi
while :; do
	cat "$CAPTURE_FAKE_SAMPLES" || true
done
